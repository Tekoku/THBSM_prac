//　ﾀｲﾄﾙ表示
task StageTitleDisplay( pos, long, path, rgb ){
	let sef		= [
		ObjPrim_Create(OBJ_SPRITE_2D),
		ObjPrim_Create(OBJ_SPRITE_2D),
		ObjPrim_Create(OBJ_SPRITE_2D),
	];
	
	// ポエム表示
	StageTitleDisplay02( pos, long, path, rgb );
	
	let i		= 0;
	let sca		= 0.8;
	let move1	= 0;
	let moveA	= 0;
	let move2	= 0;
	let moveB	= 0;
	
	ascent( i in 0..length(sef) ){
		ObjPrim_SetTexture(sef[i], path );
		Obj_SetRenderPriorityI(sef[i], 72 );
		ObjRender_SetBlendType(sef[i], BLEND_ALPHA );
		ObjRender_SetAngleXYZ(sef[i], 0, 0, 0 );
		ObjRender_SetScaleXYZ(sef[i], sca, sca, 0 );
		ObjRender_SetAlpha(sef[i], 0 );
	}
	
	ObjSprite2D_SetSourceRect(sef[0], 0, 0, 512, 128 );
	ObjSprite2D_SetDestCenter(sef[0]);
	
	ObjRender_SetScaleXYZ(sef[1], sca - 0.3, sca - 0.3, 0 );
	ObjSprite2D_SetSourceRect(sef[1], 0, 128, 256, 128+64 );
	ObjSprite2D_SetDestCenter(sef[1]);
	
	ObjRender_SetScaleXYZ(sef[2], sca - 0.2, sca - 0.2, 0 );
	ObjSprite2D_SetSourceRect(sef[2], 256, 128, 512, 128+64 );
	ObjSprite2D_SetDestCenter(sef[2]);
	
	while( move1 < 1 || move2 < 1 ){
		if( move1 < 1 ){ move1 = 1 * sin( moveA ); }
		if( move2 < 1 ){ move2 = 1 * sin( moveB ); }
		
		ascent( i in 0..length(sef) ){
			ObjRender_SetAlpha(sef[i], move1*255 );
		}
		
		ObjRender_SetScaleXYZ(sef[0], sca*2 - move2*sca, move2*sca, 0 );
		ObjRender_SetPosition(sef[0], pos[0], pos[1], 0 );
		ObjRender_SetPosition(sef[1], pos[0] + 64-move2*64, pos[1]-32, 0 );
		ObjRender_SetPosition(sef[2], pos[0] - 64+move2*64, pos[1]+32, 0 );
		
		moveA += 2;
		moveB += 1;
		
		yield;
	}
	move1 = 0;
	moveA = 0;
	move2 = 0;
	moveB = 0;
	
	loop( long ){
		ObjRender_SetPosition(sef[1], pos[0] - move2, pos[1]-32, 0 );
		ObjRender_SetPosition(sef[2], pos[0] + move2, pos[1]+32, 0 );
		
		move2 += 0.1;
		
		yield;
	}
	while( move1 < 1 || move2 < 1 ){
		if( move1 < 1 ){ move1 = 1 * sin( moveA ); }
		
		ascent( i in 0..length(sef) ){
			ObjRender_SetAlpha(sef[i], 255 - move1*255 );
		}
		
		ObjRender_SetPosition(sef[1], pos[0] - move2, pos[1]-32, 0 );
		ObjRender_SetPosition(sef[2], pos[0] + move2, pos[1]+32, 0 );
		
		moveA += 2;
		move2 += 0.1 + moveB;
		moveB += 0.02;
		
		yield;
	}
	ascent( i in 0..length(sef) ){
		Obj_Delete(sef[i]);
	}
}

// ポエム部分
task StageTitleDisplay02( pos, long, path, rgb )
{
	let sef		= [
		ObjPrim_Create(OBJ_SPRITE_2D),
		ObjPrim_Create(OBJ_SPRITE_2D),
		ObjPrim_Create(OBJ_SPRITE_2D),
	];
	let i		= 0;
	let sca		= 0.7;
	let move1	= 0;
	let moveA	= 0;
	let move2	= 0;
	let moveB	= 0;
	let offset_x	= 0;
	let offset_y	= 64;
	let moveX	= [-48, 48, -24];
	let moveY	= [0, 0, 0];
	
	ascent( i in 0..length(sef) ){
		ObjPrim_SetTexture(sef[i], path );
		Obj_SetRenderPriorityI(sef[i], 72 );
		ObjRender_SetBlendType(sef[i], BLEND_ALPHA );
		ObjRender_SetAngleXYZ(sef[i], 0, 0, 0 );
		ObjRender_SetScaleXYZ(sef[i], sca, sca, 0 );
		ObjRender_SetAlpha(sef[i], 0 );
		ObjSprite2D_SetSourceRect(sef[i], 0, 256+i*32, 512, 256+(i+1)*32 );
		ObjSprite2D_SetDestCenter(sef[i]);
		ObjRender_SetScaleXYZ(sef[i], sca, sca, 0 );
	}
	
	while( move1 < 1 || move2 < 1 ){
		if( move1 < 1 ){ move1 = 1 * sin( moveA ); }
		if( move2 < 1 ){ move2 = 1 * sin( moveB ); }
		
		let muki = 1;
		ascent( i in 0..length(sef) ){
			ObjRender_SetAlpha(sef[i], move1*255 );
			ObjRender_SetPosition(sef[i], pos[0] + offset_x+(1-move2)*moveX[i], pos[1]+offset_y+i*18*sca+(1-move2)*moveY[i], 0 );
			muki = -muki;
		}
		
		moveA += 2;
		moveB += 1;
		
		yield;
	}
	move1 = 0;
	moveA = 0;
	move2 = 0;
	moveB = 0;
	
	loop( long ){
		let muki = 1;
		ascent( i in 0..length(sef) ){
			ObjRender_SetPosition(sef[i], pos[0] + offset_x, pos[1]+offset_y+i*18*sca, 0 );
			muki = -muki;
		}
		
		yield;
	}
	while( move1 < 1 || move2 < 1 ){
		if( move1 < 1 ){ move1 = 1 * sin( moveA ); }
		
		let muki = 1;
		ascent( i in 0..length(sef) ){
			ObjRender_SetAlpha(sef[i], (1-move1)*255 );
			ObjRender_SetPosition(sef[i], pos[0] + offset_x+move2*moveX[i], pos[1]+offset_y+i*18*sca+move2*moveY[i], 0 );
			muki = -muki;
		}
		
		moveA += 2;
		move2 += moveB;
		moveB += 0.001;
		
		yield;
	}
	ascent( i in 0..length(sef) ){
		Obj_Delete(sef[i]);
	}
}

//　星座表示 星部分
function Constellation( dpos, dist, ang, layer, long ){
	let obj		= ObjPrim_Create(OBJ_SPRITE_2D);
	Constellation_Update( obj, dpos, dist, ang, layer, long );
	return obj;
}

task Constellation_Update( obj, dpos, dist, ang, layer, long ){
	let pos		= [ 0, 0 ];
	let move1	= 0;
	let moveA	= 0;
	let sca		= 0.4;
	let alpha	= [ 255, 192 ];
	let count	= 0;
	let flash	= 32;
	let moveA_add	= 0;
	
	//　座標
	let _rect	= [ 3, 0 ];
	
	//　回転加算
	ang += 360;
	
	ObjPrim_SetTexture( obj, path_stgttl01 );
	Obj_SetRenderPriorityI( obj, layer+1 );
	ObjRender_SetBlendType( obj, BLEND_ADD_ARGB );
	ObjSprite2D_SetSourceRect( obj, 0 + 64*_rect[0], 0 + 64*_rect[1], 64 + 64*_rect[0], 64 + 64*_rect[1] );
	ObjSprite2D_SetDestCenter( obj );
	
	ObjRender_SetColor( obj, constellationRGB[0], constellationRGB[1], constellationRGB[2] );
	
	while( move1 < 1 ){
		move1 = 1 * sin( moveA );
		pos = [
			dpos[0] + move1*dist * cos( move1*ang ),
			dpos[1] + move1*dist * sin( move1*ang ) + (1-move1)*dist * cos( move1*ang ),
		];
		let scale = move1*sca + move1*0.04*sin(count*flash);
		ObjRender_SetPosition( obj, pos[0], pos[1], 0 );
		ObjRender_SetScaleXYZ( obj, scale, scale, 0 );
		ObjRender_SetAlpha( obj, move1*alpha[count%2] );
		moveA += 1;
		count++;
		yield;
	}
	loop( long ){
		move1 = 1 * sin( moveA );
		pos = [
			dpos[0] + move1*dist * cos( move1*ang ),
			dpos[1] + move1*dist * sin( move1*ang ),
		];
		let scale = move1*sca + move1*0.04*sin(count*flash);
		ObjRender_SetPosition( obj, pos[0], pos[1], 0 );
		ObjRender_SetScaleXYZ( obj, scale, scale, 0 );
		ObjRender_SetAlpha( obj, alpha[count%2] );
		moveA += moveA_add;
		moveA_add = min(0.05, moveA_add+0.001);
		count++;
		yield;
	}
	while( moveA < 180 ){
		move1 = 1 * sin( moveA );
		pos = [
			dpos[0] + move1*dist * cos( move1*ang ),
			dpos[1] + move1*dist * sin( move1*ang ),
		];
		let scale = move1*sca + move1*0.04*sin(count*flash);
		ObjRender_SetPosition( obj, pos[0], pos[1], 0 );
		ObjRender_SetScaleXYZ( obj, scale, scale, 0 );
		ObjRender_SetAlpha( obj, move1*alpha[count%2] );
		moveA += moveA_add;
		moveA_add = min(5, moveA_add+0.1);
		count++;
		yield;
	}
	Obj_Delete( obj );
}

//　星座表示 ﾗｲﾝ部分
task ConstellationLine( obj1, obj2, layer, long ){
	let obj		= ObjPrim_Create(OBJ_SPRITE_2D);
	let pos		= [ 0, 0 ];
	let move1	= 0;
	let moveA	= 0;
	let sca		= 0.1;
	let alpha	= [ 255, 128 ];
	let count	= 0;
	let flash	= 16;
	
	//　受け取ったｵﾌﾞｼﾞｪｸﾄの座標
	let pos1	= [ ObjRender_GetX(obj1), ObjRender_GetY(obj1) ];
	let pos2	= [ ObjRender_GetX(obj2), ObjRender_GetY(obj2) ];
	
	//　2点間の距離
	let _length	= 0;
	
	ObjPrim_SetTexture( obj, path_stgttl02 );
	Obj_SetRenderPriorityI( obj, layer );
	ObjRender_SetBlendType( obj, BLEND_ADD_ARGB );
	ObjPrim_SetPrimitiveType( obj, PRIMITIVE_TRIANGLESTRIP );
	ObjPrim_SetVertexCount( obj, 4 );
	
	ObjRender_SetColor( obj, constellationRGB[0], constellationRGB[1], constellationRGB[2] );
	
	while( move1 < 1 ){
		move1 = 1 * sin( moveA );
		pos1 = [ ObjRender_GetX(obj1), ObjRender_GetY(obj1) ];
		pos2 = [ ObjRender_GetX(obj2), ObjRender_GetY(obj2) ];
		_length	= GetDistance( pos1, pos2 );
		
		let scale = move1*sca + move1*0.02*sin(count*flash);
		ObjRender_SetPosition( obj, pos1[0], pos1[1], 0 );
		ObjRender_SetScaleXYZ( obj, scale, 1, 0 );
		ObjRender_SetAngleZ( obj, GetGapAngle( pos1, pos2 )-90 );
		ObjRender_SetAlpha( obj, alpha[count%2] );
		
		ObjPrim_SetVertexPosition( obj, 0, -16, 0, 0 );
		ObjPrim_SetVertexPosition( obj, 1, -16, move1*_length, 0 );
		ObjPrim_SetVertexPosition( obj, 2, 16, 0, 0 );
		ObjPrim_SetVertexPosition( obj, 3, 16, move1*_length, 0 );
		ObjPrim_SetVertexUVT( obj, 0, 0, 0 );
		ObjPrim_SetVertexUVT( obj, 1, 0, move1*_length );
		ObjPrim_SetVertexUVT( obj, 2, 32, 0 );
		ObjPrim_SetVertexUVT( obj, 3, 32, move1*_length );
		
		moveA += 1;
		count++;
		yield;
	}
	loop( long ){
		pos1 = [ ObjRender_GetX(obj1), ObjRender_GetY(obj1) ];
		pos2 = [ ObjRender_GetX(obj2), ObjRender_GetY(obj2) ];
		_length	= GetDistance( pos1, pos2 );
		
		let scale = move1*sca + move1*0.02*sin(count*flash);
		ObjRender_SetPosition( obj, pos1[0], pos1[1], 0 );
		ObjRender_SetScaleXYZ( obj, scale, 1, 0 );
		ObjRender_SetAngleZ( obj, GetGapAngle( pos1, pos2 )-90 );
		ObjRender_SetAlpha( obj, alpha[count%2] );
		
		ObjPrim_SetVertexPosition( obj, 0, -16, 0, 0 );
		ObjPrim_SetVertexPosition( obj, 1, -16, move1*_length, 0 );
		ObjPrim_SetVertexPosition( obj, 2, 16, 0, 0 );
		ObjPrim_SetVertexPosition( obj, 3, 16, move1*_length, 0 );
		ObjPrim_SetVertexUVT( obj, 0, 0, 0 );
		ObjPrim_SetVertexUVT( obj, 1, 0, move1*_length );
		ObjPrim_SetVertexUVT( obj, 2, 32, 0 );
		ObjPrim_SetVertexUVT( obj, 3, 32, move1*_length );
		
		count++;
		yield;
	}
	while( move1 > 0 ){
		move1 = 1 * sin( moveA );
		pos1 = [ ObjRender_GetX(obj1), ObjRender_GetY(obj1) ];
		pos2 = [ ObjRender_GetX(obj2), ObjRender_GetY(obj2) ];
		_length	= GetDistance( pos1, pos2 );
		
		let scale = move1*sca + move1*0.02*sin(count*flash);
		ObjRender_SetScaleXYZ( obj, move1*scale, 1, 0 );
		ObjRender_SetAlpha( obj, alpha[count%2] );
		
		moveA += 5;
		count++;
		yield;
	}
	Obj_Delete( obj );
}
