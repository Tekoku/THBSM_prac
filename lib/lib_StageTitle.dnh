let path_stgttl01	= imgEffectStageParticle;
let path_stgttl02	= imgEffectStageLine;
//let path_stgttl03	= GetCurrentScriptDirectory() ~ "./../img/world/stg1img/stage-temp.png";

let constellationRGB = [ 255, 64, 255 ];

// ステージ1
task DisplayStage01( wait, wait2 )
{
	loop( wait ){ yield; }
	let pos		= [ 384/2, 448/2 - 96 ];
	let layer	= 71;
	let long	= 300;
	let obj		= [
		Constellation( pos, 96, 230, layer, long ),
		Constellation( pos, 96, 180, layer, long ),
		Constellation( pos, 64, 260, layer, long ),
		Constellation( pos, 64, 120, layer, long ),
		Constellation( pos, 96, 280, layer, long ),
		Constellation( pos, 96, 110, layer, long ),
		Constellation( pos, 64, 0, layer, long ),
		Constellation( pos, 64, 80, layer, long ),
		Constellation( pos, 96, 10, layer, long ),
		Constellation( pos, 96, 60, layer, long ),
		Constellation( pos, 128, 0, layer, long ),
		Constellation( pos, 128, 70, layer, long ),
	];
	// LoadingImageFile_StgTitle(stage_id)[0] … タイトル画像のパス
	StageTitleDisplay( pos, long, LoadingImageFile_StgTitle(1)[0], [255,255,255] );
	loop( wait2 ){ yield; }
	ConstellationLine( obj[0], obj[1], layer, long - wait2 );
	ConstellationLine( obj[0], obj[2], layer, long - wait2 );
	ConstellationLine( obj[1], obj[3], layer, long - wait2 );
	ConstellationLine( obj[2], obj[4], layer, long - wait2 );
	ConstellationLine( obj[3], obj[5], layer, long - wait2 );
	ConstellationLine( obj[2], obj[6], layer, long - wait2 );
	ConstellationLine( obj[3], obj[7], layer, long - wait2 );
	ConstellationLine( obj[6], obj[8], layer, long - wait2 );
	ConstellationLine( obj[7], obj[9], layer, long - wait2 );
	ConstellationLine( obj[8], obj[10], layer, long - wait2 );
	ConstellationLine( obj[9], obj[11], layer, long - wait2 );
}

