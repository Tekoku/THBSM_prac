		Obj_SetValue(obj, ACT_MOVE, _ACT_MOVE);		//移動（自動判別）
		Obj_SetValue(obj, ACT_SHOT1, _ACT_SHOT1_4A);	//攻撃その１
		Obj_SetValue(obj, ACT_SHOT2, _ACT_SHUTTER);	//トビコサン特殊動作
	}
	case(BOSS_ID_TOBIKO_H)
