// ---------------------- ボスのアニメーション動作ライブラリ

//関数の引数に使う方
let ACT_STAND	= "ACT_STAND";
let ACT_MOVE_L	= "ACT_MOVE_L";
let ACT_MOVE_R	= "ACT_MOVE_R";
let ACT_MOVE	= "ACT_MOVE";
let ACT_SHOT1	= "ACT_SHOT1";
let ACT_SHOT2	= "ACT_SHOT2";
let ACT_SHOT3	= "ACT_SHOT3";

//内部的な判別用
let _ACT_NONE	= 0;	//静止画
let _ACT_STAND1_5	= 1;	//立ち状態 5コマ
let _ACT_STAND1_4	= 2;	//立ち状態 4コマ
let _ACT_STAND1_3	= 3;	//立ち状態 3コマ
let _ACT_STAND1_TOBIKO	= 11;	//立ち状態 トビコサン
let _ACT_STAND1_ICHIYOU	= 12;	//立ち状態 一曜サン
let _ACT_MOVE	= 100;	//移動（自動判別）
let _ACT_MOVE_L_4	= 101;	//左移動 4コマ
let _ACT_MOVE_R_4	= 102;	//右移動 4コマ
let _ACT_MOVE_L_3	= 103;	//左移動 3コマ
let _ACT_MOVE_R_3	= 104;	//右移動 3コマ
let _ACT_MOVE_L_4L	= 111;	//左移動 4コマ 3-4コマループ
let _ACT_MOVE_R_4L	= 112;	//右移動 4コマ 3-4コマループ
let _ACT_SHOT1_3A	= 201;	//ショット 3コマ
let _ACT_SHOT1_3B	= 202;	//ショット 3コマ
let _ACT_SHOT1_3C	= 203;	//ショット 3コマ
let _ACT_SHOT1_4A	= 211;	//ショット 4コマ
let _ACT_SHOT1_4B	= 212;	//ショット 4コマ
let _ACT_SHUTTER	= 401;	//トビコサン特殊動作（カメラ）
let _ACT_ICHIYOU1	= 402;	//一曜特殊動作1
let _ACT_ICHIYOU2	= 403;	//一曜特殊動作2（土遁）

//------------------------------------------------------------------------------
// ボスのアニメ設定
//------------------------------------------------------------------------------
function BossAnime_InitAnimation(obj)
{
	alternative(GetBossID(obj))
	case(BOSS_ID_FABRITIS)
	{
		//画像設定
		Obj_SetValue(obj, "ANIME_SC", 1);		//拡大率
		Obj_SetValue(obj, "ANIME_W", 64);		//１コマの幅
		Obj_SetValue(obj, "ANIME_H", 96);		//１コマの高さ
		Obj_SetValue(obj, "ANIME_FL", true);		//立ち絵をふわふわさせる？
		//アニメ設定
		Obj_SetValue(obj, ACT_STAND, _ACT_STAND1_5);	//立ち
		Obj_SetValue(obj, ACT_MOVE_L, _ACT_MOVE_L_4L);	//左移動
		Obj_SetValue(obj, ACT_MOVE_R, _ACT_MOVE_R_4L);	//右移動
		Obj_SetValue(obj, ACT_MOVE, _ACT_MOVE);		//移動（自動判別）
		Obj_SetValue(obj, ACT_SHOT1, _ACT_SHOT1_3C);	//攻撃その１
		Obj_SetValue(obj, ACT_SHOT2, _ACT_NONE);
	}
	case(BOSS_ID_IPHONEA)
	{
		//画像設定
		Obj_SetValue(obj, "ANIME_SC", 1);		//拡大率
