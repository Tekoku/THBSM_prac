// î’e
function CreateShotWay(x, y, speed, angle, graphic, delay, way, way_angle, r)
{
	let w_cen = 0;
	if (way > 1) { w_cen = (way-1)/2; }
	ascent(i in 0 .. way)
	{
		let sa = angle + (i-w_cen)*way_angle;
		let sx = x + cos(sa)*r;
		let sy = y + sin(sa)*r;
		CreateShotA1(sx, sy, speed, sa, graphic, delay);
	}
}
function CreateShotWayA2(x, y, speed, angle, add_speed, max_speed, graphic, delay, way, way_angle, r)
{
	let w_cen = 0;
	if (way > 1) { w_cen = (way-1)/2; }
	ascent(i in 0 .. way)
	{
		let sa = angle + (i-w_cen)*way_angle;
		let sx = x + cos(sa)*r;
		let sy = y + sin(sa)*r;
		CreateShotA2(sx, sy, speed, sa, add_speed, max_speed, graphic, delay);
	}
}
function CreateShotWayEx(x, y, speed, angle, graphic, delay, way, way_angle, r)
{
	let w_cen = 0;
	if (way > 1) { w_cen = (way-1)/2; }
	ascent(i in 0 .. way)
	{
		let sa = angle + (i-w_cen)*way_angle;
		let sx = x + cos(sa)*r;
		let sy = y + sin(sa)*r;
		let obj = CreateShotA1(sx, sy, speed, sa, graphic, 0);
		My_RaiseShotEffectA(obj, delay);
	}
}
function CreateShotWayA2Ex(x, y, speed, angle, add_speed, max_speed, graphic, delay, way, way_angle, r)
{
	let w_cen = 0;
	if (way > 1) { w_cen = (way-1)/2; }
	ascent(i in 0 .. way)
	{
		let sa = angle + (i-w_cen)*way_angle;
		let sx = x + cos(sa)*r;
		let sy = y + sin(sa)*r;
		let obj = CreateShotA2(sx, sy, speed, sa, add_speed, max_speed, graphic, 0);
		My_RaiseShotEffectA(obj, delay);
	}
}

// ‘S•ûˆÊ’e
function CreateShotCircle(x, y, speed, angle, graphic, delay, way, r)
{
	ascent(i in 0 .. way)
	{
		let sa = angle + i*360/way;
		let sx = x + cos(sa)*r;
		let sy = y + sin(sa)*r;
		CreateShotA1(sx, sy, speed, sa, graphic, delay);
	}
}
function CreateShotCircleA2(x, y, speed, angle, add_speed, max_speed, graphic, delay, way, r)
{
	ascent(i in 0 .. way)
	{
		let sa = angle + i*360/way;
		let sx = x + cos(sa)*r;
		let sy = y + sin(sa)*r;
		CreateShotA2(sx, sy, speed, sa, add_speed, max_speed, graphic, delay);
	}
}
