// キャラクター立ち絵のロード
task LoadCharacterAllTexture(bossID)
{
	let tmpPath = _CharacterAllTexture(bossID);
	ascent(i in 0 .. length(tmpPath))
	{
		LoadTextureInLoadThread(tmpPath[i]);
		yield;
	}
}
// アンロード
// カットイン用もアンロードされるけどキニシナイ！
task UnloadCharacterAllTexture(bossID)
{
	let tmpPath = _CharacterAllTexture(bossID);
	ascent(i in 0 .. length(tmpPath))
	{
		RemoveTexture(tmpPath[i]);
		yield;
	}
}
function _CharacterAllTexture(bossID)
{
	let tmpPath;
	alternative(bossID)
	/*
	case (BOSS_ID_REIMU)	{ tmpPath = imgCharaReimu; }
	case (BOSS_ID_MARISA)	{ tmpPath = imgCharaMarisa; }
	case (BOSS_ID_SANAE)	{ tmpPath = imgCharaSanae; }
	case (BOSS_ID_TOKUBI)	{ tmpPath = imgCharaTokubi; }
	case (BOSS_ID_MINAYU)	{ tmpPath = imgCharaMinayu; }
	case (BOSS_ID_SETUJO)	{ tmpPath = imgCharaSetujo; }
	case (BOSS_ID_KOUKAI)	{ tmpPath = imgCharaKoukai; }
	case (BOSS_ID_ANZA)	{ tmpPath = imgCharaAnza; }
	case (BOSS_ID_SASHA)	{ tmpPath = imgCharaSasha; }
	case (BOSS_ID_UKA)	{ tmpPath = imgCharaUka; }
	case (BOSS_ID_RAKU)	{ tmpPath = imgCharaRaku; }
	case (BOSS_ID_VINKA)	{ tmpPath = imgCharaVinka; }
	case (BOSS_ID_AZUMA)	{ tmpPath = imgCharaAzuma; }
	case (BOSS_ID_KAYANO)	{ tmpPath = imgCharaKayano; }
	case (BOSS_ID_TENYU)	{ tmpPath = imgCharaTenyu; }
	*/
	others { tmpPath = []; }
	return(tmpPath);
}


