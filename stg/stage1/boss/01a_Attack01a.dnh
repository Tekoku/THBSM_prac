#東方弾幕風[Single]
#ScriptVersion[3]
#Title["ファブリーズ通常1（道中）"]
#Text["ファブリーズ通常1（道中）"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(2000);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(20);		}
	BossEvent();
}

@Initialize {
	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_FABRITIS);	//ボスセット

	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	SetEnemyVisible(objEnemy, true);
	if (GetPlayMode() == GAME_SPELL || GetPlayMode() == GAME_NONE)
	{
		// スペプラ用
		ObjMove_SetPosition(objEnemy, CenX+64, 140);
	}
	wait(60);
	
	let muki = 1;
	while(eAlive)
	{
		Febreze(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), muki);
	//	Febreze(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), -muki);
		SetAction(objEnemy, ACT_SHOT1, 120);
		wait(120);
		if (!eAlive) { return; }
		EnemyRandomMove(objEnemy, 120, 64);
		wait(180);
		muki = -muki;
	}
}

task Febreze(x, y, muki)
{
	let speed = [1, 1.25, 1.75, 2.25][Difficult];
	let graphic = BGW_BALL_SS_WHITE;
	let timer = 90;
	let count = [1, 2, 4, 4][Difficult];
	ascent(i in 0 .. timer)
	{
		if (!eAlive) { return; }
		let tmp = (i+0.5)/timer;
		let ba = 90 + muki*(150-tmp^0.5*210);
		let br = min(1, tmp*3) * 240;
		let bx = x + cos(ba)*br;
		let by = y + sin(ba)*br/3 - tmp*80;
		
		let offset_r = sin(tmp*180)*64 + 16;
		let offset_a = rand(0, 360);
		let sa = 90 + muki*(150-tmp^0.5*210)*2;
		loop(count)
		{
			let or = rand(0, offset_r^2)^0.5;
			let sx = bx + cos(offset_a)*or;
			let sy = by + sin(offset_a)*or;
			let ss = rand(0.5, 1)*speed;
			MistShot(sx, sy, ss, sa, graphic, 15);
		}
		if (Difficult >= D_LUNA)
		{
			let ss = speed * (1 - tmp*0.5) * (1 - (i%2)/10);
			My_CreateShotA2(bx, by, speed+5, sa, -5/5, ss/2, BGW_CROSS_WHITE, 15);
		}
		CallSound(sndShot2);
		yield;
	}
}

task MistShot(x, y, speed, angle, graphic, delay)
{
	let objShot = CreateShotA2(x, y, speed+5, angle, -5/5, speed, graphic, delay);
	Obj_SetRenderPriorityI(objShot, GetShotRenderPriorityI()+1);
	
	let objEffect = CreateParticleEffect([x, y], 2, 0);
	Obj_SetRenderPriorityI(objEffect, GetShotRenderPriorityI()+2);
	let ea = rand(0, 360);
	let add_a = rand(-6, 6);
	ascent(i in 0 .. 30)
	{
		let tmp = (i+1)/30;
		let tmp_s = 1-tmp;
		let tmp_a = (0.25-(tmp-0.5)^2)*255;
		ObjRender_SetScaleXYZ(objEffect, tmp_s, tmp_s, tmp_a);
		ObjRender_SetAlpha(objEffect, tmp_a);
		ObjRender_SetAngleZ(objEffect, ea);
		ea += add_a;
		yield;
	}
	Obj_Delete(objEffect);
}
