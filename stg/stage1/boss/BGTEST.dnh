#東方弾幕風[Single]
#ScriptVersion[3]
#Title["背景テスト"]
#Text["背景テスト"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(600);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(-1);		}
	BossEvent();
}

@Initialize {
	dIni_Shot = 20;		//ダメージ透過率

	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_FABRITIS);	//ボスセット

ObjRender_SetAlpha(GetBossImageID(objEnemy),0);
ObjMove_SetPosition(objEnemy, -512,-512);
Task_Main;
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	wait(60);
//	let sbg = GetCurrentScriptDirectory()~"../../stage6/BackgroundWorld06.dnh";
	let sbg = GetCurrentScriptDirectory()~"../../stage6/boss/06c_Background.dnh";
		//背景スクリプト読み込み
		if (sbg != "")
		{
			let idBG = LoadScript(sbg);
		//	SetScriptArgument(idBG, 0, sbg_opt);
			StartScript(idBG);
			SetAreaCommonData(CAREA_STAGE, "SPELL_BACKGROUND", idBG);
		}

wait(120);

	// 背景イベント
	NotifyEventAll(ev_NextStageScene, 0);
wait(120);

	// 背景イベント
	NotifyEventAll(ev_NextStageScene, 0);
}
