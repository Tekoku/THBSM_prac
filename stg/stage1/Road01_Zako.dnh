// -------------- 敵単体の処理 -------------- //

// 最初の妖精
task SetEnemyF01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_RED;
	let emnImage = imgZakoFairyRed;
	let item_count = 3;
	let item_star = 1;
	
	let objEnemy = MakeEnemy(iniX, iniY, 40, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_SMALL);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TShot();
		TMove();
	}
	
	// 移動
	task TMove()
	{
		let add_angle = [1.25, -1.25][iniX < CenX];
		if (sin(iniAngle) < 0) { add_angle = -add_angle; }
		ObjMove_SetSpeed(objEnemy, iniSpeed);
		ObjMove_SetAngle(objEnemy, iniAngle);
		
		wait(60);
		if (!CanShotBullet(objEnemy)) { return; }
		ZakoMove_CurveTimer02(objEnemy, 300, add_angle);
	}
	
	// ショット
	task TShot()
	{
		let wt = [240, 240, 75, 20][Difficult];
		let shot_delay = [180, 120, 60, 30][Difficult];
		let timer = 240 + shot_delay;
		shot_delay += trunc(randStage(0,6,iniValue))/6*wt;
		
		let speed = [1.5, 1.5, 2.75, 3.75][Difficult];
		let way = 1;
		let way_angle = 45;
		let graphic = BGW_BALL_S_BLUE;
		
		let t = shot_delay;
		wait(shot_delay);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let sa = GetAngleToPlayer(objEnemy);
			CreateShotWay(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
				speed, sa, graphic, 15, way, way_angle, 0);
			CallSound(sndShot2);
			wait(wt);
			t += wt;
		}
	}
}

// 上から来て帰っていく妖精
task SetEnemyF02(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 3;
	let item_star = 1;
	
	let objEnemy = MakeEnemy(iniX, iniY, 40, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_SMALL);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TShot();
		TMove();
	}
	
	// 移動
	task TMove()
	{
		ObjMove_AddPatternA1(objEnemy, 0, iniSpeed, iniAngle);
		ObjMove_AddPatternA2(objEnemy, 60, NO_CHANGE, NO_CHANGE, -iniSpeed/45, 0, iniSpeed/8);
		ObjMove_AddPatternA2(objEnemy, 205, NO_CHANGE, NO_CHANGE, -iniSpeed/45, rand_dir()*3, iniSpeed/8);
		ObjMove_AddPatternA2(objEnemy, 255, NO_CHANGE, NO_CHANGE, iniSpeed/120, 0, iniSpeed/2);
	}
	
	// ショット
	task TShot()
	{
		let wt = 210;
		let shot_delay = 120;
		let timer = wt*0.5 + shot_delay;
		shot_delay += trunc(randStage(0,4,iniValue))/6*wt;
		
		let speed = 1.25;
		let way = 1;
		let way_angle = 45;
		let graphic = BGW_BALL_S_BLUE;
		
		let t = shot_delay;
		wait(shot_delay);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let sa = GetAngleToPlayer(objEnemy);
			CreateShotWay(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
				speed, sa, graphic, 15, way, way_angle, 0);
			CallSound(sndShot2);
			wait(wt);
			t += wt;
		}
	}
}

// でか妖精、花飾り
task SetEnemyL01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_L;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 20;
	let item_star = 5;
	
	let objEnemy = MakeEnemy(iniX, iniY, 550, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_LARGE);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TShot();
		TShot02();
		TMove();
	}
	
	// 移動
	task TMove()
	{
		ObjMove_AddPatternA1(objEnemy, 0, iniSpeed, iniAngle);
		ObjMove_AddPatternA2(objEnemy, 420, NO_CHANGE, NO_CHANGE, iniSpeed/30, 0, iniSpeed*4);
	}
	
	// ショット
	task TShot()
	{
		let wt = 10;
		let shot_delay = 90;
		let timer = 540;
		
		let speed = 1.5;
		let graphic = BGW_ICE_YELLOW;
		let muki = [1, -1][iniX < CenX];
		let count = 10;
		
		let t = shot_delay;
		wait(shot_delay);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let ba = iniAngle - 105*muki + rand(-15,15);
			let sx = ObjMove_GetX(objEnemy)+rand(-8,8);
			let sy = ObjMove_GetY(objEnemy)+rand(-8,8) + 8;
			ascent(i in 0 .. count)
			{
				let ss = speed * (1+i/3);
				let sa = ba-i/count*muki*15;
				CreateShotA1(sx, sy, ss, sa, graphic, 10);
			}
			//CallSound(sndShot2);
			wait(wt);
			t += wt;
		}
	}
	
	task TShot02()
	{
		let wt = [120, 120, 120, 60][Difficult];
		let shot_delay = 180;
		let timer = 540;
		
		let speed = 4;
		let graphic = BGW_BALL_BS_PURPLE;
		let way = [0, 0, 8, 12][Difficult];
		
		if (way < 0) { return; }
		
		let t = shot_delay;
		wait(shot_delay);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let ba = GetAngleToPlayer(objEnemy);
			ascent(i in 0 .. 3)
			{
				let ss = speed * (1 - absolute(i-1)*0.05);
				let sa = ba + (i-1)*2;
				CreateShotCircleL01(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
					ss/8, sa, ss/120, ss, graphic, 15, way, 16);
			}
			CallSound(sndShot2);
			wait(wt);
			t += wt;
		}
	}

	function CreateShotCircleL01(x, y, speed, angle, add_speed, max_speed, graphic, delay, way, r)
	{
		ascent(i in 0 .. way)
		{
			let sa = angle + i*360/way;
			let sx = x + cos(sa)*r;
			let sy = y + sin(sa)*r;
			let obj = CreateShotA1(sx, sy, speed, sa, graphic, delay);
			ObjMove_AddPatternA2(obj, 30, NO_CHANGE, NO_CHANGE, add_speed, 0, max_speed);
		}
	}
}

// 横から来て帰っていく妖精
task SetEnemyF03(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 3;
	let item_star = 1;
	
	let objEnemy = MakeEnemy(iniX, iniY, 40, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_SMALL);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TShot();
		TMove();
	}
	
	// 移動
	task TMove()
	{
		let muki = [1, -1][iniX < CenX];
		ObjMove_AddPatternA1(objEnemy, 0, iniSpeed, iniAngle);
		ObjMove_AddPatternA2(objEnemy, 60, NO_CHANGE, NO_CHANGE, -iniSpeed/45, 0, iniSpeed/8);
		ObjMove_AddPatternA2(objEnemy, 205, NO_CHANGE, NO_CHANGE, iniSpeed/360, muki*2, iniSpeed/2);
		ObjMove_AddPatternA2(objEnemy, 255, NO_CHANGE, NO_CHANGE, iniSpeed/120, 0, 3);
	}
	
	// ショット
	task TShot()
	{
		let wt = 45;
		let shot_delay = 60;
		let timer = 180;
		shot_delay += trunc(randStage(0,4,iniValue))/6*wt;
		
		let speed = 1.5;
	//	let graphic = BGW_SCALE_BLUE;
		let count = 8;
		let muki = [1, -1][iniX < CenX];
		
		let t = shot_delay;
		wait(shot_delay);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let ba = 90 + rand(120,165)*muki;
			let sx = ObjMove_GetX(objEnemy);
			let sy = ObjMove_GetY(objEnemy);
			let graphic = [BGW_ICE_BLUE, BGW_ICE_GREEN, BGW_ICE_YELLOW, BGW_ICE_PURPLE][rand_int(0,3)];
			ascent(i in 0 .. count)
			{
				if (!CanShotBullet(objEnemy)) { return; }
				let ss = speed * (1+i/12);
				let sa = ba - i/count*15*muki;
				let obj = CreateShotA1(sx, sy, ss, sa, graphic, 10);
				ObjMove_AddPatternB2(obj, 0, NO_CHANGE, NO_CHANGE, 0, speed/450, 999, ss);
				if (i == 0) { CallSound(sndShot2); }
				yield;
			}
			wait(wt);
			t += wt;
		}
	}
}

// 横から来る妖精
task SetEnemyF04(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = rand_int(0, 3);
	let eSize = ENEMY_S;
	let eColor = [EFF_RED, EFF_BLUE, EFF_YELLOW, EFF_SKY][e_type];
	let emnImage = [imgZakoFairyRed, imgZakoFairyBlue, imgZakoFairyYellow, imgZakoFairyEx2][e_type];
	let item_count = 3;
	let item_star = 1;
	
	let objEnemy = MakeEnemy(iniX, iniY, 40, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_SMALL);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TShot();
		TMove();
	}
	
	// 移動
	task TMove()
	{
		let vx = iniSpeed * cos(iniAngle);
		let vy = iniSpeed * sin(iniAngle);
		
		let vs = 4;
		let bx = iniX;
		let by = iniY;
		let muki = iniWait;
		let t = 0;
		while(CanShotBullet(objEnemy))
		{
			ObjMove_SetPosition(objEnemy, bx+sin(t*1)*64*muki, by);
			bx += vx*vs; by += vy*vs;
			if (t < 300) { vs = max(1, vs-0.025); }
			else { vs = min(3, vs+0.015); }
			t++;
			yield;
		}
	}
	
	// ショット
	task TShot()
	{
		let wt = [360, 240, 180, 120][Difficult];
		let shot_delay = 15 + trunc(randStage(0,12,iniValue))/12*wt;
		let timer = [240, 240, 360, 360][Difficult];
		
		let speed = [2, 2, 2.5, 3][Difficult];
		let shot_length = [32, 32, 48, 48][Difficult];
		let offset_angle = -15*iniWait;
		
		let t = shot_delay;
		wait(shot_delay);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let sa = 90;
			if (iniX < CenX) { sa -= (ObjMove_GetX(objEnemy)/GetStgFrameWidth)*offset_angle; }
			else { sa -= (1-ObjMove_GetX(objEnemy)/GetStgFrameWidth)*offset_angle; }
			
			TanzakuShot(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
				speed, sa, shot_length, 15);
			CallSound(sndShot2);
			wait(wt);
			wt *= 1.25;
			t += wt;
		}
	}
}

// でか妖精、星飾り
task SetEnemyL02(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_L;
	let eColor = EFF_RED;
	let emnImage = imgZakoFairyRed;
	let item_count = 20;
	let item_star = 5;
	
	let objEnemy = MakeEnemy(iniX, iniY, 350, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_LARGE);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TShot();
		TMove();
	}
	
	// 移動
	task TMove()
	{
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed*4, iniAngle, -iniSpeed/30, 0, iniSpeed);
		ObjMove_AddPatternA2(objEnemy, 360, NO_CHANGE, NO_CHANGE, iniSpeed/30, 0, iniSpeed*4);
	}
	
	// ショット
	task TShot()
	{
		let wt = [120, 120, 120, 90][Difficult];
		let shot_delay = 120;
		let timer = [180, 180, 360, 450][Difficult];
		
		let speed = [1.5, 1.5, 1.75, 1.75][Difficult];
		let graphic = BGW_BALL_BS_YELLOW;
		let muki = [1, -1][iniX < CenX];
		let way = [12, 24, 30, 30][Difficult];
		
		let t = shot_delay;
		wait(shot_delay);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let ba = GetAngleToPlayer(objEnemy);
			let sx = ObjMove_GetX(objEnemy);
			let sy = ObjMove_GetY(objEnemy);
			ascent(i in 0 .. way)
			{
				ascent(j in 0 .. 3)
				{
					let sa = ba + i*360/way + (j-1)*2;
					let ss = speed * (1-absolute(sin(sa*2.5+45))/3);
					CreateShotA1(sx, sy, ss, sa, graphic, 10);
				}
			}
			CallSound(sndShot2);
			wait(wt);
			t += wt;
		}
	}
}

// 舞い上がる星
task SetEnemyS01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyRed;
	let item_count = 0;
	let item_star = 2;
	
	let objEnemy = MakeEnemy(iniX, iniY, 20, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawStarEnemy(objEnemy, 1, 1);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	if (CheckKillType(objEnemy) == 2)
	{
		// 撃ち返し
		TShot();
	}
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
	}
	
	// 移動
	task TMove()
	{
		ZakoEnterEffect_Star(objEnemy);
		ObjMove_AddPatternA2(objEnemy, 0, 0, iniAngle, iniSpeed/120, 0, iniSpeed*3);
	}
	
	// ショット
	task TShot()
	{
		if (!CheckUchikaeshi(objEnemy, 64)) { return; }

		let ex = ObjMove_GetX(objEnemy);
		let ey = ObjMove_GetY(objEnemy);
		let ba = GetAngleToPlayer(objEnemy);
		
		let way = [0, 0, 1, 2][Difficult];
		if (way > 0)
		{
			let speed = [1, 1, 2.5, 3][Difficult];
			let fs = [1, 1, 1.5, 2][Difficult];
			let graphic = BGW_STAR_S_RED;
			
			ascent(i in 0 .. way)
			{
				let bea = rand(0,360);
				descent(j in 0 .. 2)
				{
					let sa = ba + (i-(way-1)/2)*60+180;
					let ea = bea + j*180;
					let sx = ex + cos(ea)*4;
					let sy = ey + sin(ea)*4;
					let ss = speed;
					let to_a = 90 - (i-(way-1)/2)*10;
					let obj = CreateShotA2(sx, sy, fs, sa, -fs/60, 0, graphic, 15);
					ObjMove_AddPatternA2(obj, 60, NO_CHANGE, to_a, ss/120, 0, ss);
				}
				local
				{
					let sx = ex;
					let sy = ey;
					let sa = ba + (i-(way-1)/2)*60+180;
					let ss = speed;
					let to_a = 90 - (i-(way-1)/2)*10;
					let obj = CreateShotA2(sx, sy, fs, sa, -fs/60, 0, graphic, 15);
					ObjMove_AddPatternA2(obj, 60, NO_CHANGE, to_a, ss/120, 0, ss);
				}
				CallSound(sndShot2);
			}
		}
	}
}

task TanzakuShot(x, y, speed, angle, shot_length, delay)
{
	let graphic = BGW_BILL_RED + rand_int(0,7);
	let sl = 0;
	let l = 0;
	while(l < shot_length)
	{
		if (l-sl > 8)
		{
			CreateShotA1(x, y, speed, angle, graphic, delay);
			sl = l;
		}
		l += speed;
		yield;
	}
}
