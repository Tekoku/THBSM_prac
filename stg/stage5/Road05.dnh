function CHAPTER_4()
{
	let loop_ct = (360+360+540-120) / 30;
	
	let pos = [
		[MaxX+24, 200, 1, 180+15, 0, 0],
		[MinX-24, 16, 1, 0+15, 0, 0],
		[MaxX+24, 64, 1, 180-10, 0, 0],
		[MinX-24, 100, 1, 0-10, 0, 0],
		[MaxX+24, 160, 1, 180+15, 0, 0],
		[MinX-24, 140, 1, 0+15, 0, 0],
	];
	
	let enum = 0;
	let st = 0;
	WaitRoad(60);
	loop(loop_ct)
	{
		if ((st >= 0 && length(GetAllEnemyID) < 2) || st > 8)
		{
			// ƒ€ƒJƒf—d¸
			SetEnemyL02(pos[enum][0], pos[enum][1], pos[enum][2], pos[enum][3], pos[enum][4], pos[enum][5]);
			enum = (enum+1)%6;
			st = -4;
		}
		st++;
		WaitRoad(30);
	}
	WaitRoad(120);
	ChapterFinish();
}


task CHAPTER_MBOSS(pathBoss)
{
	// ƒ{ƒX‚ª‚Å‚½‚¼[
	// practice tool: wait for midboss script ready when jumping directly to midboss
	if(GetStartChapter(5) >= 5){ wait(150); }
	CallBoss();
	flgStopSetZako = true;
	// ’†ƒ{ƒX‚ªÁ‚¦‚Ä‚©‚çƒ{ƒX‚ğƒ[ƒh
	StartScriptInThreadWaitBoss(pathBoss);
	
	// ƒ{ƒXŒ‚”j‘Ò‚¿
	CheckBossKilled();
	WaitForMiddleBossKilled();
	wait(15);
	
	flgStopSetZako = false;
}

