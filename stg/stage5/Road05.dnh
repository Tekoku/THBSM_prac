// Šâ•Ç‚©‚ç—ˆ‚é—d¸
task F01(x, y, speed, angle, count, wt, delay)
{
	loop(count)
	{
		SetEnemyF01(x, y, speed, angle, 0, delay);
		wait(wt);
	}
}
task F01b(x, y, speed, angle, count, wt, delay)
{
	ascent(i in 0 .. count)
	{
		SetEnemyF01(x, y, speed, angle, 1, delay);
		wait(wt);
	}
}
// —¬‚ê¯@ˆê‰òŒ^
let S01_SEED = 0;
task S01(x, y, count, wt)
{
	S01_SEED++;
	let max_vr = (count^0.5)*48;
	ascent(i in 0 .. count)
	{
		let vr = randStage(0,max_vr^2,i+S01_SEED*777)^0.5;
		let va = randStage(0,360,i+111+S01_SEED*777);
		let sx = x + cos(va)*vr;
		let sy = y + sin(va)*vr/3;
		let sa = atan2(GetPlayerY-sy, GetPlayerX-sx);
		SetEnemyS01(sx, sy, 8, sa, 0, 0);
		wait(wt);
	}
}
task S01b(x, y, count, wt)
{
	S01_SEED++;
	let max_vr = (count^0.5)*48;
	ascent(i in 0 .. count)
	{
		let vr = randStage(0,max_vr^2,i+S01_SEED*777)^0.5;
		let va = randStage(0,360,i+111+S01_SEED*777);
		let sx = x + cos(va)*vr;
		let sy = y + sin(va)*vr/3;
		let sa = atan2(GetPlayerY-sy, GetPlayerX-sx);
		SetEnemyS01(sx, sy, 8, sa, 1, 0);
		/*
		if (M03_COUNT <= 0)
		{
			let vr = randStage(0,max_vr^2,i+S01_SEED*777)^0.5;
			let va = randStage(0,360,i+111+S01_SEED*777);
			let sx = x + cos(va)*vr;
			let sy = y + sin(va)*vr/3;
			let sa = atan2(GetPlayerY-sy, GetPlayerX-sx);
			SetEnemyS01(sx, sy, 8, sa, 0, 0);
		}
		*/
		wait(wt);
	}
}
