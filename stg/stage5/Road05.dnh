@Initialize
{
	STAGE_ID = 5;		//ƒXƒe[ƒWID‹L˜^
	NEXT_STAGE_ID = 6;	//Ÿ‚ÌƒXƒe[ƒWID‚ğ‹L˜^
	SetLastWordBorder(1777);	//ƒ‰ƒXƒğŒ
	StageInit();
	TStage();
}

@Event()
{
	StageEvent();
}

@Loading
{
}

@MainLoop
{
	yield;
}

task TStage
{
	// •ÛŒ¯
	yield;
	
	let dir = GetCurrentScriptDirectory();
	let pathBG	= dir ~ "BackgroundWorld05.dnh";	//”wŒi
	let pathMBoss	= dir ~ "boss/05a_plural.dnh";	//’†ƒ{ƒX
	let pathBoss	= dir ~ "boss/05b_plural.dnh";	//’†ƒ{ƒX

	//@’†ƒ{ƒXƒ[ƒh
	// practice tool: chapter skip
	let dest = GetStartChapter(5);
	if(dest <= 6)
	{
		StartScriptInThread(pathMBoss);
	}
	else
	{
		StartScriptInThread(pathBoss);
	}
	//  ”wŒi”z’u
	SetStageBackGround(pathBG);
	
	wait(90);
	if(dest <= 8)
	{
		PlayMusicWithName(10, 120, 30);
	}
	else
	{
		PlayMusicWithName(11, 30, 30);
	}
	wait(15);
	
	ChapterStart();
// ------------------------ ‘O”¼
	if(dest <= 1)
	{
		CHAPTER_1();
	}
	if(dest <= 2)
	{
		CHAPTER_2();
	}
	if(dest <= 3)
	{
		CHAPTER_3();
	}
	if(dest <= 4)
	{
		CHAPTER_4();
	}

// ------------------------ ’†ƒ{ƒX
	if(dest <= 6)
	{
		CHAPTER_MBOSS(pathBoss);
	}

// ------------------------ Œã”¼
	if(dest <= 7)
	{
		CHAPTER_5();
	}
	if(dest <= 8)
	{
		CHAPTER_6();
	}

// ------------------------ ƒ{ƒX‚¾‚¼[I
	// practice tool: wait for boss script ready when jumping directly to boss
	if(dest >= 9){ wait(150); }
	wait(60);
	CallBoss();

	// ‘Ò‹@‚Æƒ[ƒh
	WaitForBossKilled();
	wait(30);

	StageEND();
}


function CHAPTER_1()
{
	WaitRoad(30);
	SetHitodama(60-2, 15);	// l°‚í‚ñ‚³‚©
	WaitRoad(330);
	SetEnemyM01(CenX+140, MinY-16, 3, 90+15, 0, 0);	// ’†—d¸
	WaitRoad(120);
	SetEnemyM01(CenX-140, MinY-16, 3, 90-15, 0, 0);	// ’†—d¸
	WaitRoad(240);
	SetEnemyM01(CenX, MinY-16, 3, 90, 0, 0);	// ’†—d¸
	WaitRoad(180);
	DisplayStage05( 0, 90 );
	WaitRoad(390);
	ChapterFinish();
	
	task SetHitodama(count, wt)
	{
		ascent(i in 0 .. count)
		{
			let ba = 90+randStage(-150,150,(i+77)*777);
			let vx = 1 * cos(ba);
			let vy = 1 * sin(ba) + 0.5;
			SetEnemyH01(CenX+vx*16, CenY+vy*16-128, (vx^2+vy^2)^0.5, atan2(vy,vx), -5, 0);
			wait(wt);
		}
	}
}

