// -------------- 敵単体の処理 -------------- //
// chapter1-開幕人魂
task SetEnemyH01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_RED;
	let emnImage = imgZakoFairyYellow;
	let item_count = 3;
	let item_star = 3;

	let objEnemy = MakeEnemy(iniX, iniY, 30, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawHitodama2(objEnemy, eColor);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	if (CheckKillType(objEnemy) == 2)
	{
		// 撃ち返し
		TShot();
	}
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		Hitodama2_FadeIN(objEnemy, 120);
		TMove();
		wait(30);
		
	}
	task TMove()
	{
		let vx = iniSpeed*cos(iniAngle);
		let vy = iniSpeed*sin(iniAngle);
		let vscale = 0;
		
		let t = 0;
		let bx = iniX;
		let by = iniY;
		while(CanShotBullet(objEnemy))
		{
			ObjMove_SetPosition(objEnemy, bx, by+sin(t*5)*vscale*16);
			vscale += 1/120;
			bx += vx*vscale;
			by += vy*vscale;
			t++;
			yield;
		}
	}
	
	// ショット
	task TShot()
	{
		/*
		if (!CheckUchikaeshi(objEnemy, 64)) { return; }
		let ex = ObjMove_GetX(objEnemy);
		let ey = ObjMove_GetY(objEnemy);
		let ba = 90;//atan2(GetPlayerY-ey, GetPlayerX-ex);
		
		let speed = [3, 2, 4.5, 5][Difficult];
		let way = [1, 3, 2, 3][Difficult];
		let way_angle = [1, 10, 2, 3][Difficult];
		let graphic = BGW_FIRE_RED;
		if (way > 0)
		{
			ascent(i in 0 .. way)
			{
				let sa = ba + (i-(way-1)/2)*way_angle;
				let obj = My_CreateShotA2(ex, ey, 1, sa, -1/30, 0.15, graphic, 15);
				ObjMove_AddPatternA2(obj, 90, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
			}
		}
		*/
	}
}

// chapter1-妖精
task SetEnemyM01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_RED;
	let emnImage = imgZakoFairyRed;
	let item_count = 6;
	let item_star = 10;

	let objEnemy = MakeEnemy(iniX, iniY, 100, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_MIDDLE);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
	}
	task TMove()
	{
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed, iniAngle, -iniSpeed/75*7/8, 0, iniSpeed/8);
		ObjMove_AddPatternA2(objEnemy, 180, NO_CHANGE, NO_CHANGE, iniSpeed/240, 0, iniSpeed);
	}
	
	// ショット
	task TShot()
	{
		wait(45);

		
		let speed = [1, 1, 1.25, 1.25][Difficult];
		let way = [11, 11, 13, 15][Difficult];
		let count = [3, 5, 7, 7][Difficult];
		let graphic = [BGW_BALL_BS_RED, BGW_CROSS_SKY][iniValue%2];
		
		let muki = 1;
		ascent(i in 0 .. way)
		{
			if (!CanShotBullet(objEnemy)) { break; }
			loop(2)
			{
				let sa = iniAngle + (i/way)^0.75*180*muki;
				ascent(j in 0 .. count)
				{
					let sr = (j+1)*16;
					let sx = ObjMove_GetX(objEnemy) + sr*cos(sa);
					let sy = ObjMove_GetY(objEnemy) + sr*sin(sa);
					let ss = speed * (1+j*0.1);
					let obj = CreateShotA1(sx, sy, 0, sa, graphic, 0);
					ObjMove_AddPatternA2(obj, 0, ss*2, NO_CHANGE, -ss/120, 3*muki, ss);
					ObjMove_AddPatternA2(obj, 75, NO_CHANGE, NO_CHANGE, 0, 0, ss);
					My_RaiseShotEffectA(obj, 30);
				}
				muki = -muki;
			}
			CallSound(sndShot3);
			wait(3);
		}
	}
}


// chapter2-岩の後ろから出現する妖精
task SetEnemyF01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_SKY;
	let emnImage = imgZakoFairyBlue;
	let item_count = 1;
	let item_star = 2;

	let objEnemy = MakeEnemy(iniX, iniY, 30, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_SMALL);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TDrawWorldBack(iniWait);
		TMove();
		TShot();
	}
	task TMove()
	{
		let muki = [1, -1][iniX < CenX];
		if (iniValue) { muki = -muki; }
		ObjMove_AddPatternA2(objEnemy, 0, 0, iniAngle, iniSpeed/60, 0, iniSpeed);
		ObjMove_AddPatternA2(objEnemy, 60, NO_CHANGE, NO_CHANGE, -iniSpeed/150*3/4, 0, iniSpeed/4);
		ObjMove_AddPatternA2(objEnemy, 210, NO_CHANGE, NO_CHANGE, iniSpeed/360, 0, iniSpeed);
		wait(90);
		ascent(i in 0 .. 120)
		{
			if (!CanShotBullet(objEnemy)) { return; }
			let tmp = sin((i+1)/120*180) * (1-(i+1)/120);
			ObjMove_SetAngle(objEnemy, ObjMove_GetAngle(objEnemy)+tmp*5*muki);
			yield;
		}
		wait(15);
		ascent(i in 0 .. 120)
		{
			if (!CanShotBullet(objEnemy)) { return; }
			let tmp = sin((i+1)/120*180);
			ObjMove_SetAngle(objEnemy, ObjMove_GetAngle(objEnemy)-tmp*1.25*muki);
			yield;
		}
	}
	
	// ショット
	task TShot()
	{
		wait(iniWait);

		let speed = [2.5, 3, 3.5, 4.5][Difficult];
		let way = [1, 1, 1, 1][Difficult];
		let way_angle = [1, 1, 1, 30][Difficult];
		let wt = [150, 105, 75, 45][Difficult];
		let timer = 300;
		
		let add_wt = rand_int(0,4)/5*wt + 15;
		let t = iniWait + add_wt;
		wait(add_wt);
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let ba = GetAngleToPlayer(objEnemy);
			local
			{
				let sa = ba;
				let ss = speed*0.9;
				CreateShotWayA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
					0, sa, ss/120, ss, BGW_BALL_BS_BLUE, 15, way, way_angle, 4);
			}
			local
			{
				let sa = ba+3;
				let ss = speed*0.95;
				CreateShotWayA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
					0, sa, ss/120, ss, BGW_BALL_BS_SKY, 15, way, way_angle, 4);
			}
			local
			{
				let sa = ba-3;
				let ss = speed*0.95;
				CreateShotWayA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
					0, sa, ss/120, ss, BGW_BALL_BS_SKY, 15, way, way_angle, 4);
			}
			local
			{
				let sa = ba;
				let ss = speed;
				CreateShotWayA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
					0, sa, ss/120, ss, BGW_BALL_BS_WHITE, 15, way, way_angle, 4);
			}
			CallSound(sndShot2);
			wait(wt);
		}
	}
	
	task TDrawWorldBack(timer)
	{
		let objImg = GetEnemyImageID(objEnemy);	//画像ID
		
		SetEnemyVisible(objEnemy, false);	//当たり判定消去
		
		Obj_SetRenderPriorityI(objImg, 22);	//画像を谷の裏に
		ObjRender_SetColor(objImg, 128, 128, 128);
		ascent(t in 0 .. timer)
		{
			let tmp_s = 0.2 + ((t+1)/timer) * 0.8;
			let tmp_a = min(255, (t+1)/timer*255*2);
			ObjRender_SetAlpha(objImg, tmp_a);
			ObjRender_SetScaleXYZ(objImg, tmp_s, tmp_s, tmp_s);
			yield;
		}
		Obj_SetRenderPriorityI(objImg, priorityZako);
		ObjRender_SetColor(objImg, 255, 255, 255);
		ObjRender_SetAlpha(objImg, 255);
		ObjRender_SetScaleXYZ(objImg, 1, 1, 1);
		
		SetEnemyVisible(objEnemy, true);	//当たり判定ON
	}
}

// chapter2-自機狙い星
task SetEnemyS01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 0;
	let item_star = 3;

	let objEnemy = MakeEnemy(iniX, iniY, 10, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawStarEnemy(objEnemy, STAR_YELLOW, 1);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		// 出現時効果音
		CallSound(sndBulletBreak);

		TMove();
		if (iniValue == 0) { TShot(); }
	}
	task TMove()
	{
		ZakoEnterEffect_Star(objEnemy);
		ObjMove_AddPatternA2(objEnemy, 0, 0, iniAngle, 0, 0, 0);
		ObjMove_AddPatternA2(objEnemy, 60, NO_CHANGE, iniAngle, iniSpeed/120, 0, iniSpeed);
	}
	
	// ショット
	task TShot()
	{
		wait(60);
		
		let speed = [4, 5, 6, 8][Difficult];
		let way = [1, 1, 3, 3][Difficult];
		let way_angle = [45, 45, 5, 45][Difficult];
		let count = [5, 10, 10, 10][Difficult];
		let wt = [5, 5, 5, 5][Difficult];
		let graphic = BGW_STAR_S_YELLOW;
		
		ascent(i in 0 .. count)
		{
			if (!CanShotBullet(objEnemy)) { break; }
			ascent(j in 0 .. way)
			{
				let sa = iniAngle + (j-(way-1)/2)*way_angle;
				let obj = My_CreateShotA1(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), 0.25, sa, graphic, 30);
				ObjMove_AddPatternA2(obj, 60+30, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
			}
			CallSound(sndShot2);
			wait(wt);
		}
	}
}


// chapter2-でか妖精
task SetEnemyL01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_L;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 10;
	let item_star = 15;
	let eLife = [450, 550][e_type];

	let objEnemy = MakeEnemy(iniX, iniY, 450, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_LARGE);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TFamilier();
		TMove();
		TShot();
	}
	task TMove()
	{
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed, iniAngle, -iniSpeed/75*7/8, 0, iniSpeed/8);
		ObjMove_AddPatternA2(objEnemy, 300, NO_CHANGE, NO_CHANGE, iniSpeed/240, 0, iniSpeed);
	}
	task TFamilier()
	{
		ascent(i in 0 .. 6)
		{
			SetEnemyL01_S(objEnemy, iniSpeed, -90, (i-2.5)*45, iniAngle, 0);
		}
	}
	
	// ショット
	task TShot()
	{
		wait(60);
		
		if (iniValue == 0)
		{
			let speed = [1.5, 1.75, 2, 2.5][Difficult];
			let way = [6, 6, 6, 6][Difficult];
			let way2 = [7, 7, 9, 9][Difficult];
			let wt = [75, 45, 40, 30][Difficult];
			let timer = [240, 300, 300, 300][Difficult];
			
			let graphic = BGW_STAR_M_WHITE;
			
			let t = 0;
			let st = 0;
			while(CanShotBullet(objEnemy) && t < timer)
			{
				let base_angle = GetAngleToPlayer(objEnemy);
				ascent(i in 0 .. way)
				{
					let fs = 1;
					ascent(j in 0 .. way2)
					{
						let sa = base_angle + i/way*360 + (j-(way2-1)/2)*3;
						let ss = speed * (1 + ((way2-1)/2-absolute((j-(way2-1)/2)))*0.1);
						let obj = CreateShotA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
							fs, sa, -fs/30, fs, graphic, 0);
						ObjMove_AddPatternA2(obj, 30, NO_CHANGE, NO_CHANGE, ss/60, 0, ss);
						My_RaiseShotEffectA(obj, 30);
					}
				}
				CallSound(sndShot6);
				t += wt;
				st++;
				wait(wt);
			}
		}
		else
		{
			let speed = [1.75, 2, 2.25, 2.75][Difficult];
			let way = [5, 5, 5, 5][Difficult];
			let way2 = [7, 7, 7, 7][Difficult];
			let wt = [45, 30, 25, 15][Difficult];
			let timer = [240, 300, 300, 300][Difficult];
			
			let graphic = BGW_STAR_M_WHITE;

			let muki = 1;
			let t = 0;
			let st = 0;
			while(CanShotBullet(objEnemy) && t < timer)
			{
				let base_angle = rand(0,360);
				ascent(i in 0 .. way)
				{
					let fs = 2;
					ascent(j in 0 .. way2)
					{
						let sa = base_angle + i/way*360 + (j-(way2-1)/2)*3;
						let ss = speed;
						let obj = CreateShotA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
							fs, sa, -fs/30, fs, graphic, 0);
						ObjMove_AddPatternA2(obj, 30, NO_CHANGE, NO_CHANGE, ss/60, 1*muki, ss);
						ObjMove_AddPatternA2(obj, 120, NO_CHANGE, NO_CHANGE, ss/60, 0, ss);
						My_RaiseShotEffectA(obj, 30);
					}
				}
				CallSound(sndShot6);
				t += wt;
				st++;
				muki = -muki;
				wait(wt);
			}
		}
	}
}
task SetEnemyL01_S(parent, iniSpeed, iniAngle, iniValue, iniValue2, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let baseAngle = iniAngle;
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 0;
	let item_star = 2;

	let objEnemy = MakeEnemy(ObjMove_GetX(parent), ObjMove_GetY(parent), 150, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawStarEnemy(objEnemy, STAR_YELLOW, 1);
	TCheckKillParent(objEnemy, parent);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
	}
	task TMove()
	{
		let r = 0;
		
		let t = 0;
		let bx = ObjMove_GetX(parent);
		let by = ObjMove_GetY(parent);
		while(CanShotBullet(objEnemy))
		{
			if (!Obj_IsDeleted(parent))
			{
				bx = ObjMove_GetX(parent);
				by = ObjMove_GetY(parent);
			}
			else
			{
				break;
			}
			baseAngle = iniAngle + iniValue*(1+sin(t*2)/4);
			if (t < 120)
			{
				let tmp = sin((t+1)/120*90);
				r = tmp*64;
				baseAngle = iniAngle + iniValue*(1+sin(t*2)/4)*tmp;
			}
			ObjMove_SetPosition(objEnemy, bx+r*cos(baseAngle), by+r*sin(baseAngle));
			t++;
			yield;
		}
		Enemy_WaitForDispOUT(objEnemy, 16, 60);
		ObjMove_SetAngle(objEnemy, iniValue2);
		ObjMove_SetSpeed(objEnemy, iniSpeed);
		ObjMove_SetAcceleration(objEnemy, iniSpeed/300);
		ObjMove_SetMaxSpeed(objEnemy, iniSpeed);
	}
	
	// ショット
	task TShot()
	{
		let t = 0;
		let wt = 5;
		let timer = 300;
		
		let speed = 6;
		let way = 3;
		let way_angle = 30;
		let graphic = BGW_CROSS_WHITE;
		while(CanShotBullet(objEnemy) && t < timer)
		{
			let sa = baseAngle;
			CreateShotWayA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
				speed/4, sa, speed/120, speed, graphic, 10, way, way_angle, 0);
			t += wt;
			wait(wt);
		}
	}
}


// chapter3-中妖精星付き
task SetEnemyM02(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_M;
	let eColor = EFF_BLUE;
	let emnImage = imgZakoFairyBlue;
	let item_count = 6;
	let item_star = 10;
	
	let objEnemy = MakeEnemy(iniX, iniY, 300, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_LARGE);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
		TFamilier();
	}
	task TMove()
	{
		let to_speed = 8;
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed, iniAngle, -iniSpeed/120*7/8, 0, iniSpeed/8);
		ObjMove_AddPatternA2(objEnemy, iniWait+120, NO_CHANGE, NO_CHANGE, iniSpeed/240, 0, iniSpeed);
	}
	
	task TFamilier()
	{
		let speed = 8;
		let wt = 10;
		let way = 4;
		let delay = iniWait;
		
		if (iniValue) { way += 2; }
		wait(wt);
		ascent(i in 0 .. way)
		{
			if (!CanShotBullet(objEnemy)) { break; }
			let muki = 1;
			loop(2)
			{
				let va = iniAngle + 105*muki;
				let vr = (i+1.5)*24;
				let sx = iniX + cos(va)*vr;
				let sy = iniY + sin(va)*vr;
				let add_a = (i+1)*5*muki;
				muki = -muki;
				_SetEnemyM02_S(objEnemy, sx, sy, iniSpeed, iniAngle, add_a, i, iniValue, delay+i*10);
			}
			wait(wt);
		}
	}
	
	// ショット
	task TShot()
	{
	}
}
task _SetEnemyM02_S(parent, iniX, iniY, iniSpeed, iniAngle, iniValue, iniValue2, iniValue3, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 0;
	let item_star = 3;

	let objEnemy = MakeEnemy(iniX, iniY, 30, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawStarEnemy(objEnemy, STAR_YELLOW, 1);
	TCheckKillParent(objEnemy, parent);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
	}
	task TMove()
	{
		let to_speed = 8;
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed, iniAngle, -iniSpeed/120*7/8, 0, iniSpeed/8);
		ObjMove_AddPatternA2(objEnemy, iniWait, iniSpeed/8, iniAngle+iniValue, to_speed/120, 0, to_speed);
	}
	
	// ショット
	task TShot()
	{
		wait(iniWait);
		
		let speed = [4, 5, 6, 8][Difficult];
		let way = [3, 3, 5, 5][Difficult];
		let way_angle = [45, 45, 30, 30][Difficult];
		let count = [5, 10, 10, 20][Difficult];
		let wt = 5;
		let graphic = [BGW_STAR_S_PURPLE, BGW_STAR_S_BLUE, BGW_STAR_S_SKY, BGW_STAR_S_GREEN, BGW_STAR_S_YELLOW, BGW_STAR_S_ORANGE, BGW_STAR_S_RED][iniValue2%7];
		
		if (iniValue3)
		{
			way = 3;
		}
		
		let base_angle = iniAngle-iniValue;
		
		let st = 0;
		ascent(i in 0 .. count)
		{
			if (!CanShotBullet(objEnemy)) { break; }
			ascent(i in 0 .. way)
			{
				let sa = base_angle + (i-(way-1)/2)*way_angle;
				let obj = My_CreateShotA1(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), 0.25, sa, graphic, 30);
				ObjMove_AddPatternA2(obj, 60+30, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
			}
			CallSound(sndShot2);
			st++;
			wait(wt);
		}
	}
}

// chapter4-ムカデ妖精
task SetEnemyL02(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return; }

	let e_type = iniValue%3;
	let eSize = ENEMY_L;
	let eColor = [EFF_BLUE, EFF_YELLOW, EFF_RED][e_type];
	let emnImage = [imgZakoFairyBlue, imgZakoFairyYellow, imgZakoFairyRed][e_type];
	let item_count = 10;
	let item_star = 15;
	
	let objEnemy = MakeEnemy(iniX, iniY, 500, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_LARGE);
	TCheckDispINOut(objEnemy, 32);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
		TFamiliar();
	}
	
	task TMove()
	{
		let muki = [1, -1][iniX>CenX];
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed, iniAngle, 0, 0, iniSpeed);
		ObjMove_AddPatternA2(objEnemy, 300, NO_CHANGE, NO_CHANGE, 0, 2*muki, iniSpeed);
		ObjMove_AddPatternA2(objEnemy, 380, NO_CHANGE, NO_CHANGE, 0, 0, iniSpeed);
	}
	
	// おほしさま
	task TFamiliar()
	{
		wait(50);
		ascent(i in 0 .. 8)
		{
			if (!CanShotBullet(objEnemy)) { break; }
			SetEnemyL02_S(objEnemy, iniX, iniY, iniSpeed, iniAngle, e_type, i, 0);
			wait(40);
		}
	}
	
	// ショット
	task TShot()
	{
		wait(60);
		
		let speed = [2.5, 2.5, 3.5, 4][Difficult];
		let way = [3, 5, 5, 7][Difficult];
		let way_angle = [60, 40, 40, 28][Difficult];
		let count = [5, 5, 5, 5][Difficult];
		let wt = [60, 60, 45, 45][Difficult];
		let graphic = BGW_STAR_M_YELLOW;

		let muki = 1;
		while(CanShotBullet(objEnemy))
		{
			descent(j in 0 .. count)
			{
				if (!CanShotBullet(objEnemy)) { break; }
				loop(2)
				{
					let ba = ObjMove_GetAngle(objEnemy) + 90*muki;
					let ss = speed * (1+j*0.25);
					CreateShotWayA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
						0, ba, ss/120, ss, graphic, 15, way, way_angle, 8);
					muki = -muki;
				}
				wait(5);
				CallSound(sndShot2);
			}
			wait(wt-5*count);
		}
	}
}


// 使い魔おほしさま
task SetEnemyL02_S(parent, iniX, iniY, iniSpeed, iniAngle, iniValue, iniValue2, iniWait)
{
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyRed;
	let item_count = 0;
	let item_star = 3;
	
	let objEnemy = MakeEnemy(iniX, iniY, 30, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawStarEnemy(objEnemy, STAR_YELLOW, 1);
	TCheckKillParent(objEnemy, parent);
	TCheckDispINOut(objEnemy, 24);
	TAct();
	WaitForKilledZako(objEnemy);
	if (CheckKillType(objEnemy) == 2 && !Obj_GetValueD(objEnemy, "KILLED_PARENT", 0))
	{
		// 撃ち返し
		TShot();
	}
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
	}
	
	// 移動
	task TMove()
	{
		let muki = [1, -1][iniX>CenX];
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed, iniAngle, 0, 0, iniSpeed);
		ObjMove_AddPatternA2(objEnemy, 300, NO_CHANGE, NO_CHANGE, 0, 2*muki, iniSpeed);
		ObjMove_AddPatternA2(objEnemy, 380, NO_CHANGE, NO_CHANGE, 0, 0, iniSpeed);
	}
	
	// ショット
	task TShot()
	{
		wait(60);

		let speed = [2.5, 2.5, 3.5, 4][Difficult];
		let way = [1, 1, 1, 1][Difficult];
		let way_angle = [1, 1, 1, 1][Difficult];
		let count = [5, 5, 5, 5][Difficult];
		let wt = [60, 60, 45, 45][Difficult];
		let graphic = [BGW_STAR_S_ORANGE, BGW_STAR_S_RED, BGW_STAR_S_PURPLE, BGW_STAR_S_BLUE, BGW_STAR_S_SKY, BGW_STAR_S_GREEN, BGW_STAR_S_YELLOW][iniValue2%7];

		let muki = 1;
		while(CanShotBullet(objEnemy))
		{
			descent(j in 0 .. count)
			{
				if (!CanShotBullet(objEnemy)) { break; }
				loop(2)
				{
					let ba = ObjMove_GetAngle(objEnemy) + 90*muki;
					let ss = speed * (1+j*0.25);
					CreateShotWayA2(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
						0, ba, ss/120, ss, graphic, 15, way, way_angle, 8);
					muki = -muki;
				}
				wait(5);
				CallSound(sndShot2);
			}
			wait(wt-5*count);
		}
	}
}


// chapter5-中妖精星付き
let M03_COUNT = 0;
task SetEnemyM03(iniX, iniY, iniSpeed, iniAngle, iniValue, iniMuki, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_M;
	let eColor = EFF_RED;
	let emnImage = imgZakoFairyRed;
	let item_count = 6;
	let item_star = 10;
	
	M03_COUNT++;
	
	let objEnemy = MakeEnemy(iniX, iniY, 300, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawFairy(objEnemy, emnImage, FAIRY_LARGE);
	TCheckDispINOut(objEnemy, 16);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	M03_COUNT--;
	
	task TAct()
	{
		TMove();
		TShot();
		TFamilier();
	}
	task TMove()
	{
		let to_speed = 8;
		ObjMove_AddPatternA2(objEnemy, 0, iniSpeed, iniAngle, -iniSpeed/120*3/4, 0, iniSpeed/4);
		ObjMove_AddPatternA2(objEnemy, 120, NO_CHANGE, NO_CHANGE, iniSpeed/240, 0, iniSpeed);
		
		ascent(t in 0 .. 360)
		{
			if (!CanShotBullet(objEnemy)) { break; }
			let tmp = cos(t/360*270);
			let add_angle = tmp*1.75*iniMuki;
			if (t > 120) { add_angle = tmp*0.85*iniMuki; }
			ObjMove_SetAngle(objEnemy, ObjMove_GetAngle(objEnemy)+add_angle);
			yield;
		}
	}
	
	task TFamilier()
	{
		let speed = 8;
		let wt = 10;
		let way = 4;
		let delay = iniWait;
		
		if (iniValue) { way += 2; }
		ascent(i in 0 .. way)
		{
			if (!CanShotBullet(objEnemy)) { break; }
			let muki = 1;
			loop(2)
			{
				let va = iniAngle + 105*muki;
				let vr = (i+1.5)*24;
				let sx = iniX + cos(va)*vr;
				let sy = iniY + sin(va)*vr;
				let add_a = (i+1)*5*muki;
				muki = -muki;
				_SetEnemyM03_S(objEnemy, sx, sy, iniSpeed, iniAngle, i, muki, (i+1)*wt+trunc(wt/2));
			}
		}
	}
	
	// ショット
	task TShot()
	{
		let speed = [4, 5, 6, 7][Difficult];
		let way = [1, 1, 2, 3][Difficult];
		let way_angle = [1, 30, 30, 30][Difficult];
		let wt = [6, 5, 5, 5][Difficult];
		let graphic = BGW_STAR_M_YELLOW;
		
		let base_angle = iniAngle-iniValue;
		
		let st = 0;
		while(CanShotBullet(objEnemy))
		{
			ascent(i in 0 .. way)
			{
				let sa = ObjMove_GetAngle(objEnemy) + (i-(way-1)/2)*way_angle;
				let obj = My_CreateShotA1(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), 0.25, sa, graphic, 30);
				ObjMove_AddPatternA2(obj, 60+30, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
			}
			ascent(i in 0 .. way)
			{
				let sa = ObjMove_GetAngle(objEnemy)+180 + (i-(way-1)/2)*way_angle;
				let obj = My_CreateShotA1(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), 0.25, sa, graphic, 30);
				ObjMove_AddPatternA2(obj, 60+30, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
			}
			CallSound(sndShot2);
			st++;
			wait(wt);
		}
	}
}
task _SetEnemyM03_S(parent, iniX, iniY, iniSpeed, iniAngle, iniValue, iniMuki, iniWait)
{
	if (flgStopSetZako) { return; }
	
	let e_type = iniValue%2;
	let eSize = ENEMY_S;
	let eColor = EFF_YELLOW;
	let emnImage = imgZakoFairyYellow;
	let item_count = 0;
	let item_star = 3;

	let objEnemy = MakeEnemy(-128, -128, 30, eSize);
	SetDropItemCount(objEnemy, item_count, item_star);
	DrawStarEnemy(objEnemy, STAR_YELLOW, 1);
	TCheckKillParent(objEnemy, parent);
	TAct();
	WaitForKilledZako(objEnemy);
	ZakoFinalize(objEnemy, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
	}
	task TMove()
	{
		let beforeX = [ObjMove_GetX(parent)];
		let beforeY = [ObjMove_GetY(parent)];

		let er = 16*(iniValue+1);
		while(CanShotBullet(objEnemy))
		{
			if (CanShotBullet(parent))
			{
				let ea = ObjMove_GetAngle(parent);
				let ex = ObjMove_GetX(parent) + cos(ea+90*iniMuki)*er;
				let ey = ObjMove_GetY(parent) + sin(ea+90*iniMuki)*er;
				beforeX = beforeX ~ [ex];
				beforeY = beforeY ~ [ey];
			}
			if (length(beforeX) > iniWait || !CanShotBullet(parent))
			{
				if (!CanShotBullet(parent) && length(beforeX) <= 2)
				{
					let vs = ((beforeY[1]-beforeY[0])^2+(beforeX[1]-beforeX[0])^2)^0.5;
					let va = atan2(beforeY[1]-beforeY[0], beforeX[1]-beforeX[0]);
					ObjMove_SetSpeed(objEnemy, vs);
					ObjMove_SetAngle(objEnemy, va);
					ObjMove_SetAcceleration(objEnemy, (4-vs)/60);
					ObjMove_SetMaxSpeed(objEnemy, 4);
					Enemy_WaitForDispOUT(objEnemy, 16, 0);
					break;
				}
				beforeX = erase(beforeX, 0);
				beforeY = erase(beforeY, 0);
			}
			if (length(beforeX) <= 0)
			{
				EraseEnemy(objEnemy);
				break;
			}
			ObjMove_SetPosition(objEnemy, beforeX[0], beforeY[0]);
			yield;
		}
	}
	
	// ショット
	task TShot()
	{
		let speed = [4, 5, 6, 7][Difficult];
		let way = [1, 2, 2, 2][Difficult];
		let way_angle = [1, 30, 30, 30][Difficult];
		let wt = [6, 5, 5, 5][Difficult];
		let graphic = [BGW_STAR_S_GREEN, BGW_STAR_S_SKY, BGW_STAR_S_BLUE, BGW_STAR_S_PURPLE, BGW_STAR_S_RED, BGW_STAR_S_ORANGE, BGW_STAR_S_YELLOW][iniValue%7];
		
		let base_angle = iniAngle-iniValue;
		
		let st = 0;
		while(CanShotBullet(objEnemy) && CanShotBullet(parent))
		{
			ascent(i in 0 .. way)
			{
				let sa = ObjMove_GetAngle(parent)+90*iniMuki + (i-(way-1)/2)*way_angle;
				let obj = My_CreateShotA1(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), 0.25, sa, graphic, 30);
				ObjMove_AddPatternA2(obj, 60+30, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
			}
			CallSound(sndShot2);
			st++;
			wait(wt);
		}
	}
}
