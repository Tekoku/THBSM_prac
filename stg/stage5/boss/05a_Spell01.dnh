#東方弾幕風[Single]
#ScriptVersion[3]
#Title["清め火の巫女"]
#Text["清め火の巫女"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./lib_Nezu.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(3000);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(45);		}
	BossEvent();
}

@Initialize {
	if (IsInfinityMode()) { bossDropItemSpecial = [MY_ITEM_SPELL]; }
	else { bossDropItemSpecial = [MY_ITEM_LIFE]; }
	
	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_NEZU_R);	//ボスセット
	CheckLinkLife_Boss(objEnemy);	// 使い魔と体力連動

	//スペカデータ・セット
	SetSpellCardData(GetSpellCardID(41), [0,0,1,1][Difficult], 
			GetCurrentScriptDirectory()~"05a_Background.dnh",
			GetBossTexture(objEnemy, I_CUTIN), 1, CUTMOTION_NORMAL);

	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	standBy(objEnemy, CenX, 140, 60);
	wait(60);
	CallSpellCard(true);	//スペカ起動
	wait(60);
	
	let way = [8, 10, 10, 10][Difficult];
	let wt = [270, 240, 270, 240][Difficult];
	
	let muki = rand_dir();
	while(eAlive)
	{
		SetRollFamilier(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), rand(0,360), way, muki);
		CallSound(sndBoon);
		wait(120);
		if (!eAlive) { return; }
		EnemyRandomMove(objEnemy, 140, 48);
		wait(wt-120);
		muki = -muki;
	}
}

task SetRollFamilier(x, y, angle, way, muki)
{
	let timer = 900;
	ascent(i in 0 .. way)
	{
		SetFamilier01(x, y, 1, i*360/way, muki, i, timer);
	}
}


// 使い魔
task SetFamilier01(iniX, iniY, iniSpeed, iniAngle, iniMuki, iniValue, iniTimer)
{
	let eSize = ENEMY_M;
	let eColor = EFF_BLUE;
	let item_count = 0;
	let item_star = 0;
	
	let objFamilier = MakeEnemyFamilier(iniX, iniY, 100, eSize);
	CheckLinkLife_Familier(objEnemy, objFamilier, 0.85);	// ボスと体力連動
	NezuOption_SetDamageRate(objFamilier);	// ダメージ軽減率自機別設定
	SetDropItemCount(objFamilier, item_count, item_star);
	SetEnemyVisible(objFamilier, false);
	DrawHitodama(objFamilier, eColor);
	TAct();
	WaitForKilledFamilier(objFamilier, 24, 4);
	ZakoFinalize(objFamilier, eColor);
	
	task TAct()
	{
		TMove();
		TShot();
	}

	task TMove()
	{
		let add_r = iniSpeed;
		let add_a = 4*iniMuki;
		
		let r = 0;
		let angle = iniAngle;

		let t = 0;
		if (Difficult >= D_HARD)
		{
			// Hard以上で追尾
			while (CanShotBullet(objFamilier) && t < 120)
			{
				if (!CheckDispIN(objFamilier, 0))
				{
					ObjEnemy_SetLife(objFamilier, 0);
					CallSound(sndShot1);
					EraseEnemy(objFamilier);
					break;
				}
				if (t == 60)
				{
					SetEnemyVisible(objFamilier, true);
				}
				
				if (t < 90)
				{
					let tmp = (t+1)/90;
					r += add_r*(1-tmp)*2.5;
					angle += add_a*32/(r+32)*(2-tmp)*2;
				}
				else if (t < 120)
				{
					angle += add_a*32/(r+32)*2;
				}

				ObjMove_SetPosition(objFamilier, iniX+cos(angle)*r, iniY+sin(angle)*r);
				t++;
				yield;
			}
			
			// 追尾
			let speed = absolute(r*2*3.14159265 * (add_a*32/(r+32)*2)/360);
			let move_angle = angle + iniMuki*90;
			let horming_power = 4;
			ObjMove_AddPatternA2(objFamilier, 0, speed, move_angle, -speed*3/4/60, 0, speed/4);
			ObjMove_AddPatternA2(objFamilier, 60, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
			
			t = 0;
			while (CanShotBullet(objFamilier))
			{
				if (!CheckDispIN(objFamilier, 0))
				{
					ObjEnemy_SetLife(objFamilier, 0);
					CallSound(sndShot1);
					EraseEnemy(objFamilier);
					break;
				}
				let pow = horming_power;
				if (t < 60) { pow *= (t+1)/60; }
				else { pow *= max(0, 1-(t-60)/60); }
				move_angle = GetHormingAngle(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier), move_angle, pow);
				ObjMove_SetAngle(objFamilier, move_angle);
				t++;
				yield;
			}
		}
		else
		{
			// 追尾しない
			while (CanShotBullet(objFamilier))
			{
				if (!CheckDispIN(objFamilier, 0))
				{
					ObjEnemy_SetLife(objFamilier, 0);
					EraseEnemy(objFamilier);
					CallSound(sndShot1);
					break;
				}
				if (t == 60)
				{
					SetEnemyVisible(objFamilier, true);
				}
				
				if (t < 90)
				{
					let tmp = (t+1)/90;
					r += add_r*(1-tmp)*2.5;
					angle += add_a*32/(r+32)*(2-tmp)*2;
				}
				else if (t < 120)
				{
					angle += add_a*32/(r+32)*2;
				}
				else if (t < 240)
				{
					let tmp = (t-120)/120;
					r += add_r*tmp;
					angle += add_a*32/(r+32)*(2-1*tmp);
				}
				else
				{
					r += add_r;
					angle += add_a*32/(r+32);
				}

				ObjMove_SetPosition(objFamilier, iniX+cos(angle)*r, iniY+sin(angle)*r);
				t++;
				yield;
			}
		}
	}
	
	
	task TShot()
	{
		let speed = [1.25, 1.5, 1.75, 2][Difficult];
		let way = [10, 12, 12, 12][Difficult];
		let max_r = [28, 32, 32, 32][Difficult];

		let base_angle = rand(0, 360);
		let muki = iniMuki;

		let graphic = [ADD_BGW_FIRE_SKY];
		let to_graphic = [BGW_BALL_BS_WHITE];
		if (Difficult >= D_HARD)
		{
			graphic = [ADD_BGW_FIRE_RED, ADD_BGW_FIRE_YELLOW, ADD_BGW_FIRE_SKY, ADD_BGW_FIRE_BLUE];
			to_graphic = [BGW_BALL_BS_WHITE, BGW_BALL_BS_WHITE, BGW_BALL_BS_WHITE, BGW_BALL_BS_WHITE];
		}
		
		ascent(i in 0 .. way)
		{
			let sa = base_angle + i*360/way;
			RollingShot(objFamilier, speed, sa, 5*muki, max_r, 90*muki, graphic[i%length(graphic)], to_graphic[i%length(graphic)]);
		}
	}
	task RollingShot(objParent, speed, angle, add_angle, max_r, offset_angle, graphic, to_graphic)
	{
		let obj = CreateShotA1(ObjMove_GetX(objParent), ObjMove_GetY(objParent), 0, angle, graphic, 0);
		My_RaiseShotEffectA(obj, 45);
		
		let r = 0;
		let a = angle;
		let t = 0;
		while(!Obj_IsDeleted(obj))
		{
			if (Obj_IsDeleted(objParent))
			{
				My_CreateShotA2(ObjMove_GetX(obj), ObjMove_GetY(obj), 0, ObjMove_GetAngle(obj), speed/90, speed, to_graphic, 15);
				ObjShot_FadeDelete(obj);
				break;
			}
			if (t < 60)
			{
				let tmp = (t+1)/60;
				r = (2-tmp)*max_r;
			}
			ObjMove_SetPosition(obj, ObjMove_GetX(objParent)+r*cos(a), ObjMove_GetY(objParent)+r*sin(a));
			ObjMove_SetAngle(obj, a+offset_angle);
			a += add_angle;
			t++;
			yield;
		}
	}
}
