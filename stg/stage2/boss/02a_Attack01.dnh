#東方弾幕風[Single]
#ScriptVersion[3]
#Title["鳶子道中通常"]
#Text["鳶子道中通常1"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./lib_Tobiko.dnh"

let TobikoZ = 0;

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(1);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(-1);		}
	BossEvent();
}

@Initialize {
	bossDropItem = 0;	//アイテム数
	
	Boss_Init();	//初期設定
	objEnemy = CreateBossTalk(BOSS_ID_TOBIKO);	//ボスセット

	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
//	TDrawTobikoZ();
	let objImg = CreateHiddenTobiko();
	wait(60);
	
	let timer = 90;
	TobikoZ = 1;
	TMoveShot([MinX-64, 40], [MaxX+64, 120], timer, 0);
	SetAction(objImg, ACT_MOVE_R, timer);
	wait(180);
	TobikoZ = 0.75;
	TMoveShot([MaxX+64, 200], [MinX-64, 60], timer, 1);
	SetAction(objImg, ACT_MOVE_L, timer);
	wait(180);
	TobikoZ = 0.5;
	TMoveShot([MinX-64, 160], [MaxX+64, 0], timer, 2);
	SetAction(objImg, ACT_MOVE_R, timer);
	wait(180);
	TobikoZ = 0;
	ObjMove_SetPosition(objEnemy, MaxX+64, 60);
	MoveToSlowdown2(objEnemy, CenX, 140, 60);
	wait(15);
	Obj_SetValue(objImg, "FADEOUT", true);
	CallSound(sndBoon);
	wait(45);
	Boss_Finalize(objEnemy, false, false);
	// チャプター終了
	if (GetPlayMode() == GAME_MAIN || GetPlayMode() == GAME_PRACTICE)
	{
		if (!Obj_GetValueD(objScene, "RUN_AWAY", false)) { ChapterFinishBoss(120); }
		else { ChapterFinishBoss(0); }
	}
}

task TMoveShot(pos1, pos2, timer, counter)
{
	ObjMove_SetPosition(objEnemy, pos1[0], pos1[1]);
	MoveToSlowdown2(objEnemy, pos2[0], pos2[1], timer);
	TShot01(timer, counter);
}

task TShot01(timer, counter)
{
	let graphic = BGW_FUGU_RED;
	let wt = 3;

	let speed;
	let way;
	let max_r;
	let add_a;
	
	alternative(counter)
	case(0)
	{
		speed = [3, 4, 4.5, 5][Difficult];
		way = [1, 1, 3, 3][Difficult];
		max_r = [1, 1, 32, 64][Difficult];
		add_a = 4;
	}
	case(1)
	{
		speed = [3, 4, 4.5, 5][Difficult];
		way = [2, 2, 5, 5][Difficult];
		max_r = [48, 64, 96, 128][Difficult];
		add_a = -4;
	}
	case(2)
	{
		speed = [3, 4, 4.5, 5][Difficult];
		way = [3, 3, 8, 8][Difficult];
		max_r = [96, 128, 140, 192][Difficult];
		add_a = 4;
	}
	
	CallSound(sndShot7);
	ascent(t in 0 .. timer)
	{
		if (t%wt == 0)
		{
			let tmp = t/timer;
			let ba = GetAngleToPlayer(objEnemy);
			let tmp_way = way;
			if (tmp <= 0) { tmp_way = 1; }
			ascent(i in 0 .. way)
			{
				let or = tmp * max_r;
				let oa = add_a*t + i*360/way;
				CreateZShotA1(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), TobikoZ, speed, ba, graphic, 0, or, oa);
			}
		}
		yield;
	}
}

task CreateZShotA1(x, y, z, speed, angle, graphic, delay, offset_r, offset_a)
{
	let tmp_t = (((GetPlayerY-y)^2+(GetPlayerX-x)^2)^0.5) / speed;
	let z_speed = -z/tmp_t;
	let vx = cos(angle)*speed + offset_r/tmp_t*cos(offset_a);
	let vy = sin(angle)*speed + offset_r/tmp_t*sin(offset_a);
	
	let obj = CreateShotB1(x, y, vx, vy, graphic, 0);
	ObjShot_SetIntersectionEnable(obj, false);
	
	let alpha = 255;
	let sz = z;
	while(!Obj_IsDeleted(obj))
	{
		let tmp_s = 1/(max(-0.5,sz)+1);
		if (sz <= -0.25 || sz > 2)
		{
			ObjShot_SetIntersectionEnable(obj, false);
			alpha -= 20;
			if (alpha < 0) { break; }
		}
		else if (absolute(sz) < 0.25)
		{
			Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI());
			ObjShot_SetIntersectionCircleA1(obj, 4);
			ObjShot_SetIntersectionEnable(obj, true);
			alpha = 255;
		}
		else
		{
			Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI());
			ObjShot_SetIntersectionEnable(obj, false);
			alpha = 160;
		}
		ObjRender_SetScaleXYZ(obj, 1.5*tmp_s, 2*tmp_s^2, 1);
		ObjRender_SetAlpha(obj, alpha);
		sz += z_speed;
		yield;
	}
	Obj_Delete(obj);
}



// Z座標込み描画
task TDrawTobikoZ()
{
	let objImg = GetBossImageID(objEnemy);
	while(eAlive)
	{
		let tmp_s = (1/(TobikoZ+1))^0.5;
		let tmp_f = (TobikoZ <= 0);
		ObjRender_SetScaleXYZ(objImg, tmp_s, tmp_s, 1);
		if (tmp_f)
		{
			Obj_SetRenderPriorityI(objImg, priorityBoss);
			ObjRender_SetColor(objImg, 255, 255, 255);
		}
		else
		{
			Obj_SetRenderPriorityI(objImg, 40);
			ObjRender_SetColor(objImg, 128, 128, 128);
		}
		yield;
	}
}

function CreateHiddenTobiko()
{
	let objParent = CreateShotA1(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), 0, 0, BGW_BALL_S_RED, 0);
	SetShotDisabled(objParent);
	ObjShot_SetAutoDelete(objParent, false);
	Obj_SetVisible(objParent, false);
	DrawShadowTobiko(objParent);
	
	return(objParent);
}
task DrawShadowTobiko(parent)
{
	// ボスグラを消す
	let objImgMain = GetBossImageID(objEnemy);
	Obj_SetVisible(objImgMain, false);
	
	//初期設定
	Boss_SetIDtoObj(parent, BOSS_ID_TOBIKO_H);
	
	//タスク起動
	Boss_AnimeTimer(parent);	//アニメ状態管理タスク
	BossAnime_Initialize(parent);	//ボス描画タスク

	let objImg = GetBossImageID(parent);
	ObjRender_SetBlendType(objImg, BLEND_ADD_ARGB);
	Obj_SetRenderPriorityI(objImg, priorityBoss+1);

	let fade_flg = false;
	while(!Obj_IsDeleted(parent))
	{
		if (!Obj_IsDeleted(objEnemy))
		{
			ObjMove_SetPosition(parent, ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy));
		}
		if (!fade_flg && Obj_GetValueD(parent, "FADEOUT", false))
		{
			fade_flg = true;
			SetNoiseFadeEffect(objImg, 15, 45);
			RaiseTobiko(objImgMain, 45);
		}

		let tmp_s = (1/(TobikoZ+1))^0.5;
		ObjRender_SetScaleXYZ(objImg, tmp_s, tmp_s, 1);
		yield;
	}
}

task RaiseTobiko(objImg, timer)
{
	Obj_SetVisible(objImg, true);
	ascent(i in 0 .. timer)
	{
		let tmp = (i+1)/timer*255;
		ObjRender_SetAlpha(objImg, tmp);
		yield;
	}
}