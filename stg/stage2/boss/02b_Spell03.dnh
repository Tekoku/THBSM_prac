#東方弾幕風[Single]
#ScriptVersion[3]
#Title["ブラックマジックカイト"]
#Text["ブラックマジックカイト"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./lib_Tobiko.dnh"

let pathBossTexture = "";

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(9999);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(32);		}
	case(EV_REQUEST_IS_DURABLE_SPELL) { SetScriptResult(true);	}
	BossEvent();
}

@Initialize {
	bossHitToPlayer = 12;	//体当たり判定小さめ
	
	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_TOBIKO);	//ボスセット
	SetEnemyVisible(objEnemy, false);
	BossEffect_DisableMagicCircle(objEnemy);	// 魔法陣OFF
	
	//スペカデータ・セット
	SetSpellCardData(GetSpellCardID(14), [9,9,10,11][Difficult], 
			GetCurrentScriptDirectory()~"02a_Background.dnh",
			GetBossTexture(objEnemy, I_CUTIN), 1, CUTMOTION_NORMAL);

	// テクスチャ代入
	pathBossTexture = Boss_GetBossImage(objEnemy);
	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	standBy(objEnemy, CenX, 140, 60);
	wait(60);
	SetEnemyVisible(objEnemy, false);
	wait(120);
	
	CallSpellCard(true);	//スペカ起動
	
	wait(60);
	CallSound(sndBoon);
	ascent(t in 0 .. 60)
	{
		ObjRender_SetAlpha(GetBossImageID(objEnemy), (1-(t+1)/60)*255);
		if (t%5 == 0)
		{
			ShadowTobiko01(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), rand(0,360));
		}
		yield;
	}
	ObjMove_SetPosition(objEnemy, CenX, 0);
	wait(60);
	
	if (Difficult <= D_NORM)
	{
		let count = [3, 3, 3, 3][Difficult];
		let wt = [120, 90, 90, 90][Difficult];
		let st = 0;
		while(eAlive)
		{
			loop(count)
			{
				if (!eAlive) { return; }
				if (ObjEnemyBossScene_GetInfo(objScene, INFO_TIMERF) < 120) { return; }
				let ba = -90 + rand(-45,45);
				let bx = CenX+cos(ba)*480;
				let by = CenY+sin(ba)*320;
				let sa = atan2(GetPlayerY-by, GetPlayerX-bx);
				ShadowTobiko02(bx, by, sa);
				wait(10);
			}
			count = min(10, count+0.5);
			wait(wt);
			if (st == 0) { wait(wt/2); }
			else { wt *= 0.9; }
			st++;
		}
	}
	else
	{
		let base_wt = [99, 99, 8, 6][Difficult];
		let dec_wt = [1, 1, 4.9, 3][Difficult];
		
		let max_timer = ObjEnemyBossScene_GetInfo(objScene, INFO_ORGTIMERF);
		let st = 0;
		while(eAlive)
		{
			if (ObjEnemyBossScene_GetInfo(objScene, INFO_TIMERF) < 90) { return; }
			local
			{
				let ba = -30+st*4.52 + st*180;
				let bx = CenX+cos(ba)*480;
				let by = CenY+sin(ba)*320;
				let sa = 180-ba;
				if (st%2 == 1) { sa = sa+90; }
				else { sa = sa-90 }
				ShadowTobiko02(bx, by, sa);
			}
			local
			{
				let ba = -30-st*4.52 + st*180+90;
				let bx = CenX+cos(ba)*480;
				let by = CenY+sin(ba)*320;
				let sa = 360-ba;
				if (st%2 == 1) { sa = sa+90; }
				else { sa = sa-90 }
				ShadowTobiko02(bx, by, sa);
			}
			st++;
			
			let wt = max(1, base_wt - (1-ObjEnemyBossScene_GetInfo(objScene, INFO_TIMERF)/max_timer)*dec_wt);
			wait(wt);
		}
	}
}

// 開幕用
task ShadowTobiko01(x, y, angle)
{
	let objParent = CreateShotA2(x, y, 6, angle, -6/30, 0, BGW_BALL_S_RED, 0);
	ObjMove_AddPatternA2(objParent, 20, NO_CHANGE, NO_CHANGE, 24/60, 0, 24);
	SetShotDisabled(objParent);
	Obj_SetVisible(objParent, false);
	DrawShadowTobiko(objParent);
	SetAction(objParent, [ACT_MOVE_L,ACT_MOVE_R][cos(angle)>0], 9999);
}

// 体当たり
task ShadowTobiko02(x, y, angle)
{
	// 画面内を通らない場合はスルー
	if (CheckCrossLineRect([x,y,x+cos(angle)*1200,y+sin(angle)*1200], [MinX,MinY,MaxX,MinY,MaxX,MaxY,MinX,MaxY])) { return; }
	
	TobikoSlash(x, y, x+800*cos(angle), y+800*sin(angle), 60);
	CallSound(sndBulletBreak);
	wait(30);
	if (!eAlive) { return; }
	let objParent = CreateShotA2(x, y, 4, angle, 16/90, 20, BGW_BALL_S_RED, 0);
	ObjMove_AddPatternA2(objParent, 20, NO_CHANGE, NO_CHANGE, 24/60, 0, 24);
	SetShotDisabled(objParent);
	ObjShot_SetAutoDelete(objParent, false);
	Obj_SetVisible(objParent, false);
	DrawShadowTobiko(objParent);
	SetAction(objParent, [ACT_MOVE_L,ACT_MOVE_R][cos(angle)>0], 9999);
	TShotTobiko();
	
	wait(20);
//	ObjShot_FadeDelete(objDummy);
	
	wait(60);
	ObjShot_SetAutoDelete(objParent, true);
	
	task TShotTobiko()
	{
		let speed = 6;
		let way = 5;
		let graphic = BGW_FUGU_YELLOW;
		let shot_angle = angle;
		let way_angle = [0.25, 0.5, 1, 1][Difficult];
		
		let t = 0;
		while(!Obj_IsDeleted(objParent))
		{
			if (CheckDispIN(objParent, 32))
			{
				let wa = 1 + t*way_angle;
				CreateShotTobikoArrow(ObjMove_GetX(objParent), ObjMove_GetY(objParent),
					0, shot_angle, speed/30, speed, graphic, 15, way, wa, 2);
				CallSound(sndShot3);
				t++;
			}
			wait(5);
		}
	}
}


task DrawShadowTobiko(parent)
{
	//初期設定
	Boss_SetIDtoObj(parent, BOSS_ID_TOBIKO);
	
	//タスク起動
	Boss_AnimeTimer(parent);	//アニメ状態管理タスク
	BossAnime_Initialize(parent);	//ボス描画タスク
	ObjRender_SetColor(GetBossImageID(parent), 128, 128, 128);
	
	while(!Obj_IsDeleted(parent))
	{
		DrawShadowTobiko_sub(parent);
		yield;
	}
}

task DrawShadowTobiko_sub(parent)
{
	let obj = GetBossImageObject(parent, ObjMove_GetX(parent), ObjMove_GetY(parent), pathBossTexture);
	Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI()+1);
	ObjRender_SetBlendType(obj, BLEND_ADD_ARGB);
	ascent(t in 0 .. 12)
	{
		ObjRender_SetAlpha(obj, (12-t)/12*128);
		yield;
	}
	Obj_Delete(obj);
}
