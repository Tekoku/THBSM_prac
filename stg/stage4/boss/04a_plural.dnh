//#東方弾幕風[Plural]
#ScriptVersion[3]
#Title["4面道中ボス 連続再生"]
#Text[""]
#System["./../../../system/System.dnh"]


#include"./../../../lib/lib_Boss.dnh"
#include"./../../../lib/lib_ChapterSkip.dnh"

let objBossScene;
let objTalkScene02;
let dir = GetCurrentScriptDirectory();
let dest = GetStartChapter(4);

@Initialize
{
	TPlural();
}

@Event
{
	alternative( GetEventType() )
	//　ボス登場イベント
	case( ev_ResistBoss )
	{
		ResistSceneScript();
	}
}

@MainLoop
{
	yield;
}

// 裏でボスシーンをロード
task TPlural
{
	// ボスシーンを作成します。
	objBossScene = ObjEnemyBossScene_Create();
	
	// ボスシーンの初期設定
	BossScene_SetInit(objBossScene,
		BOSS_ID_MOKOU,	// ボスID
		[CenX-64, -128],		// 初期座標
	);
	// 逃走フラグON
	Obj_SetValue(objBossScene, "RUN_AWAY", true);

	// 会話
	if(dest < 4 || GetPracFull())
	{
	alternative(GetPlayerType())
	case(PLAYER_REIMU_A)  { ObjEnemyBossScene_Add(objBossScene, 0, dir ~ "04a_Talk01a.dnh"); }
	case(PLAYER_MARISA_A) { ObjEnemyBossScene_Add(objBossScene, 0, dir ~ "04a_Talk01b.dnh"); }
	case(PLAYER_SANAE_A)  { ObjEnemyBossScene_Add(objBossScene, 0, dir ~ "04a_Talk01c.dnh"); }
	}

	// practice tool: chapter skip aware
	let files = ["04a_Attack01.dnh", "04a_Spell01.dnh"];
	let sht = [0, 1];
	let extraA = ["04a_Motion01.dnh", ""];
	ChapterSkip_AddFromEx(objBossScene, dest, 4, sht, files, dir, [], extraA);
	ObjEnemyBossScene_LoadInThread(objBossScene);
}

// ボスシーンの起動
task ResistSceneScript
{
//	if (!IsReplay()) { CDM_SetCharacterDataFlag(BOSS_ID_SETUJO); }	// 解説フラグON
	
	// ここでボスシーンを作成。（会話２）
	objTalkScene02 = ObjEnemyBossScene_Create();
	
	ObjEnemyBossScene_Add(objTalkScene02, 0, dir ~ "04a_Motion02.dnh");
	alternative(GetPlayerType())
	case(PLAYER_REIMU_A)  { ObjEnemyBossScene_Add(objTalkScene02, 0, dir ~ "04a_Talk02a.dnh"); }
	case(PLAYER_MARISA_A) { ObjEnemyBossScene_Add(objTalkScene02, 0, dir ~ "04a_Talk02b.dnh"); }
	case(PLAYER_SANAE_A)  { ObjEnemyBossScene_Add(objTalkScene02, 0, dir ~ "04a_Talk02c.dnh"); }
	ObjEnemyBossScene_LoadInThread(objTalkScene02);

	// 魔法陣リセット
	BossEffect_ResetMagicCircle();
	
	// ボスシーン開始
	ObjEnemyBossScene_Regist(objBossScene);

	//敵ボスシーンが終了するまで待機
	while(!Obj_IsDeleted(objBossScene))
	{
		yield;
	}
	
	// 会話シーン２開始
	ObjEnemyBossScene_Regist(objTalkScene02);
	// 会話シーン２が終了するまで待機
	while(!Obj_IsDeleted(objTalkScene02))
	{
		yield;
	}

	// 連続再生終了通知
	FinalizePlural();

	//スクリプト終了
	CloseScript(GetOwnScriptID());
}
