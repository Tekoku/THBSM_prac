// ÉLÉãÉJÉEÉìÉg
task DemonNumber()
{
	let before_kill = DEMON_KILLED;
	
	DemonNumber_single(GetStgFrameWidth/2, 48, DEMON_KILLED);
	
	while(before_kill < 72)
	{
		if (DEMON_KILLED > before_kill)
		{
			before_kill++;
			DemonNumber_single(GetStgFrameWidth/2, 48, before_kill);
			wait(3);
		}
		yield;
	}
	DEMON_KILLED++;
	
	task DemonNumber_single(x, y, num)
	{
		//écã@
		let offset_x = 0;
		if ((num+1) < 10) { offset_x = -15; }
		
		let obj = ObjPrim_Create(OBJ_PRIMITIVE_2D);
		ObjPrim_SetTexture(obj, imgEffectFumaNumber);
		ObjPrim_SetPrimitiveType(obj, PRIMITIVE_TRIANGLELIST);
		ObjPrim_SetVertexCount(obj, 2*6);
		Obj_SetRenderPriorityI(obj, 71);
		ObjRender_SetPosition(obj, x, y, 0);
		ascent(iObj in 0 .. 2)
		{
			SetNumber_Base(obj, iObj, iObj*30-32+offset_x, -64*0.85/2, 48*0.85, 64*0.85);
		}
		SetNumber(obj, 1, (num+1)%10);
		SetNumber(obj, 0, [trunc((num+1)/10), -1][(num+1)<10]);
		
		let t = 0;
		while(num == DEMON_KILLED || t < 15)
		{
			if (t < 15)
			{
				let tmp = sin((t+1)/15*90);
				ObjRender_SetAngleY(obj, (1-tmp)*90);
				ObjRender_SetX(obj, x+(1-tmp)*32);
			}
			t++;
			yield;
		}
		if (num >= 72)
		{
			ascent(t in 0 .. 60)
			{
				let tmp = (1-cos((t+1)/60*180))/2;
				ObjRender_SetY(obj, y+tmp*96);
				t++;
				yield;
			}
			wait(30);
			descent(t in 0 .. 30)
			{
				let tmp = sin((t+1)/30*90);
				ObjRender_SetAngleY(obj, (1-tmp)*90);
				yield;
			}
		}
		else
		{
			descent(t in 0 .. 15)
			{
				let tmp = sin((t+1)/15*90);
				ObjRender_SetAngleY(obj, (1-tmp)*90);
				ObjRender_SetX(obj, x-(1-tmp)*32);
				yield;
			}
		}
		Obj_Delete(obj);
	}

	//êîéöóp
	function SetNumber(obj, keta, num)
	{
		if (num < 0)
		{
			ascent(i in 0 .. 6)
			{
				ObjPrim_SetVertexUVT(obj, keta*6+i, 0, 0);
			}
		}
		else
		{
			let ix = num*48;
			ObjPrim_SetVertexUVT(obj, keta*6  , ix, 0);
			ObjPrim_SetVertexUVT(obj, keta*6+1, ix+48, 0);
			ObjPrim_SetVertexUVT(obj, keta*6+2, ix, 64);
			ObjPrim_SetVertexUVT(obj, keta*6+3, ix+48, 0);
			ObjPrim_SetVertexUVT(obj, keta*6+4, ix, 64);
			ObjPrim_SetVertexUVT(obj, keta*6+5, ix+48, 64);
		}
	}

	function SetNumber_Base(obj, keta, x, y, w, h)
	{
		ObjPrim_SetVertexPosition(obj, keta*6  , x, y, 0);
		ObjPrim_SetVertexPosition(obj, keta*6+1, x+w, y, 0);
		ObjPrim_SetVertexPosition(obj, keta*6+2, x, y+h, 0);
		ObjPrim_SetVertexPosition(obj, keta*6+3, x+w, y, 0);
		ObjPrim_SetVertexPosition(obj, keta*6+4, x, y+h, 0);
		ObjPrim_SetVertexPosition(obj, keta*6+5, x+w, y+h, 0);
	}
}

// íiäKÉ`ÉFÉìÉW
function PHASE_SHIFT()
{
	wait(30);
	CallSound(sndPower2);
	wait(45);
	DeleteShotAll_Delay(CenX, 64);
	wait(45);
}

// ÉtÅ[É}ÅEÉ~ÉVÉÉÉìÉhÉâÅiñ{ï“Åj
function PHASE_LAST()
{
	let DEL_R = 16;
	let DEL_CHANGE = false;
	
	SetEnemyVisible(objEnemy, true);

	TShot_book();
	wait(60);
	
	let fam_rotate = [0.4, 0.4, 0.5, 0.6][Difficult];
	let circle_wt = [480, 420, 270, 180][Difficult];
	ascent(i in 0 .. 3)
	{
		SetFamilier01(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), i*120, 1, fam_rotate, 128, i);
	}
	ascent(i in 0 .. 3)
	{
		SetFamilier01(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), i*120+60, -1, fam_rotate, 128, (i+2)%3);
	}
	
	let t = 0;
	wait(300);
	while(eAlive)
	{
		BossCharge(objEnemy);
		wait(120);
		if (!eAlive) { return; }
		TCircle();
		wait(circle_wt);
	}
	
	task TCircle()
	{
		let objEff = MishandraLineEffect(objEnemy, ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), MLINE_CIRCLE);
		let r = 0;
		
		DEL_CHANGE = true;
		ascent(t in 0 .. 60)
		{
			if (!eAlive) { break; }
			let tmp = 1-cos((t+1)/60*90);
			DEL_R = max(16, tmp*400);
			Obj_SetValue(objEff, "R", tmp*400);
			yield;
		}
		DEL_R = 16;
		DEL_CHANGE = false;
		Obj_Delete(objEff);
	}
	
	task TShot_book()
	{
		let graphics = [BGW_BILL_RED, BGW_BILL_ORANGE, BGW_BILL_YELLOW, BGW_BILL_GREEN, BGW_BILL_SKY, BGW_BILL_BLUE, BGW_BILL_PURPLE];
		let t = 0;
		
		let wt = [1.5, 1.5, 1.5, 1.5][Difficult];
		let wt_dec = [0.75, 0.85, 1, 1][Difficult];
		let speed = [2, 2, 2, 2][Difficult];
		let speed_acc = [2, 3, 4, 4][Difficult];
		
		let st = 0;
		while(eAlive)
		{
			let rt = 1-GetBossLifeRate(objEnemy);
			let shot_wt = wt - rt*wt_dec;
			let tmp_speed = speed + rt*speed_acc;
			let sr = 350;
			if (t < 240)
			{
				let tmp = sin((t+1)/240*90);
				sr *= tmp;
				shot_wt *= (0.25 + tmp*0.75);
			}
			
			let sa = -90 + rand(-142,142);
			let sx = ObjMove_GetX(objEnemy) + sr*cos(sa);
			let sy = ObjMove_GetY(objEnemy) + sr*sin(sa);
			BookShot(sx, sy, tmp_speed, sa+180, graphics[trunc(t/16)%7], 15, sr);
			st += shot_wt;
			while(st > 0) { st--; t++; yield; }
		}
	}
	
	task BookShot(x, y, speed, angle, graphic, delay, r)
	{
		let obj = CreateShotA1(x, y, speed, angle, graphic, delay);
		ObjShot_SetAutoDelete(obj, false);
		wait(delay);
		
		while(!Obj_IsDeleted(obj))
		{
			r -= speed;
			if (r <= DEL_R)
			{
				ObjMove_SetAcceleration(obj, -speed/10);
				descent(t in 0 .. 10)
				{
					let tmp = t/10;
					ObjRender_SetScaleX(obj, tmp);
					yield;
				}
				if (!Obj_IsDeleted(obj) && DEL_CHANGE)
				{
					if (CheckDispIN(obj, 0))
					{
						DigitalShot(ObjMove_GetX(obj), ObjMove_GetY(obj), rand(0,360));
						CallSound(sndBulletBreak);
					}
				}
				Obj_Delete(obj);
				break;
			}
			yield;
		}
	}
	
	task DigitalShot(x, y, angle)
	{
		let speed = [1.75, 1.75, 2, 3][Difficult];
		let base_angle = GetAngleToPlayer(objEnemy);

		let vs = 1;
		let vx = vs*cos(angle);
		let vy = vs*sin(angle);
		let flash = rand_int(5, 15);
		let num = rand_int(0, 1);
		
		let obj = ObjPrim_Create(OBJ_SPRITE_2D);
		Obj_SetRenderPriorityI(obj, 70);
		ObjRender_SetBlendType(obj, BLEND_ADD_ARGB);
		ObjPrim_SetTexture(obj, imgEffectDigital);
		ObjSprite2D_SetSourceRect(obj, 0+num*16, 0, 16+num*16, 32);
		ObjSprite2D_SetDestCenter(obj);
		ObjRender_SetColor(obj, 0, 255, 0);
		ObjRender_SetScaleXYZ(obj, 1.5, 1.5, 1);

		let t = 0;
		let alpha = 0;
		while(alpha < 255)
		{
			if (!eAlive) { break; }
			alpha += 5;
			ObjRender_SetAlpha(obj, alpha);
			ObjRender_SetPosition(obj, x, y, 0);
			Obj_SetVisible(obj, trunc(t/flash)%2==0);
			x += vx; y += vy;
			t++;
			yield;
		}
		descent(i in 0 .. 60)
		{
			alpha -= 1;
			let tmp = (i+1)/60;
			ObjRender_SetPosition(obj, x, y, 0);
			Obj_SetVisible(obj, trunc(t/flash)%2==0);
			x += vx*tmp; y += vy*tmp;
			t++;
			yield;
		}
		if (eAlive)
		{
			let ss = speed * rand(0.33, 1);
			let sa = base_angle + rand(-5,5);
			if (Difficult <= D_EASY && rand_int(0,1)) { sa += 180; }
			let graphic = [BGW_BILL_WHITE, BGW_KUNAI_WHITE, BGW_KNIFE_WHITE, BGW_STAR_S_WHITE, BGW_CROSS_WHITE][rand_int(0,4)];
			My_CreateShotA2(x, y, 0, sa, ss/120, ss, graphic, 30);
		}
		while(alpha > 0)
		{
			alpha -= 5;
			ObjRender_SetAlpha(obj, alpha);
			ObjRender_SetPosition(obj, x, y, 0);
			Obj_SetVisible(obj, trunc(t/flash)%2==0);
			t++;
			yield;
		}
		Obj_Delete(obj);
	}

	// ÉtÅ[É}ÉXÉSÉCÉnÉìÉh
	task SetFamilier01(iniX, iniY, iniAngle, iniMuki, iniValue, iniR, iniGraphic)
	{
		let eSize = ENEMY_M;
		let eColor = EFF_RED;
		let item_count = 0;
		let item_star = 0;
		let baseAngle = iniAngle;
		let baseAdd = iniValue;
		let baseR = iniR;
		
		let objFamilier = MakeEnemyFamilier(-256, -256, 99999, eSize);
		CheckLinkLife_Familier(objEnemy, objFamilier, 0.85);	// É{ÉXÇ∆ëÃóÕòAìÆ
		MishandraOption_SetDamageRate(objFamilier);
		SetDropItemCount(objFamilier, item_count, item_star);
		DrawMishandraHand(objFamilier, iniAngle, iniMuki);
		TAct();
		WaitForKilledFamilier(objFamilier, 38, 0);
		ZakoFinalize(objFamilier, eColor);
		
		task TAct()
		{
			TMove();
			wait(120);
			TShot();
		}
		
		task TMove()
		{
			let r = 0;
			let t = 0;
			while(CanShotBullet(objFamilier))
			{
				baseR = iniR + 48*sin(t/2)*iniMuki;
				if (t < 120)
				{
					let tmp = sin((t+1)/120*90);
					baseR *= tmp;
				}
				let ex = iniX + cos(baseAngle)*baseR;
				let ey = iniY + sin(baseAngle)*baseR;
				ObjMove_SetPosition(objFamilier, ex, ey);
				SetMishandraHandAngle(objFamilier, baseAngle+180);
				baseAngle += baseAdd;
				t++;
				yield;
			}
		}
		
		task TShot()
		{
			let speed = [1.25, 1.25, 1.25, 1.25][Difficult];
			let graphic = [BGW_STAR_M_BLUE, BGW_STAR_M_RED, BGW_STAR_M_PURPLE][iniGraphic%3];
			let wt = [4, 3, 3, 2][Difficult];
			let swt = 3;
			
			let muki = 1;
			
			let t = 0;
			while(CanShotBullet(objFamilier))
			{
				let ss = speed;
				if (trunc(t/swt)%2==1 && t%swt == 0) { ss *= 0.75; }
				let sa = baseAngle-165*muki;
				let tt = round((baseR-128)/128*45);
				S07StarShot(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
					ss, sa, graphic, 15, tt, muki, t%swt==0);
				if (t%2 == 0) { CallSound(sndShot2); }
				t++;
				wait(wt);
			}
		}
		
		task S07StarShot(x, y, speed, angle, graphic, delay, timer, muki, move_flg)
		{
			let obj = CreateShotA1(x, y, 0, angle, graphic, 0);
			ObjRender_SetBlendType(obj, BLEND_ADD_ARGB);
		//	Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI+1);
			
			let tmp_r = 0;
			while(tmp_r < baseR)
			{
				if (Obj_IsDeleted(obj)) { break; }
				let tmp = tmp_r/baseR;
				let sx = iniX + (baseR*cos(baseAngle))*(1-tmp) + (baseR*cos(baseAngle-120))*tmp;
				let sy = iniY + (baseR*sin(baseAngle))*(1-tmp) + (baseR*sin(baseAngle-120))*tmp;
				ObjMove_SetPosition(obj, sx, sy);
				tmp_r += 2.5;
				yield;
			}
			if (move_flg)
			{
				ObjMove_AddPatternA2(obj, 0, 2.5, baseAngle+210, (speed-2.5)/60, 0, speed);
				/*
				wait(timer+90);
				if (!Obj_IsDeleted(obj))
				{
					let obj2 = CreateShotA1(ObjMove_GetX(obj), ObjMove_GetY(obj), ObjMove_GetSpeed(obj), ObjMove_GetAngle(obj), graphic, 0);
					ObjMove_AddPatternA2(obj2, 0, NO_CHANGE, NO_CHANGE, (speed-2.5)/60, 0, speed);
					
					ObjShot_SetIntersectionEnable(obj, false);
					ascent(t in 0 .. 45)
					{
						let tmp = (t+1)/45;
						ObjRender_SetAlpha(obj, (1-tmp)*255);
						ObjRender_SetAlpha(obj2, tmp*255);
						yield;
					}
					Obj_Delete(obj);
				}
				*/
			}
			else
			{
				ObjMove_AddPatternA1(obj, 0, 2.5, baseAngle+210);
				ObjMove_AddPatternB2(obj, 1, NO_CHANGE, NO_CHANGE, 0, -2/30, 99, -2.5);
			}
		}
	}
}
