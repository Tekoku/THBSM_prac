// é◊
function PHASE01()
{
	let objP01Familier = SetDemons(CenX, 80, 1, 1);
	ObjEnemy_SetDamageRate(objP01Familier, 5, 0);
	
	let objSubFamilier = [];
	ascent(i in 2 .. 11+1)
	{
		objSubFamilier = objSubFamilier ~ [SetDemons(CenX, 80, i, 0)];
	}
	ascent(i in 12 .. 21+1)
	{
		objSubFamilier = objSubFamilier ~ [SetDemons(CenX, 80, i, 0)];
	}
	
	let kill_dec = DEMON_KILLED;
	let kill_count = DEMON_KILLED;

	// èIóπÇ‹Ç≈ë“ã@
	while(!Obj_IsDeleted(objP01Familier))
	{
		if (kill_count < DEMON_KILLED)
		{
			kill_count = DEMON_KILLED;
			let tmp = (DEMON_KILLED-kill_dec)/length(objSubFamilier);
			let rate = 5 + 50*tmp;
			// éGãõåÇîjêîÇ…âûÇ∂Çƒè_ÇÁÇ©Ç≠Ç»ÇÈ
			ObjEnemy_SetDamageRate(objP01Familier, rate, 0);
		}
		yield;
	}
	
	// éüÇÃíiäKÇ÷
	SPELL_PHASE++;
	
	// éGãõåÇîj
	ascent(i in 0 .. length(objSubFamilier))
	{
		if (!Obj_IsDeleted(objSubFamilier[i]))
		{
			EraseEnemy(objSubFamilier[i]);
		}
	}
}

// ì±
function PHASE02()
{
	let objP01Familier = SetDemons(CenX, 80, 22, 1);
	ObjEnemy_SetDamageRate(objP01Familier, 5, 0);
	
	let objSubFamilier = [];
	ascent(i in 23 .. 37+1)
	{
		objSubFamilier = objSubFamilier ~ [SetDemons(CenX, 80, i, 0)];
	}
	
	let kill_dec = DEMON_KILLED;
	let kill_count = DEMON_KILLED;

	// èIóπÇ‹Ç≈ë“ã@
	while(!Obj_IsDeleted(objP01Familier))
	{
		if (kill_count < DEMON_KILLED)
		{
			kill_count = DEMON_KILLED;
			let tmp = (DEMON_KILLED-kill_dec)/length(objSubFamilier);
			let rate = 5 + 50*tmp;
			// éGãõåÇîjêîÇ…âûÇ∂Çƒè_ÇÁÇ©Ç≠Ç»ÇÈ
			ObjEnemy_SetDamageRate(objP01Familier, rate, 0);
		}
		yield;
	}
	
	// éüÇÃíiäKÇ÷
	SPELL_PHASE++;
	
	// éGãõåÇîj
	ascent(i in 0 .. length(objSubFamilier))
	{
		if (!Obj_IsDeleted(objSubFamilier[i]))
		{
			EraseEnemy(objSubFamilier[i]);
		}
	}
}

// ìç
function PHASE03
{
	DEMON_TIMER = 60*90;	// Ç±ÇÃíiäKÇæÇØêßå¿éûä‘í∑Çﬂ
	
	let flgP3Finish = false;
	let objP3Familiers = [];
	let objSubFamilier = [];
	ascent(i in 38 .. 40+1)
	{
		objP3Familiers = objP3Familiers ~ [SetDemons(CenX, 80, i, 1)];
	}
	ascent(i in 0 .. length(objP3Familiers)) { ObjEnemy_SetDamageRate(objP3Familiers[i], 40, 0); }
	TFamilier();

	wait(60);
	SunShot(CenX, 80);
	CallSound(sndFlare);
	
	while(length(objP3Familiers) > 0)
	{
		// åÇîjéûèàóù
		ascent(i in 0 .. length(objP3Familiers))
		{
			if (Obj_IsDeleted(objP3Familiers[i]))
			{
				objP3Familiers = erase(objP3Familiers, i);
				
				let ct = length(objP3Familiers);
				if (ct > 0)
				{
					let add_a = [3, -1][ct<=1];
					let er = (ct-1)*48;
					let rate = [40, 20][ct<=1];
					ascent(j in 0 .. ct)
					{
						Obj_SetValue(objP3Familiers[j], "ENUM", (j-(ct-1)/2)/ct);
						Obj_SetValue(objP3Familiers[j], "EADD", add_a);
						Obj_SetValue(objP3Familiers[j], "ER", er);
						ObjEnemy_SetLife(objP3Familiers[j], 300);
						ObjEnemy_SetDamageRate(objP3Familiers[j], rate, 0);
					}
					CallSound(sndPower1);
				}
				break;
			}
		}
		yield;
	}
	flgP3Finish = true;
	
	// éüÇÃíiäKÇ÷
	SPELL_PHASE++;
	
	// éGãõåÇîj
	ascent(i in 0 .. length(objSubFamilier))
	{
		if (!Obj_IsDeleted(objSubFamilier[i]))
		{
			EraseEnemy(objSubFamilier[i]);
		}
	}
	yield;
	DEMON_KILLED = 72;

	// égÇ¢ñÇóéÇ∆Çµ
	task TFamilier()
	{
		wait(180);
		ascent(i in 41 .. 72+1)
		{
			if (length(objP3Familiers) <= 0) { break; }
			objSubFamilier = objSubFamilier ~ [SetDemons(rand(0+32, GetStgFrameWidth-32), 0, i, 0)];
			wait(150);
		}
	}
	
	// É_Å[ÉNëæózóéÇ∆Çµ
	task SunShot(x, y)
	{
		let objShot = DarkNuclearShot(x, y, [255, 0, 0], 320, 120);
		ObjShot_SetAutoDelete(objShot, false);
		
		let sy = -240;
		MoveTo(objShot, CenX, sy, 120);
		wait(120);
		
		TShot01();
		TShot02();
		TShot03();
		
		let speed = 0;
		while(sy < -64)
		{
			sy += speed;
			ObjMove_SetPosition(objShot, CenX, sy);
			speed = min(0.25, speed+0.01);
			yield;
		}
		
		// ëÊàÍíiäK
		task TShot01()
		{
			let wt = [210, 180, 120, 75][Difficult];
			
			while(!Obj_IsDeleted(objShot))
			{
				TShot01_sub();
				wait(wt);
			}
			
			task TShot01_sub()
			{
				let speed = [1, 1, 1.25, 1.5][Difficult];
				let wt = [10, 8, 8, 8][Difficult];
				let timer = 180;
				let graphic = BGW_BALL_S_RED;
				
				let wt_offset = rand_int(0, wt);
				ascent(t in 0 .. timer)
				{
					if (Obj_IsDeleted(objShot)) { break; }
					if ((t-wt_offset)%wt == 0)
					{
						let tmp = t/(timer-1);
						let sa = 90 + (tmp-0.5)*90;
						let sr = 300;
						let sx = ObjMove_GetX(objShot) + cos(sa)*sr;
						let sy = ObjMove_GetY(objShot) + sin(sa)*sr;
						CreateShotA2(sx, sy, -speed*2, sa, speed/15, speed, graphic, 15);
						CallSound(sndShot2);
					}
					yield;
				}
			}
		}

		// ëÊìÒíiäK
		task TShot02()
		{
			let wt = [180, 150, 120, 90][Difficult];
			
			while (length(objP3Familiers) >= 3) { yield; }
			
			while(!Obj_IsDeleted(objShot))
			{
				TShot02_sub();
				wait(wt);
			}
			
			task TShot02_sub()
			{
				let speed = [1.25, 1.25, 1.5, 1.75][Difficult];
				let way = [12, 16, 16, 16][Difficult];
				let graphic = ADD_BGW_LIGHT_L_RED;

				let base_angle = 90 + rand(-1,1)*90/way;
				ascent(i in 0 .. way)
				{
					let tmp = i/(way-1);
					let sa = base_angle + (tmp-0.5)*90;
					let sr = 300;
					let sx = ObjMove_GetX(objShot) + cos(sa)*sr;
					let sy = -64 + sin(sa)*sr-210;
					My_CreateShotA2(sx, sy, 0, sa, speed/15, speed, graphic, 15);
				}
			}
		}

		// ëÊéOíiäK
		task TShot03()
		{
			let wt = [35, 25, 18, 12][Difficult];
			
			while (length(objP3Familiers) >= 2) { yield; }
			
			while(!Obj_IsDeleted(objShot))
			{
				TShot03_sub();
				wait(wt);
			}
			
			task TShot03_sub()
			{
				let speed = [1.5, 1.5, 1.75, 2][Difficult];
				let way = [6, 6, 6, 6][Difficult];
				let graphic = BGW_FIRE_RED;

				let base_angle = 90 + rand(-1,1)*90/way;
				ascent(i in 0 .. way)
				{
					let tmp = i/(way-1);
					let sa = base_angle + (tmp-0.5)*90;
					let sr = 300;
					let sx = ObjMove_GetX(objShot) + cos(sa)*sr;
					let sy = ObjMove_GetY(objShot) + sin(sa)*sr-120;
					My_CreateShotA2(sx, sy, 0, sa, speed/15, speed, graphic, 15);
				}
			}
		}

		// É_Å[ÉNäjíe
		function DarkNuclearShot(x, y, color, size, delay)
		{
			let obj = CreateShotA1(x, y, 0, 0, BGW_BALL_S_RED, 0);
			SetShotDisabled(obj);
			Obj_SetVisible(obj, false);
			Obj_SetValue(obj, "COLOR", color);
			Obj_SetValue(obj, "SIZE", size);
			
			_DarkNuclearShot(obj, delay);
			return(obj);
		}

		task _DarkNuclearShot(parent, delay)
		{
			let obj = [ObjPrim_Create(OBJ_SPRITE_2D), ObjPrim_Create(OBJ_SPRITE_2D)];
			ascent(i in 0 .. 2)
			{
				Obj_SetRenderPriorityI(obj[i], GetShotRenderPriorityI());
				ObjPrim_SetTexture(obj[i], imgEffectNuclear);
				ObjSprite2D_SetSourceRect(obj[i], 0, 0+i*256, 256, 256+i*256);
				ObjSprite2D_SetDestCenter(obj[i]);
				ObjRender_SetBlendType(obj[i], BLEND_ADD_ARGB);
			}
		//	ObjRender_SetBlendType(obj[0], BLEND_SUBTRACT);
		//	ObjRender_SetBlendType(obj[1], BLEND_SUBTRACT);
			Obj_SetRenderPriorityI(obj[1], GetShotRenderPriorityI()-1);
			
			let t = 0;
			let sz = 0;
			while(!Obj_IsDeleted(parent))
			{
				sz = Obj_GetValueD(parent, "SIZE", 0);
				if (t < delay)
				{
					sz *= sin((t+1)/delay*90);
				}
				
				let sc = (sz+8)/60;
				let col = Obj_GetValueD(parent, "COLOR", [255,0,0]);
				ObjRender_SetColor(obj[1], col[0], col[1], col[2]);
				ObjRender_SetColor(obj[0], 255-col[0]/2, 255-col[1]/2, 255-col[2]/2);
				
				ObjShot_SetIntersectionCircleA1(parent, sz);
				ascent(i in 0 .. 2)
				{
					ObjRender_SetPosition(obj[i], ObjMove_GetX(parent), ObjMove_GetY(parent), 0);
					ObjRender_SetScaleXYZ(obj[i], sc, sc, 1);
				}
				ObjRender_SetAngleZ(obj[0], -t/3);
				ObjRender_SetAngleZ(obj[1], t/3);
				t++;
				yield;
			}
			descent(i in 0 .. 30)
			{
				let sc = ((sz+8)*sin((i+1)/30*90))/60;
				ascent(i in 0 .. 2)
				{
					ObjRender_SetScaleXYZ(obj[i], sc, sc, 1);
				}
				ObjRender_SetAngleZ(obj[0], -t/3);
				ObjRender_SetAngleZ(obj[1], t/3);
				t++;
				yield;
			}
			ascent(i in 0 .. 2)
			{
				Obj_Delete(obj[i]);
			}
		}
	}
}