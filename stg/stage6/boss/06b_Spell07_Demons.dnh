let DEMON_TIMER = 60*60;
let DEMON_KILLED = 0;
let SPELL_PHASE = 0;

// 72柱汎用処理
function SetDemons(iniX, iniY, iniValue, iniDrawType)
{
	let eSize = ENEMY_M;
	let objFamilier = MakeEnemyFamilier(iniX, iniY, 300, eSize);
	_SetDemons(objFamilier, iniX, iniY, iniValue, iniDrawType);
	return(objFamilier);
}
task _SetDemons(objFamilier, iniX, iniY, iniValue, iniDrawType)
{
	let eColor = EFF_RED;
	let dmgRange = [54, 28][iniDrawType==0];

	ObjEnemy_SetDamageRate(objFamilier, 100, 0);
	SetDropItemCount(objFamilier, 0, 0);
	TDraw(objFamilier, iniValue, iniDrawType);
	TAct();
	WaitForKilledFamilier(objFamilier, dmgRange, 0);
	Obj_Delete(objFamilier);
	CallSound(sndShot6);
	DEMON_KILLED++;

	task TAct()
	{
		alternative(iniValue)
		case( 1) { DEMON01(objFamilier, iniX, iniY); }
		case( 2) { DEMON02(objFamilier, iniX, iniY); }
		case( 3) { DEMON03(objFamilier, iniX, iniY); }
		case( 4) { DEMON04(objFamilier, iniX, iniY); }
		case( 5) { DEMON05(objFamilier, iniX, iniY); }
		case( 6) { DEMON06(objFamilier, iniX, iniY); }
		case( 7) { DEMON07(objFamilier, iniX, iniY); }
		case( 8) { DEMON08(objFamilier, iniX, iniY); }
		case( 9) { DEMON09(objFamilier, iniX, iniY); }
		case(10) { DEMON10(objFamilier, iniX, iniY); }
		case(11) { DEMON11(objFamilier, iniX, iniY); }
		case(12) { DEMON12(objFamilier, iniX, iniY); }
		case(13) { DEMON13(objFamilier, iniX, iniY); }
		case(14) { DEMON14(objFamilier, iniX, iniY); }
		case(15) { DEMON15(objFamilier, iniX, iniY); }
		case(16) { DEMON16(objFamilier, iniX, iniY); }
		case(17) { DEMON17(objFamilier, iniX, iniY); }
		case(18) { DEMON18(objFamilier, iniX, iniY); }
		case(19) { DEMON19(objFamilier, iniX, iniY); }
		case(20) { DEMON20(objFamilier, iniX, iniY); }
		case(21) { DEMON21(objFamilier, iniX, iniY); }
		case(22) { DEMON22(objFamilier, iniX, iniY); }
		case(23) { DEMON23(objFamilier, iniX, iniY); }
		case(24) { DEMON24(objFamilier, iniX, iniY); }
		case(25) { DEMON25(objFamilier, iniX, iniY); }
		case(26) { DEMON26(objFamilier, iniX, iniY); }
		case(27) { DEMON27(objFamilier, iniX, iniY); }
		case(28) { DEMON28(objFamilier, iniX, iniY); }
		case(29) { DEMON29(objFamilier, iniX, iniY); }
		case(30) { DEMON30(objFamilier, iniX, iniY); }
		case(31) { DEMON31(objFamilier, iniX, iniY); }
		case(32) { DEMON32(objFamilier, iniX, iniY); }
		case(33) { DEMON33(objFamilier, iniX, iniY); }
		case(34) { DEMON34(objFamilier, iniX, iniY); }
		case(35) { DEMON35(objFamilier, iniX, iniY); }
		case(36) { DEMON36(objFamilier, iniX, iniY); }
		case(37) { DEMON37(objFamilier, iniX, iniY); }
		case(38) { DEMON38(objFamilier, iniX, iniY); }
		case(39) { DEMON39(objFamilier, iniX, iniY); }
		case(40) { DEMON40(objFamilier, iniX, iniY); }
		case(41) { DEMON41(objFamilier, iniX, iniY); }
		case(42) { DEMON42(objFamilier, iniX, iniY); }
		case(43) { DEMON43(objFamilier, iniX, iniY); }
		case(44) { DEMON44(objFamilier, iniX, iniY); }
		case(45) { DEMON45(objFamilier, iniX, iniY); }
		case(46) { DEMON46(objFamilier, iniX, iniY); }
		case(47) { DEMON47(objFamilier, iniX, iniY); }
		case(48) { DEMON48(objFamilier, iniX, iniY); }
		case(49) { DEMON49(objFamilier, iniX, iniY); }
		case(50) { DEMON50(objFamilier, iniX, iniY); }
		case(51) { DEMON51(objFamilier, iniX, iniY); }
		case(52) { DEMON52(objFamilier, iniX, iniY); }
		case(53) { DEMON53(objFamilier, iniX, iniY); }
		case(54) { DEMON54(objFamilier, iniX, iniY); }
		case(55) { DEMON55(objFamilier, iniX, iniY); }
		case(56) { DEMON56(objFamilier, iniX, iniY); }
		case(57) { DEMON57(objFamilier, iniX, iniY); }
		case(58) { DEMON58(objFamilier, iniX, iniY); }
		case(59) { DEMON59(objFamilier, iniX, iniY); }
		case(60) { DEMON60(objFamilier, iniX, iniY); }
		case(61) { DEMON61(objFamilier, iniX, iniY); }
		case(62) { DEMON62(objFamilier, iniX, iniY); }
		case(63) { DEMON63(objFamilier, iniX, iniY); }
		case(64) { DEMON64(objFamilier, iniX, iniY); }
		case(65) { DEMON65(objFamilier, iniX, iniY); }
		case(66) { DEMON66(objFamilier, iniX, iniY); }
		case(67) { DEMON67(objFamilier, iniX, iniY); }
		case(68) { DEMON68(objFamilier, iniX, iniY); }
		case(69) { DEMON69(objFamilier, iniX, iniY); }
		case(70) { DEMON70(objFamilier, iniX, iniY); }
		case(71) { DEMON71(objFamilier, iniX, iniY); }
		case(72) { DEMON72(objFamilier, iniX, iniY); }
		wait(DEMON_TIMER+120);
		EraseEnemy(objFamilier);
	}
	
	// 描画タスク
	task TDraw(objFamilier, demonNum, drawType)
	{
		let scale = 1.25;
		if (!drawType) { scale = 0.8; }
		
		let ix = (demonNum%8)*64;
		let iy = trunc(demonNum/8)*64;
		let objImg = [ObjPrim_Create(OBJ_SPRITE_2D), ObjPrim_Create(OBJ_SPRITE_2D)];
		ascent(i in 0 .. 2)
		{
			Obj_SetRenderPriorityI(objImg[i], priorityZako);
			ObjPrim_SetTexture(objImg[i], imgEffectDemons);
			ObjSprite2D_SetSourceRect(objImg[i], ix, iy, ix+64, iy+64);
			ObjSprite2D_SetDestCenter(objImg[i]);
		}
		Obj_SetRenderPriorityI(objImg[1], 69);
		ObjRender_SetBlendType(objImg[1], BLEND_ADD_ARGB);
		
		let tmp_alpha = 0;
		let tmp_scale = 0;
		let tmp_angle = 0;
		let t = demonNum;
		ascent(i in 0 .. 45)
		{
			if (Obj_IsDeleted(objFamilier)) { break; }
			let tmp = sin((i+1)/45*90);
			let tmp_st = sin(t*5);
			tmp_alpha = tmp*192;
			tmp_scale = tmp*scale;
			tmp_angle = (1-tmp)*360;
			ascent(j in 0 .. 2)
			{
				ObjRender_SetAngleZ(objImg[j], tmp_angle);
				ObjRender_SetPosition(objImg[j], ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier), 0);
			}
			ObjRender_SetScaleXYZ(objImg[0], tmp_scale, tmp_scale, 1);
			ObjRender_SetScaleXYZ(objImg[1], tmp_scale*1.33, tmp_scale*1.33, 1);
			ObjRender_SetAlpha(objImg[0], tmp_alpha);
			ObjRender_SetAlpha(objImg[1], tmp_alpha*(0.5+tmp_st/4));
			t++;
			yield;
		}
		while(!Obj_IsDeleted(objFamilier))
		{
			let tmp_st = sin(t*5);
			ascent(j in 0 .. 2)
			{
				ObjRender_SetPosition(objImg[j], ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier), 0);
			}
			ObjRender_SetAlpha(objImg[1], tmp_alpha*(0.5+tmp_st/4));
			t++;
			yield;
		}
		descent(i in 0 .. 45)
		{
			let tmp = sin((i+1)/45*90);
			ObjRender_SetAlpha(objImg[0], tmp_alpha*tmp);
			ObjRender_SetAlpha(objImg[1], tmp_alpha*tmp);
			t++;
			yield;
		}
		ascent(j in 0 .. 2) { Obj_Delete(objImg[j]); }
	}
}
// 開幕えへくと
function DemonEnterEffect(objFamilier, eff_color)
{
	EffectConcentrationLine(objFamilier, eff_color, 120, 8);
	CallSound(sndPower1);
	wait(90);
}

// バエル
task DEMON01(objFamilier, iniX, iniY)
{
	FamilierEffect_LifeCircle(objFamilier, 72);	//ライフゲージ
	EffectConcentrationLine(objFamilier, EFF_WHITE, 120, 8);
	wait(90);
	
	let add_a1 = [12.5, 9, 7, 5.5][Difficult];
	let add_a2 = [-16, -14, -12, -9][Difficult];
	
	TShot_sub(DEMON_TIMER, 1, 9);
	TShot_sub(DEMON_TIMER, 0.75, -14);
	
	task TShot_sub(timer, speed_rate, add_a)
	{
		let way = [5, 7, 7, 7][Difficult];
		let wt = [21, 18, 12, 8][Difficult];

		let speed = [1, 1.25, 1.5, 2][Difficult];
		let base_angle = rand(0, 360);
		let graphic = BGW_BALL_M_WHITE;
		let graphic2 = BGW_LIGHT_L_WHITE;
		
		speed *= speed_rate;
		
		ascent(t in 0 .. timer)
		{
			if (!CanShotBullet(objFamilier)) { break; }
			if (t%wt == 0)
			{
				ascent(i in 0 .. way)
				{
					let sa = base_angle + i*360/way;
					let sx = ObjMove_GetX(objFamilier) - 64*cos(sa);
					let sy = ObjMove_GetY(objFamilier) - 64*sin(sa);
					D01Shot(sx, sy, speed, sa, graphic, graphic2, 15);
				}
				CallSound(sndShot2);
				base_angle += add_a;
			}
			yield;
		}
	}
	
	// ダーク☆ショット
	task D01Shot(x, y, speed, angle, graphic, graphic2, delay)
	{
		let scale = 1.15;
		let scale2 = 1.2;
		let obj = [CreateShotA1(x, y, speed, angle, graphic2, 0), CreateShotA1(x, y, speed, angle, graphic, 0)];
		ObjRender_SetBlendType(obj[0], BLEND_ADD_ARGB);
		Obj_SetRenderPriorityI(obj[0], GetShotRenderPriorityI-2);
		ObjRender_SetScaleXYZ(obj[0], scale, scale, 1);
		ObjRender_SetBlendType(obj[1], BLEND_SUBTRACT);
		Obj_SetRenderPriorityI(obj[1], GetShotRenderPriorityI-1);
		ObjShot_SetItemChange(obj[1], false);

		ObjShot_SetIntersectionEnable(obj[0], false);
		ObjShot_SetIntersectionEnable(obj[1], false);
		ascent(i in 0 .. delay)
		{
			let tmp_s = 1;
			let tmp_a = (i+1)/delay*255;
			ObjRender_SetScaleXYZ(obj[0], tmp_s*scale, tmp_s*scale, 1);
			ObjRender_SetScaleXYZ(obj[1], tmp_s*scale2, tmp_s*scale2, 1);
			ObjRender_SetAlpha(obj[0], tmp_a);
			ObjRender_SetAlpha(obj[1], tmp_a);
			yield;
		}
		if (!Obj_IsDeleted(obj[0]))
		{
			ObjShot_SetIntersectionEnable(obj[0], true);
			ObjShot_SetIntersectionEnable(obj[1], true);
			ObjRender_SetScaleXYZ(obj[0], scale, scale, 1);
			ObjRender_SetScaleXYZ(obj[1], scale2, scale2, 1);
			ObjRender_SetAlpha(obj[0], 255);
			ObjRender_SetAlpha(obj[1], 255);
			
			while(!Obj_IsDeleted(obj[0]))
			{
				ObjShot_SetIntersectionCircleA1(obj[0], 8);
				ObjShot_SetIntersectionCircleA1(obj[1], 8);
				yield;
			}
		}
	}
}

// 汎用モーションその１
task TMove_Phase01(objFamilier, iniX, iniY, iniAngle, iniR, iniMuki)
{
	let t = 0;
	let ea = 0;
	let add_angle = 0.25*iniMuki;
	while(!Obj_IsDeleted(objFamilier))
	{
		let er = iniR;
		if (t < 180)
		{
			let tmp_before = sin(t/180*90);
			let tmp = sin((t+1)/180*90);
			er *= tmp;
			ea += (tmp-tmp_before)*iniAngle*iniMuki;
		}
		let ex = iniX + er*cos(ea);
		let ey = iniY + er*sin(ea)*0.6;
		ObjMove_SetPosition(objFamilier, ex, ey);
		Obj_SetValue(objFamilier, "SHOT_ANGLE", ea-90*iniMuki);
		ea += add_angle;
		t++;
		yield;
	}
}

task TShot_Phase01(objFamilier, graphic)
{
	TShot_Phase01B(objFamilier, graphic);
	wait(120);
	
	let speed = [1, 1, 1, 1][Difficult];
	let wt = 15;
	while(CanShotBullet(objFamilier))
	{
		let sa = -90 + rand(-5,5);
		let ss = speed * rand(0.9, 1);
		let obj = CreateShotA1(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
			ss, sa, graphic, 0);
		My_RaiseShotEffectD_AA(obj, 15);
		wait(wt);
	}
}
task TShot_Phase01B(objFamilier, graphic)
{
	let speed = [1, 1, 1.15, 1.25][Difficult];
	let way = [24, 24, 24, 24][Difficult];
	let way_space = [0.33, 0.275, 0.25, 0.25][Difficult];
	
	let sx = ObjMove_GetX(objFamilier);
	let sy = ObjMove_GetY(objFamilier);
	let tmp_phase = SPELL_PHASE;
	while(CanShotBullet(objFamilier))
	{
		sx = ObjMove_GetX(objFamilier);
		sy = ObjMove_GetY(objFamilier);
		yield;
	}
	if (tmp_phase == SPELL_PHASE)
	{
		let sa = atan2(GetPlayerY-sy, GetPlayerX-sx);
		TriangleShot01B(sx, sy, speed, sa, graphic, 15, way, way_space);
		TriangleShot01B(sx, sy, speed, sa+180, graphic, 15, way, way_space);
	}

	task TriangleShot01B(x, y, speed, angle, graphic, delay, way, way_space)
	{
		let bposx = [1, -0.5, -0.5];
		let bposy = [0, 0.866, -0.866];
		
		let bx = [];
		let by = [];
		ascent(k in 0 .. 3)
		{
			let pos = Rotate2D_XY(bposx[k]*speed, bposy[k]*speed, angle);
			bx = bx ~ [pos[0]];
			by = by ~ [pos[1]];
		}
		
		ascent(i in 0 .. 3)
		{
			ascent(j in 0 .. way)
			{
				let tmp = j/way;
				if (absolute(tmp-0.5) > way_space)
				{
					let vx = bx[i]*(1-tmp) + bx[(i+1)%3]*tmp;
					let vy = by[i]*(1-tmp) + by[(i+1)%3]*tmp;
					let vs = ((vx^2+vy^2)^0.5);
					let va = atan2(vy, vx);
					let os = CreateShotA1(x, y, vs, va, graphic, 0);
					My_RaiseShotEffectD_AA(os, delay);
				}
			}
		}
	}
}

// アガレス
task DEMON02(objFamilier, iniX, iniY)
{
	ObjEnemy_SetDamageRate(objFamilier, 100, 0);
	TDemonRate(objFamilier);
	TMove_Phase01(objFamilier, iniX, iniY, 0/10*360, 256, 1);
	TShot_Phase01(objFamilier, ADD_BGW_BALL_M_YELLOW);
}


