// 汎用ショットその１　滝
task DEMONSHOT_FALL(objFamilier, graphics)
{
	let wt = 240;
	let count = 3;
	
	let t = 0;
	while(t < DEMON_TIMER-60-15*count)
	{
		ascent(i in 0 .. count)
		{
			if (!CanShotBullet(objFamilier)) { break; }
			TShot_sub(45, 1-i*0.1);
			wait(15);
		}
		t += wt;
		wait(wt-10*count);
	}
	
	task TShot_sub(timer, speed_rate)
	{
		let speed = 1.5;
		let base_angle = 90;
		
		
		ascent(t in 0 .. timer)
		{
			if (!CanShotBullet(objFamilier)) { break; }
			let tmp = (t+1)/timer;
			let muki = 1;
			loop(2)
			{
				let sx = ObjMove_GetX(objFamilier) + tmp*480*muki;
				if (sx > 0 && sx < GetStgFrameWidth)
				{
					let sy = ObjMove_GetY(objFamilier) + rand(-16,16);
					let sa = base_angle + rand(-15, 15);
					let sg = graphics[trunc(rand(0,length(graphics)))];
					let ss = speed * speed_rate * rand(0.5, 1);
					let obj = CreateShotA2(sx, sy, -ss, sa, ss/30, ss, sg, 0);
					My_RaiseShotEffectD_AA(obj, 30);
					CallSound(sndShot2);
				}
				muki = -muki;
			}
			yield;
		}
	}
}


task TDemonRate(objFamilier)
{
	let rs = ObjEnemy_GetInfo(objFamilier, INFO_DAMAGE_RATE_SHOT);
	let rb = ObjEnemy_GetInfo(objFamilier, INFO_DAMAGE_RATE_SPELL);
	ObjEnemy_SetDamageRate(objFamilier, rs*0, rb*0);
	wait(60);
	ascent(t in 0 .. 300)
	{
		let tmp = (t+1)/300;
		ObjEnemy_SetDamageRate(objFamilier, rs*tmp, rb*tmp);
		yield;
	}
}