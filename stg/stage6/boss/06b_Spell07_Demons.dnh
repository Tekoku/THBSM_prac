// イポス
task DEMON22(objFamilier, iniX, iniY)
{
	FamilierEffect_LifeCircle(objFamilier, 72);	//ライフゲージ
	TLaser();
	DemonEnterEffect(objFamilier, EFF_RED);
	
	TShot(DEMON_TIMER);

	// 本体から
	task TShot(timer)
	{
		let speed = [1.5, 1.5, 1.75, 2][Difficult];
		let way = [8, 12, 12, 16][Difficult];
		let count = [4, 4, 5, 5][Difficult];
		let count2 = [4, 5, 5, 6][Difficult];
		let wt = [360, 270, 270, 240][Difficult];
		let graphic = BGW_BUTTERFLY_WHITE;
		
		let st = 0;
		let muki = rand_dir();
		wait(30);
		ascent(t in 0 .. timer)
		{
			if (!CanShotBullet(objFamilier)) { break; }
			if (t%wt == 0)
			{
				TShot_sub(muki, st%3==0);
				CallSound(sndShot7);
				muki = -muki;
				st++;
			}
			yield;
		}
		
		task TShot_sub(muki, to_jiki)
		{
			let base_angle = rand(0, 360);
			// ３回に１度自機狙い
			if (to_jiki) { base_angle = GetAngleToPlayer(objFamilier)+15*muki; }
			
			loop(count2)
			{
				if (!CanShotBullet(objFamilier)) { break; }
				let sa = base_angle;
				BloomCircle(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
					speed, sa, graphic, 15, way, count);
				base_angle += 2*muki;
				CallSound(sndShot2);
				wait(30);
			}
		}
	}
	
	task BloomCircle(x, y, speed, angle, graphic, delay, way, count)
	{
		ascent(i in 0 .. way)
		{
			let sa = angle + i*360/way;
			ascent(j in 0 .. count)
			{
				let ss = speed * (1+j*0.15);
				BloomShot(x, y, ss, sa, graphic, delay, 1);
				BloomShot(x, y, ss, sa, graphic, delay, -1);
			}
		}
	}
	task BloomShot(x, y, speed, angle, graphic, delay, muki)
	{
		let obj = CreateShotA1(x, y, 2, angle, graphic, delay);
		ObjMove_AddPatternA2(obj, 0, NO_CHANGE, NO_CHANGE, -2/120, 1*muki, speed/4);
		ObjMove_AddPatternA2(obj, 90, NO_CHANGE, NO_CHANGE, speed/30, 0, speed);
	}
	
	// ツインブレス
	task TLaser()
	{
		wait(30);
		DarkLaser(objFamilier, ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
			16, 90+60, 64, 60, [BGW_FIRE_SKY, BGW_FIRE_YELLOW]);
		DarkLaser(objFamilier, ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
			16, 90-60, 64, 60, [BGW_FIRE_YELLOW, BGW_FIRE_SKY]);
	}

	// ぶっといレーザー（闇）
	task DarkLaser(objBase, x, y, speed, angle, l_wid, delay, graphics)
	{
		LaserDelayEffect02(objEnemy, x, y, angle, BGW_BEAM_PURPLE, delay);
		wait(delay+30);
		if (!eAlive) { return; }
		CallSound(sndLaser1);
		ascent(i in 0 .. 8)
		{
			if (!eAlive) { return; }
			let tmp = (i+1)/10;
			let ss = speed*(1-tmp*0.75);
			let ll = 600;
			let lw = l_wid;
			
			let muki = 1;
			loop(2)
			{
				let sa = angle + (i+0.5)*muki*3;
				DarkLaser_single(objBase, x, y, sa, ll, lw, graphics);
				muki = -muki;
			}
			wait(12);
		}
	}
	task DarkLaser_single(objBase, x, y, angle, l_len, l_wid, graphic)
	{
		// 予告線
		let obj = [CreateStraightLaserA1(x, y, angle, l_len, l_wid, 60*999, graphic[0], 0), CreateStraightLaserA1(x, y, angle, l_len, l_wid*2, 60*999, graphic[1], 0)];
		ObjLaser_SetInvalidLength(obj[0], 0, 0);
		ObjLaser_SetIntersectionWidth(obj[0], l_wid/4);
		Obj_SetRenderPriorityI(obj[0], GetShotRenderPriorityI+1);
		ObjRender_SetBlendType(obj[0], BLEND_SUBTRACT);
		ObjShot_SetIntersectionEnable(obj[1], false);
		ObjStLaser_SetSource(obj[0], false);
		ObjStLaser_SetSource(obj[1], false);
		
		while(!Obj_IsDeleted(obj[0]))
		{
			if (Obj_IsDeleted(objBase))
			{
				ascent(i in 0 .. 2)
				{
					ObjShot_FadeDelete(obj[i]);
				}
				break;
			}
			yield;
		}
	}
}

// 汎用モーションその２
task TMove_Phase02(objFamilier, iniX, iniY, iniAngle, iniR, iniMuki)
{
	let tmpY = iniY;
	let t = 0;
	let ea = iniAngle;
	let add_angle = 0.425*iniMuki;
	while(!Obj_IsDeleted(objFamilier))
	{
		let er = iniR;
		if (t < 180)
		{
			let tmp_before = sin(t/180*90);
			let tmp = sin((t+1)/180*90);
			let tmp2 = (1-cos((t+1)/180*180))/2;
			er *= tmp;
			ea += (1-tmp)*3*iniMuki;
			tmpY = iniY + 220*tmp2;
		}
		let ex = iniX + er*cos(ea);
		let ey = tmpY + er*sin(ea)*0.4;
		ObjMove_SetPosition(objFamilier, ex, ey);
		Obj_SetValue(objFamilier, "SHOT_ANGLE", ea-90*iniMuki);
		ea += add_angle;
		t++;
		yield;
	}
}

task TShot_Phase02(objFamilier, graphic)
{
	TShot_Phase02B(objFamilier, graphic);
	wait(300);
	
	let speed =  [0.75, 0.75, 0.75, 0.75][Difficult];
	let wt =  [20, 14, 11, 11][Difficult];
	let graphic2 = (graphic-1)%8 + BGW_FUGU_RED;
	
	while(CanShotBullet(objFamilier))
	{
		let angle = Obj_GetValueD(objFamilier, "SHOT_ANGLE", 0);
		let sa = sin(angle)*45-90 + rand(-10,10);
		let ss = speed;
		if (cos(angle) < 0)
		{
			let obj = CreateShotA1(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
				ss, sa, graphic2, 0);
			My_RaiseShotEffectD_AA(obj, 15);
		}
		else
		{
			let obj = CreateShotA1(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
				ss, sa, graphic, 0);
			My_RaiseShotEffectD_AA(obj, 15);
		}
		CallSound(sndShot2);
		wait(wt);
	}
}
task TShot_Phase02B(objFamilier, graphic)
{
	let speed = [1, 1, 1.15, 1.25][Difficult];
	let way = [24, 24, 24, 24][Difficult];
	let way_space = [0.33, 0.275, 0.25, 0.25][Difficult];
	
	let sx = ObjMove_GetX(objFamilier);
	let sy = ObjMove_GetY(objFamilier);
	let tmp_phase = SPELL_PHASE;
	while(CanShotBullet(objFamilier))
	{
		sx = ObjMove_GetX(objFamilier);
		sy = ObjMove_GetY(objFamilier);
		yield;
	}
	if (tmp_phase == SPELL_PHASE)
	{
		let sa = atan2(GetPlayerY-sy, GetPlayerX-sx);
		TriangleShot01B(sx, sy, speed, sa, graphic, 15, way, way_space);
		TriangleShot01B(sx, sy, speed, sa+180, graphic, 15, way, way_space);
	}

	task TriangleShot01B(x, y, speed, angle, graphic, delay, way, way_space)
	{
		let bposx = [1, -0.5, -0.5];
		let bposy = [0, 0.866, -0.866];
		
		let bx = [];
		let by = [];
		ascent(k in 0 .. 3)
		{
			let pos = Rotate2D_XY(bposx[k]*speed, bposy[k]*speed, angle);
			bx = bx ~ [pos[0]];
			by = by ~ [pos[1]];
		}
		
		ascent(i in 0 .. 3)
		{
			ascent(j in 0 .. way)
			{
				let tmp = j/way;
				if (absolute(tmp-0.5) > way_space)
				{
					let vx = bx[i]*(1-tmp) + bx[(i+1)%3]*tmp;
					let vy = by[i]*(1-tmp) + by[(i+1)%3]*tmp;
					let vs = ((vx^2+vy^2)^0.5);
					let va = atan2(vy, vx);
					let os = CreateShotA1(x, y, vs, va, graphic, 0);
					My_RaiseShotEffectD_AA(os, delay);
				}
			}
		}
	}
}


