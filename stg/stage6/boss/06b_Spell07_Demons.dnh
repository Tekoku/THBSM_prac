// 汎用モーションその３（ボス用）
task TMove_Phase03A(objFamilier, iniX, iniY)
{
	let tmpY = iniY;
	let t = 0;
	
	let er = 0;
	let angle = 0;
	let offset_angle = Obj_GetValueD(objFamilier, "ENUM", 0) * 360;
	let add_angle = 1;

	while(!Obj_IsDeleted(objFamilier))
	{
		let ea = angle + offset_angle;
		er = er*0.975 + Obj_GetValueD(objFamilier, "ER", 64)*0.025;
		let ex = iniX + er*cos(ea);
		let ey = tmpY + er*sin(ea);
		ObjMove_SetPosition(objFamilier, ex, ey);
		
		angle += Obj_GetValueD(objFamilier, "EADD", 0);
		offset_angle = offset_angle*0.98 + Obj_GetValueD(objFamilier, "ENUM", 0)*360*0.02;
		t++;
		yield;
	}
}
// 汎用モーションその３（その他用）
task TMove_Phase03B(objFamilier, iniX, iniY)
{
	ObjMove_AddPatternA2(objFamilier, 0, 0, 90, 1/120, 0, 1);

	while(!Obj_IsDeleted(objFamilier))
	{
		if (ObjMove_GetY(objFamilier) > GetStgFrameHeight)
		{
			ObjEnemy_AddLife(objFamilier, -9999);
			break;
		}
		yield;
	}
}
task TShot_Phase03(objFamilier, graphic)
{
	TDemonRate(objFamilier);

	TShot_Phase03B(objFamilier, graphic);
	wait(120);
	
	let speed = 0.75;
	let wt = 11;
	
	while(CanShotBullet(objFamilier))
	{
		let angle = Obj_GetValueD(objFamilier, "SHOT_ANGLE", 0);
		let sa = -90 + rand(-10,10);
		let ss = speed;
		let obj = CreateShotA1(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
			ss, sa, graphic, 0);
		My_RaiseShotEffectD_AA(obj, 15);
		CallSound(sndShot2);
		wait(wt);
	}
}
task TShot_Phase03B(objFamilier, graphic)
{
	let speed = [1, 1, 1.15, 1.25][Difficult];
	let way = [24, 24, 24, 24][Difficult];
	let way_space = [0.33, 0.275, 0.25, 0.25][Difficult];
	
	let sx = ObjMove_GetX(objFamilier);
	let sy = ObjMove_GetY(objFamilier);
	let tmp_phase = SPELL_PHASE;
	while(CanShotBullet(objFamilier))
