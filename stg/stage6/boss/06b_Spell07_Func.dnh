// ラスペ用共通関数

task Mishandra_HideBossEffect(isEnter)
{
	let objImg = GetBossImageID(objEnemy);
	if (isEnter)
	{
		descent(t in 0 .. 60)
		{
			let tmp = (t+1)/60;
			ObjRender_SetColor(objImg, tmp*255, tmp*255, tmp*255);
			yield;
		}
	}
	ObjRender_SetColor(objImg, 0, 0, 0);
	while(eAlive && !Obj_IsDeleted(objEnemy) && !GetEnemyVisible(objEnemy))
	{
		if (IsDrawEffect() > 1)
		{
			MishandraDigitalEffect(ObjMove_GetX(objEnemy)+randEffect(-32,32), ObjMove_GetY(objEnemy)+randEffect(-32,32), rand_int(0,1));
		}
		wait(5);
	}
	if (eAlive)
	{
		ascent(t in 0 .. 60)
		{
			let tmp = (t+1)/60;
			ObjRender_SetColor(objImg, tmp*255, tmp*255, tmp*255);
			yield;
		}
	}
}

// ラスペ開始演出用
task FumaCharismaOption_LS(objBase, flgDelele)
{
	if (IsDrawEffect() < 1) { return; }
	
	// フラグ関係
	if (GetPlayMode() == GAME_SPELL) { flgDelele = true; }
	let flgOpeningEffect = Obj_GetValueD(objScene, "FUMA_OPTION_DELETED", true);
	Obj_SetValue(objScene, "FUMA_OPTION_DELETED", flgDelele);

	let offset_pos = [[0,16], [56,-48], [-56,-48], [0,-48]];
	let rect_pos = [[0,0,256,256], [256,0,448,192], [256,0,448,192], [0,256,320,512]];
	let dest_pos = [[-128,-128,128,128], [-32,-96,160,96], [32,-96,-160,96], [-160,-192,160,64]];
	
	let t = 0;
	if (flgOpeningEffect)
	{
		while(t < 600 && eAlive && !Obj_IsDeleted(objBase))
		{
			let a = aTime(objBase);
			
			if (a%3 == 0)
			{
				let scale1 = (1 + sin(a*2)/16)*0.75;
				let scale2 = (1 + sin(a*2+180)/16)*0.75;
				if (t > 0)
				{
					FumaCharismaOption_sub(objBase, offset_pos[0], rect_pos[0], dest_pos[0], scale1, 2.5);
				}
				if (t > 120)
				{
					FumaCharismaOption_sub(objBase, offset_pos[1], rect_pos[1], dest_pos[1], scale2, 1.75);
					FumaCharismaOption_sub(objBase, offset_pos[2], rect_pos[2], dest_pos[2], scale2, 1.75);
				}
				if (t > 60)
				{
					FumaCharismaOption_sub(objBase, offset_pos[3], rect_pos[3], dest_pos[3], scale1, 3);
				}
			}
			t++;
			yield;
		}
	}
	while(eAlive && !Obj_IsDeleted(objBase))
	{
		let a = aTime(objBase);
		
		if (a%3 == 0)
		{
			let scale1 = (1 + sin(a*2)/16)*0.75;
			let scale2 = (1 + sin(a*2+180)/16)*0.75;
			FumaCharismaOption_sub(objBase, offset_pos[0], rect_pos[0], dest_pos[0], scale1, 2.5);
			ascent(i in 1 .. 3)
			{
				FumaCharismaOption_sub(objBase, offset_pos[i], rect_pos[i], dest_pos[i], scale2, 1.75);
			}
			FumaCharismaOption_sub(objBase, offset_pos[3], rect_pos[3], dest_pos[3], scale1, 3);
		}
		t++;
		yield;
	}
}

task FumaCharismaOption_MC_LS(objBase, pos, flgOpeningEffect, flgDelele)
{
	let obj = ObjPrim_Create(OBJ_SPRITE_2D);
	Obj_SetRenderPriorityI(obj, priorityAura);
	ObjPrim_SetTexture(obj, imgEffectFumaMC);
	ObjSprite2D_SetSourceRect(obj, 0, 0, 512, 512);
	ObjSprite2D_SetDestRect(obj, -320, -320, 320, 320);
	ObjRender_SetBlendType(obj, BLEND_ADD_ARGB);
	ObjRender_SetAngleX(obj, 70);
	ObjRender_SetScaleXYZ(obj, 1, 1, 1);
	
	let bx = pos[0];
	let by = pos[1];
	if (flgOpeningEffect)
	{
		let t = 0;
		let fx = bx;
		let fy = by;
		while(eAlive && !Obj_IsDeleted(objBase) && t < 360)
		{
			let tmp = sin((t+1)/360*90);
			let a = aTime(objBase);

			let ba = a/20;
			ObjRender_SetPosition(obj, fx*(1-tmp)+bx*tmp, fy*(1-tmp)+by*tmp, 0);
			ObjRender_SetColorHSV(obj, a/2, 128, 255);
			ObjRender_SetAngleZ(obj, ba);
			ObjRender_SetAlpha(obj, 192*tmp);
			t++;
			yield;
		}
	}

	ObjRender_SetAngleX(obj, 70);
	ObjRender_SetPosition(obj, bx, by, 0);
	while(eAlive && !Obj_IsDeleted(objBase))
	{
		let a = aTime(objBase);
		let ba = a/20;
		ObjRender_SetColorHSV(obj, a/2, 128, 255);
		ObjRender_SetAngleZ(obj, ba);
		yield;
	}
	if (flgDelele)
	{
		// 削除モーション
	}
	// 1フレームだけ待機
	yield;
	Obj_Delete(obj);
}

// 01オーラ
task MishandraDigitalEffect(x, y, num)
{
	let vx = randEffect(-0.6,0.6);
	let vy = randEffect(-0.2,0.2);
	let flash = rand_int(5, 15);
	x -= vx*45;
	y -= vy*45;
	
	let obj = ObjPrim_Create(OBJ_SPRITE_2D);
	Obj_SetRenderPriorityI(obj, 70);
	ObjRender_SetBlendType(obj, BLEND_ADD_ARGB);
	ObjPrim_SetTexture(obj, imgEffectDigital);
	ObjSprite2D_SetSourceRect(obj, 0+num*16, 0, 16+num*16, 32);
	ObjSprite2D_SetDestCenter(obj);
	ObjRender_SetColor(obj, 0, 255, 0);
	ObjRender_SetScaleXYZ(obj, 1, 1, 1);

	let t = 0;
	let alpha = 0;
	while(alpha < 255)
	{
		alpha += 5;
		ObjRender_SetAlpha(obj, alpha);
		ObjRender_SetPosition(obj, x, y, 0);
		Obj_SetVisible(obj, trunc(t/flash)%2==0);
		x += vx; y += vy;
		t++;
		yield;
	}
	loop(60)
	{
		if (!eAlive) { break; }
		ObjRender_SetPosition(obj, x, y, 0);
		Obj_SetVisible(obj, trunc(t/flash)%2==0);
		x += vx; y += vy;
		t++;
		yield;
	}
	while(alpha > 0)
	{
		alpha -= 5;
		ObjRender_SetAlpha(obj, alpha);
		ObjRender_SetPosition(obj, x, y, 0);
		Obj_SetVisible(obj, trunc(t/flash)%2==0);
		x += vx; y += vy;
		t++;
		yield;
	}
}

task S07DigitalEffect3(x, y, speed, angle, num)
{
	let vx = cos(angle)*speed;
	let vy = sin(angle)*speed;
	let flash = rand_int(5, 15);
	
	let obj = ObjPrim_Create(OBJ_SPRITE_2D);
	Obj_SetRenderPriorityI(obj, 70);
	ObjRender_SetBlendType(obj, BLEND_ADD_ARGB);
	ObjPrim_SetTexture(obj, imgEffectDigital);
	ObjSprite2D_SetSourceRect(obj, 0+num*16, 0, 16+num*16, 32);
	ObjSprite2D_SetDestCenter(obj);
	ObjRender_SetColor(obj, 0, 255, 0);
	ObjRender_SetScaleXYZ(obj, 1.75, 1.75, 1);

	let t = 0;
	let alpha = 0;
	while(alpha < 255)
	{
		alpha += 10;
		ObjRender_SetAlpha(obj, alpha);
		ObjRender_SetPosition(obj, x, y, 0);
		Obj_SetVisible(obj, trunc(t/flash)%2==0);
		x += vx; y += vy;
		t++;
		yield;
	}
	loop(30)
	{
		ObjRender_SetPosition(obj, x, y, 0);
		Obj_SetVisible(obj, trunc(t/flash)%2==0);
		x += vx; y += vy;
		t++;
		yield;
	}
	while(alpha > 0)
	{
		alpha -= 3;
		ObjRender_SetAlpha(obj, alpha);
		ObjRender_SetPosition(obj, x, y, 0);
		Obj_SetVisible(obj, trunc(t/flash)%2==0);
		x += vx; y += vy;
		t++;
		yield;
	}
	Obj_Delete(obj);
}
