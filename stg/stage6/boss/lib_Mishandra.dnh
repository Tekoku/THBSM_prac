// ダメージ軽減率を自機別に設定
task MishandraOption_SetDamageRate(objFamilier)
{
	let shot_rate = 100;
	let spell_rate = 25;
	
	alternative(GetPlayerTypeEx())
	case (PLAYER_REIMU_A)  { shot_rate = 135; spell_rate = 25; }
	case (PLAYER_REIMU_B)  { shot_rate = 135; spell_rate = 25; }
	case (PLAYER_MARISA_A) { shot_rate =  65; spell_rate = 25; }
	case (PLAYER_MARISA_B) { shot_rate = 125; spell_rate = 25; }
	case (PLAYER_SANAE_A)  { shot_rate =  75; spell_rate = 25; }
	case (PLAYER_SANAE_B)  { shot_rate = 125; spell_rate = 25; }
	
	ObjEnemy_SetDamageRate(objFamilier, shot_rate, spell_rate);
}

// ヘブライ文字ショット
task ShotHebrew(x, y, angle, scale, graphic, delay, shot_count, shot_timer, del_timer, str_num)
{
	let POS_STRING;
	
	// [開始,曲線種別,x1,y1,x2,y2,x3,y3]
	// 開始		ラインを絵描くスタート時間（？）  0～1、全体からの割合
	// 曲線種別	0：直線 1：ベジエ曲線
	// x3,y3はベジエ曲線用制御点
	alternative(str_num%22)
	case(0)
	{
		// alef
		POS_STRING = [
			[ 0.0,   1,  0.25,-0.8,  0.5,0.5,  1,-0.8 ],
			[ 0.3,   0,  -0.8,-0.8,  0.8,0.8,  0,0 ],
			[ 0.7,   1,  -0.5,-0.5,  -0.6,0.8,  -0.8,-0.5 ],
			[ 0.95,   0,  -0.6,0.8,  -0.4,0.8,  0,0 ],
		];
	}
	case(1)
	{
		// bet
		POS_STRING = [
			[ 0.0,   0,  -0.5,-0.65,  0.4,-0.75,  0,0 ],
			[ 0.25,   1,  0.4,-0.75,  0.3,1,  0,0.5 ],
			[ 0.7,   0,  -0.6,1,  0.6,1,  0,0 ],
		];
	}
	case(2)
	{
		// gimel
		POS_STRING = [
			[ 0.0,   1,  -0.5,-0.85,  0,0,  0.25,-1 ],
			[ 0.4,   1,  0,0,  0.5,1,  0,1 ],
			[ 0.8,   0,  0,0.5,  -0.6,1,  0,0 ],
		];
	}
	case(3)
	{
		// dalet
		POS_STRING = [
			[ 0.0,   1,  -0.5,-1,  -0.25,-0.8,  -0.8,-0.8 ],
			[ 0.25,   0,  -0.25,-0.8,  0.65,-0.8,  0,0 ],
			[ 0.55,   0,  0.35,-0.8,  0.35,1,  0,0 ],
		];
	}
	case(4)
	{
		// he
		POS_STRING = [
			[ 0.0,   0,  -0.6,-0.75,  0,-0.8, 0,0 ],
			[ 0.15,   1,  0,-0.8,  0.6,1, 1,-0.8 ],
			[ 0.65,   0,  -0.35,-0.5,  -0.5,1, 0,0 ],
		];
	}
	case(5)
	{
		// vav
		POS_STRING = [
			[ 0.0,   1,  -0.2,-0.85,  0.2,-0.5, 0,-0.5 ],
			[ 0.35,   1,  0.2,-0.5,  0.2,1, 0,1 ],
		];
	}
	case(6)
	{
		// zayin
		POS_STRING = [
			[ 0.0,   1,  -0.35,-0.85,  0.25,-0.5, 0,-0.5 ],
			[ 0.35,   1,  0,-0.35,  0.2,1, -0.25,1 ],
		];
	}
	case(7)
	{
		// chet
		POS_STRING = [
			[ 0.0,   1,  -0.6,-0.85,  0,-0.65, -0.5,-0.65 ],
			[ 0.2,   1,  0,-0.65,  0.6,1, 1,-0.8 ],
			[ 0.7,   0,  -0.45,-0.75,  -0.5,1, 0,0 ],
		];
	}
	case(8)
	{
		// tet
		POS_STRING = [
			[ 0.0,   0,  -0.6,-0.6,  -0.1,1, 0,0 ],
			[ 0.35,   1,  -0.1,1,  0.75,0, 0.75,0.5 ],
			[ 0.7,   1,  0.75,0,  0,-0.6, 0.75,-0.75 ],
		];
	}
	case(9)
	{
		// yod
		POS_STRING = [
			[ 0.0,   1,  -0.25,-0.5,  0,0.5, 0.5,-0.5 ],
		];
	}
	case(10)
	{
		// kaf
		POS_STRING = [
			[ 0.0,   1,  -0.5,-0.5,  0.3,1,  1,-1 ],
			[ 0.65,   0,  -0.6,1,  0.6,1,  0,0 ],
		];
	}
	case(11)
	{
		// lamed
		POS_STRING = [
			[ 0.0,  1,  -0.4,-0.75,  -0.6,-0.25,  -0.4,-0.25 ],
			[ 0.25,  0,  -0.6,-0.25,  0.5,-0.25,  0,0 ],
			[ 0.55,  1,  0.5,-0.25,  -0.4,1,  0.5,0.5 ],
		];
	}
	case(12)
	{
		// mem
		POS_STRING = [
			[ 0.0,   1,  -0.3,-0.4,  0.6,1, 1,-1 ],
			[ 0.4,   1,  -0.6,-0.7,  -0.5,1, 0,-0.5 ],
			[ 0.85,   0,  -0.25,1,  0.5,1, 0,0 ],
		];
	}
	case(13)
	{
		// nun
		POS_STRING = [
			[ 0.0,   1,  -0.2,-0.85,  0.2,-0.5, 0,-0.5 ],
			[ 0.3,   1,  0.2,-0.5,  0.2,1, 0,1 ],
			[ 0.85,   0,  0.2,1,  -0.25,1, 0,0 ],
		];
	}
	case(14)
	{
		// samech
		POS_STRING = [
			[ 0.0,   0,  -0.6,-0.6,  -0.1,1, 0,0 ],
			[ 0.35,   1,  -0.1,1,  0.75,-0.35, 0.75,0.5 ],
			[ 0.7,   1,  0.75,-0.35,  -0.5,-0.4, 0.75,-0.75 ],
		];
	}
	case(15)
	{
		// ayin
		POS_STRING = [
			[ 0.0,   0,  -0.5,-0.5,  0,0.75, 0,0 ],
			[ 0.3,   1,  0.6,-0.75,  0.1,0.75, 0.75,0.6 ],
			[ 0.75,   0,  0.1,0.75,  -0.5,1, 0,0.75 ],
		];
	}
	case(16)
	{
		// pe
		POS_STRING = [
			[ 0.0,   1,  0,0.25,  -0.3,-0.3, -0.5,0 ],
			[ 0.2,   1,  -0.3,-0.3,  0.6,1, 1,-1 ],
			[ 0.75,   0,  -0.25,1,  0.5,1, 0,0 ],
		];
	}
	case(17)
	{
		// tsadi
		POS_STRING = [
			[ 0.0,   1,  -0.5,-0.6,  0.5,0.8, 0.5,0.5 ],
			[ 0.4,   1,  0.5,0.8,  -0.5,1, 0.5,1 ],
			[ 0.75,   1,  0.5,-0.75,  0.25,0, 0.35,0 ],
		];
	}
	case(18)
	{
		// kof
		POS_STRING = [
			[ 0.0,   0,  -0.5,-0.6,  0.5,-0.6, 0,0 ],
			[ 0.3,   1,  0.5,-0.6,  -0.15,0.4, 0.5,0.4 ],
			[ 0.6,   0,  -0.4,-0.5,  -0.2,1, 0,0 ],
		];
	}
	case(19)
	{
		// resh
		POS_STRING = [
			[ 0.0,   0,  -0.5,-0.65,  0.4,-0.75,  0,0 ],
			[ 0.4,   1,  0.4,-0.75,  0.3,1,  0,0.5 ],
		];
	}
	case(20)
	{
		// shin
		POS_STRING = [
			[ 0.0,   0,  -0.6,-0.6,  -0.1,1, 0,0 ],
			[ 0.35,   1,  -0.1,1,  0.75,-0.5, 0.75,0.75 ],
			[ 0.75,   1,  -0.2,0.4,  0.25,-0.5, 0.25,0.25 ],
		];
	}
	case(21)
	{
		// tav
		POS_STRING = [
			[ 0.0,   0,  -0.5,-0.65,  0.4,-0.75,  0,0 ],
			[ 0.25,   1,  0.4,-0.75,  0.65,1,  0.2,0.5 ],
			[ 0.6,   1,  -0.25,-0.75,  -0.6,1,  -0.25,0.75 ],
		];
	}
	
	let st = 0;
	ascent(i in 0 .. shot_count)
	{
		if (!eAlive) { return; }

		let tmp = i/(shot_count-1);
		let to_tmp = 1;
		let ldat = [];
		descent(i in 0 .. length(POS_STRING))
		{
			if (POS_STRING[i][0] <= tmp)
			{
				ldat = POS_STRING[i];
				break;
			}
			to_tmp = POS_STRING[i][0];
		}
		if (length(ldat) > 0)
		{
			let lt = (tmp-ldat[0])/(to_tmp-ldat[0]);
			let pos;
			if (ldat[1] == 0) { pos = GetLinePosition(ldat[2..4], ldat[4..6], lt); }
			else { pos = GetBezierCurvePosition(ldat[2..4], ldat[4..6], ldat[6..8], lt); }
			
			let rpos = Rotate2D_XY(pos[0], pos[1], angle);			
			// 弾設置
			let obj = CreateShotA1(x+rpos[0]*scale, y+rpos[1]*scale, 0, angle+90, graphic, delay);
			ObjShot_SetDeleteFrame(obj, del_timer);
		}
		st += shot_timer/shot_count;
		while(st > 0) { st--; yield; }
	}
}

// 座標取得のみ
function GetHebrewPos(angle, scale, str_num, tpos)
{
	let POS_STRING;
	
	// [開始,曲線種別,x1,y1,x2,y2,x3,y3]
	// 開始		ラインを絵描くスタート時間（？）  0～1、全体からの割合
	// 曲線種別	0：直線 1：ベジエ曲線
	// x3,y3はベジエ曲線用制御点
	alternative(str_num%22)
	case(0)
	{
		// alef
		POS_STRING = [
			[ 0.0,   1,  0.25,-0.8,  0.5,0.5,  1,-0.8 ],
