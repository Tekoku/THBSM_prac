#東方弾幕風[Single]
#ScriptVersion[3]
#Title["6面　ボス会話"]
#Text["6面　ボス会話"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./../../../lib/lib_talk.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult( 0);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(-1);	}
	BossEvent();
}

@Initialize {
	// アニメリセット
	Reset_aTime(BOSS_ID_MISHANDRA);
	
	Boss_Init();	//初期設定
	
	objEnemy  = CreateBossTalk(BOSS_ID_MISHANDRA);
	Task_Main();
}

@MainLoop {
	yield;

}

// メインタスク
task Task_Main()
{
	// 魔法陣リセット
	BossEffect_ResetMagicCircle();

	// 会話準備
	StartTalk();

	wait(120);

	//会話処理
	FuncTalk();
	
	//次のシーンへ
	FinishTalk(true);
	Boss_Finalize(objEnemy, false, false);
	//Obj_Delete(objScene);	// 会話シーン強制終了
}

// 会話処理
function FuncTalk()
{
	// オブジェクト作成
	let cutinBoss1   = CreateTalkObject(BOSS_ID_MISHANDRA, true);
	let cutinPlayer1 = CreateTalkObject(BOSS_ID_SANAE, false);
	
	// 初期設定
	ChangeTalkTexture(cutinPlayer1, I_SMILE2);
	SetImageFoward(cutinPlayer1, true);
	SetImageVisible(cutinBoss1, false);
	wait(15);
	
	let talkID = 0;
	loop
	{
		let talkType = FuncTalkSingle(talkID);
		if (talkType == 0) { break; }
		talkID = max(0, talkID+WaitNext());
	}

	// 会話処理単発（巻き戻しも出来るように）
	function FuncTalkSingle(talkID)
	{
		let talk_type = 1;
		alternative(talkID)
		case(0)
		{
			ChangeTalkTexture(cutinPlayer1, I_SMILE2);
			SetTalkEx(cutinPlayer1, "さあ黒幕さん！[r]もう隠れ場所はありませんよ！");
		}
		case(1)
		{
			SetImageVisible(cutinBoss1, false);	// ボス画像出現フラグ
			ChangeTalkTexture(cutinPlayer1, I_SURPRISE);
			
			SetTalkEx2(cutinBoss1, "黒幕はまだ出て来てはいない。", -32, -280);
		}
		case(2)
		{
			SetTalkEx(cutinBoss1, "");
			EnterBoss();
			wait(90);
			BossScene_SetNameVisible(objScene, true);	//ボスネーム表示状態
			SetImageVisible(cutinBoss1, true);	// ボス画像出現フラグ

			ChangeTalkTexture(cutinBoss1, I_NORMAL);
			ChangeTalkTexture(cutinPlayer1, I_NORMAL);
			SetTalkEx(cutinBoss1, "間もなくこの本より召喚される72の悪魔。[r]それらが真の黒幕となろう。");
			SetBossName(cutinBoss1);	// ボスネーム表示
		}
		case(3)
		{
			ChangeTalkTexture(cutinPlayer1, I_WORRY);
			SetTalkEx(cutinPlayer1, "72の悪魔？　王でもない貴方が[r]何故その本を使えるのです？");
		}
		case(4)
		{
			ChangeTalkTexture(cutinPlayer1, I_SURPRISE);
			SetTalkEx(cutinPlayer1, "あっ、そう言えば72の悪魔より凄い73番目の[r][ruby rb=\" 悪魔\" rt=\"ミシャンドラ\"]って昔インチキ臭い本で読んだような…");
		}
		case(5)
		{
			ChangeTalkTexture(cutinBoss1, I_WORRY);
			SetTalkEx(cutinBoss1, "ミシャンドラ？　気になるぞ。");
		}
		case(6)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL3);
			SetTalkEx(cutinBoss1, "だが君がそう思うならそれで良い、[r]フーマの存在などその程度の物だ。");
		}
		case(7)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL);
			SetTalkEx(cutinBoss1, "フーマに望まれたのは乱世を終わらせる力。[r]しかしこの世界は乱世を求めてすらいない。");
		}
		case(8)
		{
			ChangeTalkTexture(cutinPlayer1, I_ANGER);
			SetTalkEx(cutinPlayer1, "ならばこそ。[r]何故私たちの計画に横入りしたのです！？");
		}
		case(9)
		{
			ChangeTalkTexture(cutinPlayer1, I_NORMAL);
			SetTalkEx(cutinPlayer1, "神奈子様は新七夕を、お客寄せの[r][ruby rb=\"御神事\" rt=\"イベント\"]として企画なされたのです。");
		}
		case(10)
		{
			ChangeTalkTexture(cutinPlayer1, I_ANGER);
			SetTalkEx(cutinPlayer1, "織姫と彦星に無駄な期待を抱かせる事も、[r]制御不能の力をまたまた生み出す事も[r]望まれていなかった筈！");
		}
		case(11)
		{
			ChangeTalkTexture(cutinBoss1, I_NOTICE);
			SetTalkEx(cutinBoss1, "あの悪しき狐を信用させ、[r]そして油断させる。");
		}
		case(12)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL3);
			SetTalkEx(cutinBoss1, "その為に、フーマもまた[r]奴の口車に乗ったように見せた。");
		}
		case(13)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL);
			SetTalkEx(cutinBoss1, "奴を解き放ってはいけない。[r]また乱世が訪れる。");
		}
		case(14)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL2);
			SetTalkEx(cutinBoss1, "この力を増した星と悪魔の光で、[r]奴を完全に縛るのだ。");
		}
		case(15)
		{
			ChangeTalkTexture(cutinPlayer1, I_SMILE2);
			SetTalkEx(cutinPlayer1, "幻想郷では妖怪退治は巫女の仕事です。[r]私達に任せておいて下さい。");
		}
		case(16)
		{
			ChangeTalkTexture(cutinPlayer1, I_SMILE);
			SetTalkEx(cutinPlayer1, "さあ星の力を霧散させて！[r]来年の七夕まで雨が続いてしまう！");
		}
		case(17)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL);
			SetTalkEx(cutinBoss1, "フーマの生まれた意味は？[r]それは魔本最大の呪文を発動させる事。");
		}
		case(18)
		{
			ChangeTalkTexture(cutinBoss1, I_UPSET);
			SetTalkEx(cutinBoss1, "フーマの存在理由を奪って、[r]君はフーマをどうすると言うのだ？");
		}
		case(19)
		{
			ChangeTalkTexture(cutinPlayer1, I_SMILE2);
			SetTalkEx(cutinPlayer1, "導きます！[r]存在理由が消えたら新しく作ればいい！");
		}
		case(20)
		{
			ChangeTalkTexture(cutinPlayer1, I_SMILE);
			SetTalkEx(cutinPlayer1, "偉大なるグリモワールの神霊？[r]所詮貴方は迷える子羊。[r]子羊は守矢神社にて導きます！");
		}
		case(21)
		{
			//BGM
			PlayMusicWithName(13, 180, 30);

			ChangeTalkTexture(cutinBoss1, I_WORRY);
			SetTalkEx(cutinBoss1, "口ではどんな清らかな事も言える。[r]ミシャンドラ、調べたぞ。");
		}
		case(22)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL3);
			SetTalkEx(cutinBoss1, "君だって今に悪魔に囲まれてから、[r]泣いて詫びたって知らないぞ。");
		}
		case(23)
		{
			ChangeTalkTexture(cutinPlayer1, I_SMILE);
			SetTalkEx(cutinPlayer1, "ああ貴方は利口だ、自惚れているがいい。[r]私はちゃあんと言った事を守りますから！");
		}
		case(24)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL);
			SetTalkEx(cutinBoss1, "73番目の悪魔が知られていない所以、[r]それは人間に自らの存在を記憶させない力。");
		}
		case(25)
		{
			ChangeTalkTexture(cutinBoss1, I_NORMAL2);
			SetTalkEx(cutinBoss1, "歴史に残らないであろうこの戦い、[r]語り継ぐのは夜空の星だけとなる！");
		}
		others
		{
			return(0);
		}
		return(talk_type);
	}
}

// 登場モーション
task EnterBoss()
{
	if (Obj_GetValueD(objEnemy, "BOSS_MOVED", false)) { return; }
	Obj_SetValue(objEnemy, "BOSS_MOVED", true);

	// 登場モーション
	EffectEntryBoss(objEnemy, [EFF_SKY, EFF_BLUE, EFF_PURPLE], [CenX, 105]);
}
