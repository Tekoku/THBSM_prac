#東方弾幕風[Single]
#ScriptVersion[3]
#Title["ミシャンドラ通常"]
#Text["ミシャンドラ通常4"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./lib_Mishandra.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(4200);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(60);		}
	BossEvent();
}

@Initialize {
	bossDropItem = 0;	//アイテム数
	
	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_MISHANDRA);	//ボスセット
	CheckLinkLife_Boss(objEnemy);	// 使い魔と体力連動

	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	standBy(objEnemy, CenX, 140, 60);
	FumaCharismaOption(objEnemy, false);
	wait(60);
	
	TShot02();
	wait(180);
	if (Difficult >= D_NORM)
	{
		CircleShotA04();
	}
}

task TShot02()
{
	let wt = [360, 360, 360, 480][Difficult];
	let laser_flg = [0, 0, 0, 1][Difficult];
	
	let t = 0;
	while(eAlive)
	{
		let base_angle = GetAngleToPlayer(objEnemy);
		HebrewSet(base_angle, laser_flg);
		if (Difficult == D_HARD)
		{
			wait(60);
			if (!eAlive) { return; }
			HebrewSet(base_angle+30, laser_flg);
		}
		wait(120);
		if (!eAlive) { return; }
		if (t > 0)
		{
			EnemyRandomMove(objEnemy, 140, 48);
		}
		wait(wt-120);
		t++;
	}
}

task CircleShotA04()
{
	let speed = [1, 1, 1, 1][Difficult];
	let wt = [3, 3, 3, 3][Difficult];
	let graphic = BGW_RICE_M_WHITE;
	let way = 1;

	let max_r = 108;
	let base_angle = rand(0, 360);
	let add_angle = 1 + 120/wt;
	let offset_angle = -90;
	
	let bx = ObjMove_GetX(objEnemy);
	let by = ObjMove_GetY(objEnemy);
	
	let objEff = MishandraLineEffect(objEnemy, bx, by, MLINE_CIRCLE);
	
	ascent(t in 0 .. 90)
	{
		let tmp = sin((t+1)/90*90);
		Obj_SetValue(objEff, "R", tmp*max_r);
		ObjRender_SetPosition(objEff, bx, by, 0);
		bx = bx*0.98+ObjMove_GetX(objEnemy)*0.02;
		by = by*0.98+ObjMove_GetY(objEnemy)*0.02;
		yield;
	}
	let t = 0;
	while(eAlive)
	{
		if (t > 60 && t%wt == 0)
		{
			ascent(i in 0 .. way)
			{
				let sa = base_angle + i*360/way;
				let sx = bx + max_r*cos(sa);
				let sy = by + max_r*sin(sa);
				let ta = sa+offset_angle;
				
				let objShot = CreateShotA1(sx, sy, 0, ta, graphic, 0);
				ObjMove_AddPatternA2(objShot, 90, NO_CHANGE, NO_CHANGE, speed/60, 0, speed);
				My_RaiseShotEffectD_AA(objShot, 15);
				
				OpenLaserEffect(bx, by,
					atan2(sy-by,sx-bx), ((sy-by)^2+(sx-bx)^2)^0.5, 20);
			}
			CallSound(sndShot2);
			base_angle += add_angle*wt;
		}
		ObjRender_SetPosition(objEff, bx, by, 0);
		bx = bx*0.98+ObjMove_GetX(objEnemy)*0.02;
		by = by*0.98+ObjMove_GetY(objEnemy)*0.02;
		t++;
		yield;
	}
	MishandraLineEffect_Fadeout(objEff);
}

task HebrewSet(ba, laser_flg)
{
	let way = 6;
	let r = 150;

	let bx = ObjMove_GetX(objEnemy);
	let by = ObjMove_GetY(objEnemy);
	HexagramLaser(bx, by, ba, 108);
//	wait(45);
	ascent(i in 0 .. way)
	{
		if (!eAlive) { return; }
		let sa = ba + i*360/way;
		let sx = bx + r*cos(sa);
		let sy = by + r*sin(sa);
		HebrewShot01(sx, sy, sa-90, laser_flg);
		wait(5);
	}
}

task HebrewShot01(x, y, angle, laser_flg)
{
	MishandraMiniCircle(x, y, 0.5, 120+180);
	wait(60);
	if (!eAlive) { return; }
	
	let speed = 2;
	let graphic = ADD_BGW_LIGHT_S_YELLOW;
	let to_graphic = BGW_STAR_S_WHITE;
	
	let count = 15;
	let shot_timer = 15;
	
	let char_num = rand_int(0,21);
	let scale = 30;
	
	let timer = 60;
	let st = 0;
	ascent(i in 0 .. count)
	{
		if (!eAlive) { return; }

		let tmp = i/(count-1);
		let pos = GetHebrewPos(angle, scale, char_num, tmp);
		HebrewShot01_sub(x+pos[0], y+pos[1], pos[0]/15, pos[1]/15, graphic, 15, timer);
		
		st += shot_timer/count;
		while(st > 0) { st--; timer--; yield; }
	}
	wait(timer+40);
	if (eAlive)
	{
		let ba = rand(0, 360);
		HexagramLaser(x, y, ba, 64);

		if (laser_flg > 0)
		{
			let way = [1, 1, 1, 3][Difficult];
			let r = 86;

			ascent(i in 0 .. way)
			{
				if (!eAlive) { return; }
				let sa = ba + i*360/way;
				let sx = x + r*cos(sa);
				let sy = y + r*sin(sa);
				HebrewShot01(sx, sy, sa-90, laser_flg-1);
				wait(5);
			}
		}
	}
}
task HebrewShot01_sub(x, y, vx, vy, graphic, delay, timer)
{
	let obj = CreateShotA1(x, y, 0, 0, graphic, delay);
	Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI+1);
	wait(timer);
	if (!Obj_IsDeleted(obj))
	{
		HebrewShot01_sub2(x, y, vx, vy, graphic, 30);
		ObjShot_FadeDelete(obj);
	}
}
task HebrewShot01_sub2(x, y, vx, vy, graphic, delay)
{
	let obj = CreateShotB2(x, y, 0, 0, -vx/60, -vy/60, -vx*2, -vy*2, graphic, 0);
	ObjShot_SetSpellResist(obj, true);
	My_RaiseShotEffectB(obj, delay);
	wait(40);
	Obj_Delete(obj);
}

task HexagramLaser(x, y, angle, size)
{
	ascent(i in 0 .. 6)
	{
		HexagramLaser_sub(x, y, angle+i*60, 90, size);
		HexagramLaser_sub(x, y, angle+i*60, -90, size);
	}
}

task HexagramLaser_sub(x, y, angle, offset_angle, size)
{
	let graphic = BGW_BEAM_BLUE;
	let l_wid = 12;
	let timer = 60;
	let delay = 120;
	
	let obj = My_CreateStraightLaserA1(x, y, angle+offset_angle, 0, l_wid, timer, graphic, delay, false);
	ascent(i in 0 .. 75)
	{
		if (Obj_IsDeleted(obj)) { break; }
		let tmp = sin((i+1)/75*90);
		let sx = x + cos(angle)*tmp*size;
		let sy = y + sin(angle)*tmp*size;
		ObjMove_SetPosition(obj, sx, sy);
		ObjLaser_SetLength(obj, tmp*600);
		yield;
	}
	wait(delay-75);
	if (!Obj_IsDeleted(obj))
	{
		CallSound(sndLaser2);
	}
}
