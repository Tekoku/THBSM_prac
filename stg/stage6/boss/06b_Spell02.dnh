#東方弾幕風[Single]
#ScriptVersion[3]
#Title["グリモワールバタフライ"]
#Text["グリモワールバタフライ"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./lib_Mishandra.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(900);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(80);		}
	BossEvent();
}

@Initialize {
	dIni_Shot = 20;		//ダメージ透過率

	bossDropItem = 80;	//アイテム数
	bossHitToShot = 64;
	bossDropStarItem = 120;
	
	bossNormalDropStar = 8;
	bossDropStarItemR = 118;
	
	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_MISHANDRA);	//ボスセット
	CheckLinkLife_Boss(objEnemy);	// 使い魔と体力連動

	//スペカデータ・セット
	SetSpellCardData(GetSpellCardID(53), [3,3,4,5][Difficult], 
			GetCurrentScriptDirectory()~"06b_Background.dnh",
			GetBossTexture(objEnemy, I_CUTIN), 1, CUTMOTION_NORMAL);
//	SetShotAutoDeleteClip(128, 128, 128, 64);
	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	standBy(objEnemy, CenX, 150, 60);
	FumaCharismaOption(objEnemy, false);
	wait(60);
	
	CallSpellCard(true);	//スペカ起動
	
	wait(60);
	
	if (Difficult <= D_NORM)
	{
		let speed = [1.75, 2, 2, 2][Difficult];
		let way = [18, 27, 27, 27][Difficult];
		let count = [1, 3, 3, 3][Difficult];
		let count_max = [4, 5, 5, 5][Difficult];
		let wt = [270, 240, 240, 240][Difficult];
		let colors = [5, 6, 7];
		let lway = 6;
		
		let t = 0;
		let muki = rand_dir();
		while(eAlive)
		{
			BossCharge(objEnemy);
			wait(120);
			
			let base_angle = GetAngleToPlayer(objEnemy);
			let tmp_ct = trunc(count);
			let tmp_muki = muki;
			ascent(j in 0 .. tmp_ct)
			{
				if (!eAlive) { return; }
				let tmp_way = way-(tmp_ct-j-1)*3;
				let ba = base_angle - 35/2*tmp_muki + j/tmp_ct*360/24*4*muki;
				ascent(i in 0 .. tmp_way)
				{
					let sa = ba+i*360/tmp_way*tmp_muki;
					let ss = speed * (1 - j/tmp_ct*0.75);
					BigButterflyShot(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
						ss, sa, colors[i%length(colors)], 30, tmp_muki, true);
					CallSound(sndShot2);
				}
				tmp_muki = -tmp_muki;
				wait(10);
			}
			wait(15);
			if (!eAlive) { return; }
			CallSound(sndBoon);
			base_angle = GetAngleToPlayer(objEnemy);
			ascent(i in 0 .. lway*2)
			{
				let sa = base_angle + i*360/lway/2;
				HebrewShot01(ObjMove_GetX(objEnemy)+160*cos(sa), ObjMove_GetY(objEnemy)+160*sin(sa),
					sa-90, [180, 0][i%2]);
			}
			wait(wt-120);
			if (!eAlive) { return; }
			EnemyRandomMove(objEnemy, 150, 32);
			wait(120);

			if (count < count_max)
			{
				count++;
			}
			muki = -muki;
			t++;
		}
	}
	else if (Difficult <= D_HARD)
	{
		let speed = [1.75, 2, 3, 2][Difficult];
		let way2 = 12;
		let way = [18, 27, 27, 27][Difficult];
		let count = 12;
		let count_max = 32;
		let wt = [270, 240, 210, 240][Difficult];
		let colors = [0, 1, 2];
		let lway = 6;
		
		let t = 0;
		let muki = rand_dir();
		while(eAlive)
		{
			BossCharge(objEnemy);
			wait(120);
			
			let base_angle = GetAngleToPlayer(objEnemy);
			let tmp_ct = trunc(count);
			let tmp_muki = muki;
			ascent(j in 0 .. tmp_ct)
			{
				if (!eAlive) { return; }
				let tmp_way = way2;
				let ba = base_angle + j/tmp_ct*360*tmp_muki/3;
				ascent(i in 0 .. tmp_way)
				{
					let sa = ba+i*360/tmp_way*tmp_muki;
					let ss = speed * (1 - j/tmp_ct*0.75);
					BigButterflyShot(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
						ss, sa, colors[i%length(colors)], 30, tmp_muki, true);
					CallSound(sndShot2);
				}
	//			tmp_muki = -tmp_muki;
				wait(5);
			}
			wait(15);
			if (!eAlive) { return; }
			CallSound(sndBoon);
			base_angle = GetAngleToPlayer(objEnemy);
			ascent(i in 0 .. lway*2)
			{
				let sa = base_angle + i*360/lway/2;
				HebrewShot01(ObjMove_GetX(objEnemy)+160*cos(sa), ObjMove_GetY(objEnemy)+160*sin(sa),
					sa-90, [180, 0][i%2]);
			}
			wait(wt-120);
			if (!eAlive) { return; }
			EnemyRandomMove(objEnemy, 150, 32);
			wait(120);

			muki = -muki;
			t++;
		}
	}
	else
	{
		let speed = [1.75, 2, 2, 2.5][Difficult];
		let way = 27;
		let way_max = 32;
		let count = [1, 3, 3, 8][Difficult];
		let wt = [270, 240, 240, 240][Difficult];
		let colors = [0, 1, 2, 3, 4, 5, 6, 7];
		let lway = 6;
		
		let t = 0;
		let muki = rand_dir();
		while(eAlive)
		{
			BossCharge(objEnemy);
			wait(120);
			
			let base_angle = GetAngleToPlayer(objEnemy);
			let tmp_ct = trunc(count);
			let tmp_muki = muki;
			ascent(j in 0 .. tmp_ct)
			{
				let last_flg = (j >= tmp_ct-1);
				if (!eAlive) { return; }
				if (last_flg)
				{
					CallSound(sndPower4);
					wait(60);
				}
				if (!eAlive) { return; }
				let tmp_way = way-(tmp_ct-j-1)*2;
				let ba = base_angle - 35/2*tmp_muki + j/tmp_ct*360/24*muki;
				ascent(i in 0 .. tmp_way)
				{
					let sa = ba+i*360/tmp_way*tmp_muki;
					let ss = speed * (1 - j/tmp_ct*0.75);
					if (last_flg) { ss = speed*1.25; }
					BigButterflyShot(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
						ss, sa, colors[j%length(colors)], 30, tmp_muki, !last_flg);
					CallSound(sndShot2);
				}
				tmp_muki = -tmp_muki;
				wait(8);
			}
			wait(15);
			if (!eAlive) { return; }
			CallSound(sndBoon);
			base_angle = GetAngleToPlayer(objEnemy);
			ascent(i in 0 .. lway*2)
			{
				let sa = base_angle + i*360/lway/2;
				HebrewShot01(ObjMove_GetX(objEnemy)+160*cos(sa), ObjMove_GetY(objEnemy)+160*sin(sa),
					sa-90, [180, 0][i%2]);
			}
			wait(wt-120);
			if (!eAlive) { return; }
			EnemyRandomMove(objEnemy, 150, 32);
			wait(120);

			if (way < way_max)
			{
				way++;
			}
			muki = -muki;
			t++;
		}
	}
}

task HebrewShot01(x, y, angle, offset_angle)
{
	MishandraMiniCircle(x, y, 0.5, 300);
	wait(60);
	if (!eAlive) { return; }
	
	let speed = [0.66, 0.66, 0.66, 0.66][Difficult];
	let way = [10, 12, 18, 24][Difficult];
	let xsize = [0.4, 0.5, 0.75, 1][Difficult];
	
	let graphic = ADD_BGW_LIGHT_S_WHITE;
	let to_graphic = BGW_BILL_WHITE;
	
	let count = 15;
	let shot_timer = 15;
	
	let char_num = rand_int(0,21);
	let scale = 30;
	
	let timer = 60;
	let st = 0;
	
	ascent(i in 0 .. count)
	{
		if (!eAlive) { return; }

		let tmp = i/(count-1);
		let pos = GetHebrewPos(angle, scale, char_num, tmp);
		
		HebrewShot01_sub(x+pos[0], y+pos[1], pos[0]/15, pos[1]/15, graphic, 15, timer);
		
		st += shot_timer/count;
		while(st > 0) { st--; timer--; yield; }
	}
	wait(40+timer);
	if (!eAlive) { return; }
	ascent(i in 0 .. way)
	{
		let pos = Rotate2D_XY(1*speed, (1-i/(way-1)*2)*speed*xsize, angle-90+offset_angle);
		let obj1 = CreateShotB2(x, y, 0, 0, pos[0]/30, pos[1]/30, pos[0], pos[1], to_graphic, 0);
		My_RaiseShotEffectB(obj1, 15);
	//	let obj2 = CreateShotB2(x, y, 0, 0, -pos[0]/30, -pos[1]/30, -pos[0], -pos[1], to_graphic, 0);
	//	My_RaiseShotEffectB(obj2, 15);
	}
}
task HebrewShot01_sub(x, y, vx, vy, graphic, delay, timer)
{
	let obj = CreateShotA1(x, y, 0, 0, graphic, delay);
	Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI+2);
	ObjShot_SetSpellResist(obj, true);
	wait(timer);
	if (!Obj_IsDeleted(obj))
	{
		HebrewShot01_sub2(x, y, vx, vy, graphic, 30);
		CallSound(sndShot2);
		ObjShot_FadeDelete(obj);
	}
}
task HebrewShot01_sub2(x, y, vx, vy, graphic, delay)
{
	let obj = CreateShotB2(x, y, 0, 0, -vx/60, -vy/60, -vx*2, -vy*2, graphic, 0);
	ObjShot_SetSpellResist(obj, true);
	My_RaiseShotEffectB(obj, delay);
	wait(40);
	Obj_Delete(obj);
}


task BigButterflyShot(x, y, speed, angle, color_type, delay, muki, uneri_flg)
{
	let gs = [ADD_BGW_LIGHT_S_RED, ADD_BGW_LIGHT_S_ORANGE, ADD_BGW_LIGHT_S_YELLOW, ADD_BGW_LIGHT_S_GREEN, ADD_BGW_LIGHT_S_SKY, ADD_BGW_LIGHT_S_BLUE, ADD_BGW_LIGHT_S_PURPLE, ADD_BGW_LIGHT_S_WHITE][color_type%8];
	let g1 = [BGW_LIGHT_S_RED, BGW_LIGHT_S_ORANGE, BGW_LIGHT_S_YELLOW, BGW_LIGHT_S_GREEN, BGW_LIGHT_S_SKY, BGW_LIGHT_S_BLUE, BGW_LIGHT_S_PURPLE, BGW_LIGHT_S_WHITE][color_type%8];
	let g2 = [BGW_BUTTERFLY_RED, BGW_BUTTERFLY_ORANGE, BGW_BUTTERFLY_YELLOW, BGW_BUTTERFLY_GREEN, BGW_BUTTERFLY_SKY, BGW_BUTTERFLY_BLUE, BGW_BUTTERFLY_PURPLE, BGW_BUTTERFLY_WHITE][color_type%8];
	let bcolor = [[220, 96, 96], [210, 140, 96], [170, 170, 96], [96, 210, 96], [96, 192, 192], [96, 160, 255], [192, 96, 192], [160, 160, 160]][color_type%8];

	let objEffect = [CreateShotA1(x, y, 0, angle, g2, 0), CreateShotA1(x, y, 0, angle, g2, 0)];
	let objBase = CreateShotA1(x, y, 0, angle, g1, 0);
	Obj_SetRenderPriorityI(objBase, GetShotRenderPriorityI+1);
	BigButterflyShot_motion();
	ascent(i in 0 .. 2)
	{
//		Obj_SetRenderPriorityI(objEffect[i], GetShotRenderPriorityI+1);
		SetShotDisabled(objEffect[i]);
		ObjRender_SetColor(objEffect[i], bcolor[0], bcolor[1], bcolor[2]);
		ObjRender_SetBlendType(objEffect[i], BLEND_ADD_ARGB);
	}
	
	let t = 0;
	while(!Obj_IsDeleted(objBase))
	{
		let tmp = (2 + sin(t*5))/3;
		ascent(i in 0 .. 2)
		{
			ObjRender_SetScaleXYZ(objEffect[i], tmp*1.5, 1.5, 1);

			ObjMove_SetSpeed(objEffect[i], ObjMove_GetSpeed(objBase));
			ObjMove_SetAngle(objEffect[i], ObjMove_GetAngle(objBase));
			ObjMove_SetPosition(objEffect[i], ObjMove_GetX(objBase), ObjMove_GetY(objBase));
		}
		/*
		if (t == string_flg)
		{
			HebrewShot01(ObjMove_GetX(objBase), ObjMove_GetY(objBase), angle-70*muki, muki);
		}
		*/
		t++;
		yield;
	}
	ascent(i in 0 .. 2)
	{
		Obj_Delete(objEffect[i]);
	}
	
	task BigButterflyShot_motion()
	{
		let horming_power = 2.5;
		
		ObjMove_AddPatternA2(objBase, 0, speed/4+4, NO_CHANGE, -4/delay, 0, speed/4);
		ObjMove_AddPatternA2(objBase, delay, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
		ObjMove_AddPatternA2(objBase, delay+120, NO_CHANGE, NO_CHANGE, -speed/60, 0, speed/4);
		ObjMove_AddPatternA2(objBase, delay+180, NO_CHANGE, NO_CHANGE, speed/120, 0, speed);
		ascent(i in 0 .. delay)
		{
			let tmp = (i+1)/delay;
			ObjRender_SetScaleXYZ(objBase, 3-tmp*2, 3-tmp*2, 1);
			ObjRender_SetAlpha(objBase, min(255, tmp*384));
			ascent(i in 0 .. 2)
			{
				ObjRender_SetAlpha(objEffect[i], tmp*255);
			}
			yield;
		}
		if (!uneri_flg) { return; }
		let t = 0;
		while(!Obj_IsDeleted(objBase) && t < 720)
		{
			let add_angle = sin(t*1.5)*muki;
			if (t < 120) { add_angle *= 1.25; }
			else if (t < 240) { add_angle *= 2; }
			else { add_angle *= 2*(720-t)/480; }
			ObjMove_SetAngle(objBase, ObjMove_GetAngle(objBase)+add_angle);
			t++;
			yield;
		}
	}
}

