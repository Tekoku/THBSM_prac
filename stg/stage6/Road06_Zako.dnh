// 星座用レーザー
task StarLaser(objFrom, from_angle, to_angle, graphic, delay, timer, shot_speed, offset_angle, shot_graphic, shot_wt, shot_seed)
{
	let obj = My_CreateStraightLaserA1(ObjMove_GetX(objFrom), ObjMove_GetY(objFrom), 0, 0, 8, 9999, graphic, delay, true);
	ObjShot_SetAutoDelete(obj, false);

	let bx = ObjMove_GetX(objFrom);
	let by = ObjMove_GetY(objFrom);

	let t = 0;
	let lr = 0;
	let la = from_angle;
	while(!Obj_IsDeleted(obj))
	{
		if (t < 45)
		{
			let tmp = sin((t+1)/45*90);
			lr = 600*tmp;
			la = from_angle*(1-tmp)+to_angle*tmp;
		}
		if (t > timer || !CanShotBullet(objFrom))
		{
			let br = 12;
			let bs = 0;
			let t = 0;
			while(br < 400)
			{
				if (Obj_IsDeleted(obj)) { break; }
				let sx = bx+cos(la)*br;
				let sy = by+sin(la)*br;
				ObjMove_SetPosition(obj, sx, sy);
				t++;
				bs += 0.05*t^0.5;
				br += bs;
				
				if ((t+shot_seed)%shot_wt == 0)
				{
					let sa = 90;
				//	let sa = atan2(GetPlayerY-sy, GetPlayerX-sx);
					My_CreateShotA2(sx, sy, 0, sa, shot_speed/120, shot_speed, shot_graphic, 15);
				}
				yield;
			}
			Obj_Delete(obj);
			return;
		}
		bx = ObjMove_GetX(objFrom);
		by = ObjMove_GetY(objFrom);
		ObjMove_SetPosition(obj, bx+cos(la)*12, by+sin(la)*12);
		ObjLaser_SetLength(obj, max(0, lr-24));
		ObjStLaser_SetAngle(obj, la);
		t++;
		yield;
	}
	Obj_Delete(obj);
}
