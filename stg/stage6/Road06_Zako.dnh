task SetStarEnemy(ex, tx, seed)
{
	let shot_speed = [2, 2, 3, 4][Difficult];
	let shot_graphic = BGW_CROSS_YELLOW;
	let shot_wt = [60, 32, 26, 15][Difficult];
	let bt = 135;
	
	let speed = 6;
	let ey = 0;
	let ty = GetStgFrameHeight*0.5;
	let sa = atan2(ty-ey, tx-ex);
	let offset_angle = rand(-15,15);

	let tmpObj = SetEnemyS01(ex, ey, speed, sa, 0, 30);
	StarLaser(tmpObj, 0, sa-90+offset_angle, BGW_BEAM_YELLOW, 30, bt,
		shot_speed, 90, shot_graphic, shot_wt, seed);
	StarLaser(tmpObj, 180, sa+90+offset_angle, BGW_BEAM_YELLOW, 30, bt,
		shot_speed, -90, shot_graphic, shot_wt, seed);
}

function SetEnemyS01(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	if (flgStopSetZako) { return(-1); }
	
	let eSize = ENEMY_S;
	let objEnemy = MakeEnemy(iniX, iniY, 20, eSize);
	_SetEnemyS01(objEnemy, iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait);
	return(objEnemy);
}
function SetEnemyS01_Dummy(iniX, iniY, iniSpeed, iniAngle, iniValue, iniWait)
{
	let obj = CreateShotA1(iniX, iniY, 0, iniAngle, BGW_BALL_S_RED, 0);
	ObjMove_AddPatternA2(obj, iniWait, NO_CHANGE, NO_CHANGE, iniSpeed/120, 0, iniSpeed);
	SetShotDisabled(obj);
	ObjShot_SetAutoDelete(obj, false);
	ObjShot_SetSpellResist(obj, true);
	return(obj);
	
	task _SetEnemyS01_Dummy()
	{
		while(!Obj_IsDeleted(obj) && ObjMove_GetY(obj) < GetStgFrameHeight)
		{
			yield;
		}
		Obj_Delete(obj);
	}
}
