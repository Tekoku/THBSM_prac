		Obj_SetValue(objPos, "POS3", [[  57, 169],[  78,  -4],[ -44, -67]]);
		Obj_SetValue(objPos, "POS4", [[ 134, 136],[  75,  65],[ 132, -90],[ -22,-127]]);
		Obj_SetValue(objPos, "POS5", [[  65,  74],[ 156, -49]]);
		Obj_SetValue(objPos, "POS6", [[ 162,  20]]);
		// ライン（追加順の敵通しナンバー）
		Obj_SetValue(objPos, "LINE1", [[0, 1], [0, 2], [0, 3]]);
		Obj_SetValue(objPos, "LINE2", [[1, 4], [2, 5], [3, 6]]);
