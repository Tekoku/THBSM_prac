		Obj_SetValue(objPos, "LINE1", [[0, 1], [0, 2]]);
		Obj_SetValue(objPos, "LINE2", [[1, 2], [2, 3]]);
		Obj_SetValue(objPos, "LINE3", [[3, 4], [3, 5]]);
		Obj_SetValue(objPos, "LINE4", [[4, 6], [4, 7], [5, 8]]);
		Obj_SetValue(objPos, "LINE5", [[7, 9], [8, 9], [8, 10]]);
		Obj_SetValue(objPos, "LINE6", [[9, 11], [9, 12]]);
		Obj_SetValue(objPos, "LINE7", [[12, 13]]);
		count = 8;
	}
	case(6)
	{
		// --- オリオン座
		// 星
		Obj_SetValue(objPos, "POS1", [[0, 0]]);	// →↓の順に追加される
