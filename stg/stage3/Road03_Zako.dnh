	case(5)
	{
		// --- おおいぬ座
		// 星
		Obj_SetValue(objPos, "POS1", [[0, 0]]);	// →↓の順に追加される
		Obj_SetValue(objPos, "POS2", [[ -22, -37],[ -40,  -7]]);
		Obj_SetValue(objPos, "POS3", [[ -25,   5]]);
		Obj_SetValue(objPos, "POS4", [[  16,  20],[ -34,  59]]);
