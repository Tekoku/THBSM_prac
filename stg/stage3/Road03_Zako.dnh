	local
	{
		let tmp_delay = delay;
		max_delay = 60;
		loop(count-1)
		{
			max_delay += tmp_delay;
			tmp_delay = round(0.8*tmp_delay);
		}
	}
	T_Star();
	T_Line();
	
	task T_Star()
	{
		let base_delay = max_delay + 60;
		let tmp_delay = delay;
		let t = 1;
		loop
		{
			let POS = Obj_GetValueD(objPos, "POS"~IntToString(t), []);
			if (length(POS) <= 0) { break; }
			
			ascent(i in 0 .. length(POS))
			{
				let tmpObj = SetEnemyS01(baseX+POS[i][0], baseY+POS[i][1],
					iniSpeed, iniAngle, 0, base_delay);
				CallSound(sndShot2);
				// 追加
				Obj_SetValue(objPos, "ENM", Obj_GetValueD(objPos, "ENM", [])~[tmpObj]);
			}
			base_delay -= tmp_delay;
			wait(tmp_delay);
			tmp_delay = round(0.8*tmp_delay);
			t++;
		}
		wait(120);
		Obj_Delete(objPos);
	}
	task T_Line()
	{
		let graphic = BGW_BEAM_WHITE;
		let base_delay = max_delay-delay;
		let tmp_delay = delay;
		let t = 1;
		
		wait(delay);
		loop
		{
			let POS = Obj_GetValueD(objPos, "LINE"~IntToString(t), []);
			if (length(POS) <= 0) { break; }
			
			let ALL_ENM = Obj_GetValueD(objPos, "ENM", []);
			ascent(i in 0 .. length(POS))
			{
				StarLaser(ALL_ENM[POS[i][0]], ALL_ENM[POS[i][1]], graphic, base_delay);
			}
			base_delay -= tmp_delay;
			wait(tmp_delay);
			tmp_delay = round(0.8*tmp_delay);
			t++;
		}
	}
}
