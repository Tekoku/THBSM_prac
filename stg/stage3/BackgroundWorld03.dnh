//　Stage1
//--------------------------------------------------------------------------------
//--------------------------------------------------------------------------------

#include "./../../lib/wor_function.dnh"

let flagEnd = false;
let flgScriptValue = 0;

//　ステージの背景テクスチャ
let world03_path;

@Event
{
	alternative(GetEventType())
	case(ev_CloseScript)
	{
		//背景削除
		flagEnd = true;
		//ブラックアウト
		BlackOut( world_layer+1, 60, false, [0, 0, 0] );
		CloseMine(300);
	}
}

@Initialize
{
	init();	//初期設定
	
	// 画像パスをセット
	world03_path = LoadingImageFile_StgWorld(3);

	// 背景スクリプト起動
	if (IsDrawBackground() >= 2) { SetWorld03a(); }
	else if (IsDrawBackground() >= 1) { BackGroundLite(); }
}

@MainLoop
{
	yield;
}


task BackGroundLite
{
	let obj = ObjPrim_Create(OBJ_SPRITE_2D);
	let alpha = 0;
	Obj_SetRenderPriorityI(obj,world_layer);
	ObjRender_SetColor(obj,255,255,255);
	ObjPrim_SetTexture(obj,world03_path[0]);
	ObjSprite2D_SetSourceRect(obj,0,0,384,448);
	ObjSprite2D_SetDestRect(obj,0,0,384,448);
	while(alpha<255) {
		alpha+=5;
		ObjRender_SetAlpha(obj,alpha);
		yield;
	}
	while(!flagEnd)
	{
		yield;
	}
	Obj_Delete(obj);
}

task SetWorld03a(){
	// フェードイン
	BlackOut( world_layer+1, 60, true, [0, 0, 0] );

	let count		= 0;
	let move1		= 0;
	let moveA		= 0;
	let move2		= 0;
	let moveB		= 0;
	let move3		= 0;
	let moveC		= 0;
	
	let obj = [
		CreateTexture01( world03_path[0] ),
		CreateTexture01( world03_path[1] ),
		CreateTexture01( world03_path[2] ),
		CreateTexture01( world03_path[3] ),
	];
	
	ObjRender_SetPosition( obj[0], -512, 0, 0 );
	ObjRender_SetScaleXYZ( obj[0], 8, 8, 0 );
	ObjSprite3D_SetBillboard( obj[0], true );
	
	ObjRender_SetPosition( obj[1], 256, 0, 0 );
	ObjRender_SetAngleXYZ( obj[1], 90, 0, 0 );
	ObjRender_SetColor( obj[1], 255, 255, 255 );
	
	ObjRender_SetAlpha( obj[2], 192 );
	ObjRender_SetPosition( obj[2], 256-32, 0, 0 );
	ObjRender_SetAngleXYZ( obj[2], 270, 0, 0 );
	
	ObjRender_SetPosition( obj[3], 256-64, 0, 0 );
	ObjRender_SetAngleXYZ( obj[3], 90, 0, 0 );
	
	let scrspd;
	
	while( true ){
		move1 = 1 * sin( moveA );
		move2 = 1 * sin( moveB );
		move3 = 1 * sin( moveC );
		
		scrspd = 1 + move2*0.4 + move3/2;
		
		let fogw = [
			move1*640,
			move1*1000,
		];
		let fogcl = [
			96 + move3*32,
			128 + move3*32,
			128 + move3*32,
		];
		
		SetFogParam( fogw[0], fogw[1], fogcl[0], fogcl[1], fogcl[2] );
		SetCameraFocusXYZ( 256, 64, 0 );
		SetCameraRadius( 640 );
		SetCameraAzimuthAngle( 0 + 4 * sin( count/4 ) );
		SetCameraElevationAngle( 40 + 8 * sin( count/2 ) + move3*8 );
		
		ObjSprite3D_SetSourceDestRect( obj[1], 0 - count*scrspd, 0, 1024 - count*scrspd, 1024 );
		ObjSprite3D_SetSourceDestRect( obj[2], 0 - count*scrspd*1.4,0, 1024 - count*scrspd*1.4, 1024 );
		ObjSprite3D_SetSourceDestRect( obj[3], 0 - count*scrspd*1.6, 0, 1024 - count*scrspd*1.6, 1024 );
		
		ObjRender_SetAlpha( obj[2], 192 + 63*sin(count*4) );
		ObjRender_SetAlpha( obj[3], 192 + 63*cos(count*2) );
		
		if( count%2 == 0 ){
				CreateFlashLight( [randEffect(0,512),randEffect(-256,256),randEffect(-256,256)],
									[randEffect(0.1,8)+scrspd/2,randEffect(-0.1,0.1),randEffect(-0.2,0.2)],
									randEffect(0.1,0.14), randEffect(128,192), 60+randEffect(0,240),
									[randEffect(128,255),randEffect(128,255),255] );
		}
		
		//　雲の作成
		if( count%32 == 0 ){
			CreateCloud( [randEffect(0,-512),194,randEffect(-384,384)], [randEffect(2,4),-1,randEffect(-1,1)], randEffect(2,3), 60 + randEffect(0,120),
							[randEffect(128,255),randEffect(128,255),240], 128 );
		}
		
		count++;
		if( move1 < 1 ){ moveA += 1; }
		if( move1 >= 1 && move2 < 1 ){ moveB += 0.1; }
		if( move2 >= 1 && move3 < 1 ){ moveC += 0.1; }
		
		yield;
	}
	ascent( let i in 0..length(obj) ){
		Obj_Delete( obj[i] );
	}
}
