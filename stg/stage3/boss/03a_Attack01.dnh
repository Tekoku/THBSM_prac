#東方弾幕風[Single]
#ScriptVersion[3]
#Title["シェリア中ボス通常"]
#Text["シェリア中ボス通常"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./lib_Shelia.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(1800);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(20);		}
	BossEvent();
}

@Initialize {
	bossDropItem = 0;	//アイテム数
	
	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_SHELIA);	//ボスセット
	
	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	standBy(objEnemy, CenX, 140, 15);
	
///	BossCharge(objEnemy);
//	wait(60);
	wait(15);
	
	let wt = [120, 60, 30, 30][Difficult];
	
	let muki = 1;
	while(eAlive)
	{
		SetFamilier01(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy)-32, 90, muki);
		wait(90);
		if (!eAlive) { return; }
		ShotString(muki);
		wait(wt);
		if (!eAlive) { return; }
		EnemyRandomMove(objEnemy, 140, 48);
		wait(60);
		muki = -muki;
	}
}

// ライン
task ShotString(muki)
{
	let speed = 3;
	let count = 15;
	let x_count = [5, 5, 7, 7][Difficult];
	
	StringSet(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy), speed, 90,
		ADD_BGW_ICE_WHITE, 15, count, x_count, muki);
	CallSound(sndShot7);
}

task StringSet(x, y, speed, angle, graphic, delay, count, x_count, muki)
{
	ascent(i in 0 .. x_count)
	{
		if (!eAlive) { return; }
		let tmp = (i-(x_count-1));
		let x_wid = CenX / x_count * tmp;
		let sx = x + cos(angle+90*muki)*x_wid;
		let sy = y + sin(angle+90*muki)*x_wid;
		StringShot(sx, sy, speed, angle, graphic, delay, count);
		wait(5);
	}
}
task StringShot(x, y, speed, angle, graphic, delay, count)
{
	ascent(i in 0 .. count)
	{
		if (!eAlive) { return; }
		let ss = speed * (0.1+i/(count-1));
		let ss2 = speed * (2-i/(count-1));
		let timer = 120 + i*2;
		let obj = CreateShotA1(x, y, ss, angle, graphic, delay);
		ObjMove_AddPatternA2(obj, timer, NO_CHANGE, NO_CHANGE, (ss2-ss)/30, 0, ss2);
		wait(2);
	}
}




// 使い魔
task SetFamilier01(iniX, iniY, iniAngle, iniValue)
{
	let eSize = ENEMY_S;
	let eColor = EFF_PURPLE;
	let item_count = 0;
	let item_star = 0;
	
	let objFamilier = MakeEnemyFamilier(iniX, iniY, 300, eSize);
	SetDropItemCount(objFamilier, item_count, item_star);
	DrawStarEnemy(objFamilier, 3, 1.5);
//	DrawSheliaCircle(objFamilier, iniValue);
	TAct();
	WaitForKilledFamilier(objFamilier, 0, 0);
	ZakoFinalize(objFamilier, eColor);
	
	task TAct()
	{
		TShot();
		TMove();
	}
	
	// 移動
	task TMove()
	{
		let muki = iniValue;
		let move_angle = iniAngle - muki*135;
		
		let timer = 240;
		ascent(i in 0 .. timer)
		{
			if (!CanShotBullet(objFamilier)) { return; }
			let tmp = (i+1)/timer;
			ObjMove_SetAngle(objFamilier, move_angle);
			ObjMove_SetSpeed(objFamilier, (1-tmp)^0.5*2.25);
			move_angle += sin(tmp*360)*2*muki;
			yield;
		}
		wait(60);
		EraseEnemy(objFamilier);
	}
	
	// ショット
	task TShot()
	{
		wait(5);
		
		let timer = 240;
		
		let speed = [2, 2.25, 2.75, 3][Difficult];
		let way = [3, 5, 5, 7][Difficult];
		let way_angle = 300/way;
		let wt = [8, 7, 5, 5][Difficult];

		let speed2 = 2.5;
		let way2 = 0;
		
		let graphic = [ADD_BGW_STAR_S_SKY, BGW_STAR_S_SKY];
		let graphic2 = [ADD_BGW_CROSS_YELLOW, BGW_CROSS_YELLOW];
		let shot_delay = timer*0.5;
		
		let t = 0;
		while(CanShotBullet(objFamilier) && t < timer)
		{
			let ba = ObjMove_GetAngle(objFamilier);
			if (way > 0)
			{
				ascent(i in 0 .. way)
				{
					let sa = ba + (i-(way-1)/2)*way_angle;
					SheliaNoteShot(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
						speed, sa, graphic[0], 15, graphic[1], shot_delay);
				}
			}
			if (way2 > 0)
			{
				ascent(i in 0 .. 5)
				{
					let sa = ba + i*360/5;
					SheliaNoteShot(ObjMove_GetX(objFamilier), ObjMove_GetY(objFamilier),
						speed2, sa, graphic2[2], 15, graphic2[3], shot_delay);
				}
			}
			CallSound(sndShot2);

			wait(wt);
			t += wt;
			shot_delay -= wt/3;
		}
	}
}

task SheliaNoteShot(x, y, speed, angle, graphic, delay, graphic2, timer)
{
	let obj = CreateShotA2(x, y, 2, angle, -2/delay, 0.25, graphic, 0);
	ObjMove_AddPatternA3(obj, timer, NO_CHANGE, NO_CHANGE, speed/90, 0, speed, graphic2);
	My_RaiseShotEffectA(obj, delay);
}
