#東方弾幕風[Single]
#ScriptVersion[3]
#Title["オーガスト"]
#Text["ブチ切れますわよ"]
#Background[""]
#System["./../../../system/System.dnh"]

//---------------------------------------------------------------------

// 関数取り込み
#include"./../../../lib/lib_boss.dnh"
#include"./lib_Shelia.dnh"

@Event {
	alternative(GetEventType())
	case(EV_REQUEST_LIFE)		{ SetScriptResult(700);	}
	case(EV_REQUEST_TIMER)		{ SetScriptResult(45);		}
	BossEvent();
}

@Initialize {
	dIni_Shot = 20;		//ダメージ透過率
	
	Boss_Init();	//初期設定
	objEnemy = CreateBoss(BOSS_ID_SHELIA);	//ボスセット
	//スペカデータ・セット
	SetSpellCardData(GetSpellCardID(25), [12,12,12,13][Difficult], 
			GetCurrentScriptDirectory()~"03a_Background.dnh",
			GetBossTexture(objEnemy, I_CUTIN), 1, CUTMOTION_NORMAL);

	Task_Main();
}

@MainLoop {
	yield;
}

// メインタスク
task Task_Main
{
	standBy(objEnemy, CenX, 140, 60+150);
	wait(60);
	
	CallSpellCard(true);	//スペカ起動
	BossCharge(objEnemy);
	wait(120);
	
	let speed = [5, 5, 7, 8][Difficult];
	let count = [14, 14, 14, 14][Difficult];
	let shot_wt = 4;
	
	let wt = [90, 90, 85, 75][Difficult];
	let wt_min = [50, 40, 38, 35][Difficult];
	
	let muki = 1;
	let t = 0;
	while(eAlive)
	{
		let base_angle = rand(0, 360);
		let to_angle = 90 + 15*muki;
		TShot_sub(speed, base_angle, to_angle, 150, count, shot_wt, t);
		t++;
		muki = -muki;
		
		let timer_rate = ObjEnemyBossScene_GetInfo(objScene, INFO_TIMERF) / ObjEnemyBossScene_GetInfo(objScene, INFO_ORGTIMERF);
		let life_rate = GetBossLifeRate(objEnemy);
		let rt = min(timer_rate, life_rate);
		
		let tmp_wt = wt - (wt-wt_min)*min(1, (1-rt)/0.75);
		wait(tmp_wt);
	}
}

task TShot_sub(speed, base_angle, to_angle, timer, count, shot_wt, color_type)
{
	ascent(t in 0 .. count)
	{
		if (!eAlive) { return; }
		let tmp = (t+0.5)/count;
		let va = base_angle + tmp*360 + t*180;
		let vr = tmp^0.5*12;
		let vx = cos(va)*vr;
		let vy = (sin(va)-2)*vr/8;
		let ss = (vx^2+vy^2)^0.5;
		let sa = atan2(vy, vx) + (to_angle-90);
		let ta = to_angle;
		if (GetPlayerY < ObjMove_GetY(objEnemy)) { sa += 180; ta += 180; }
		BigStarShot(ObjMove_GetX(objEnemy), ObjMove_GetY(objEnemy),
			ss, sa, 15, ta, speed*rand(0.75,1), timer-t*shot_wt, color_type);
		CallSound(sndShot2);
		wait(shot_wt);
	}
	wait(timer-count*shot_wt);
	if (eAlive) { CallSound(sndShot4); }
}


task BigStarShot(x, y, speed, angle, delay, to_angle, to_speed, timer, color_type)
{
	let graphic = [BGW_STAR_M_BLUE, BGW_STAR_M_YELLOW, BGW_STAR_M_SKY][color_type%3];
	let graphic2 = [BGW_SCALE_BLUE, BGW_SCALE_YELLOW, BGW_SCALE_SKY][color_type%3];
	
	let obj = CreateShotA2(x, y, speed, angle, -speed/60, 0, graphic, 0);
	ObjMove_AddPatternA2(obj, 60, NO_CHANGE, to_angle, 0.5/30, 0, 0.5);
	ObjMove_AddPatternA2(obj, timer, NO_CHANGE, to_angle, to_speed/45, 0, to_speed);
	My_RaiseShotEffectA(obj, 60);
	ObjShot_SetAutoDelete(obj, false);

	wait(timer);
	if (Obj_IsDeleted(obj)) { return; }
	ascent(i in 0 .. 5)
	{
		BigStarShot_effect2(obj, graphic2, 60, i*72);
	}
	
	// 当たり判定用
	let objLaser = CreateStraightLaserA1(ObjMove_GetX(obj), ObjMove_GetY(obj), ObjMove_GetAngle(obj)+180, 0, 0, 9999, graphic2, 0);
	ObjStLaser_SetSource(objLaser, false);
	ObjLaser_SetGrazeInvalidFrame(objLaser, defaultLaserGraze);
	Obj_SetVisible(objLaser, false);
	
	let l_len = 0;
	let t = 0;
	while(!Obj_IsDeleted(obj))
	{
		if (t%3 == 0)
		{
			let l_wid = min(24, 4+t/2);
			BigStarShot_effect(ObjMove_GetX(obj), ObjMove_GetY(obj),
				ObjMove_GetAngle(obj)+rand(-5,5)+180, ObjMove_GetSpeed(obj)*12, l_wid, graphic2, 30);
		}
		ObjMove_SetPosition(objLaser, ObjMove_GetX(obj), ObjMove_GetY(obj));
		ObjLaser_SetRenderWidth(objLaser, 12);
		ObjLaser_SetLength(objLaser, ObjMove_GetSpeed(obj)*32);
		
		if (t > 60)
		{
			ObjShot_SetAutoDelete(obj, true);
		}
		t++;
		yield;
	}
	Obj_Delete(objLaser);
}


// えへくと用
task BigStarShot_effect(x, y, angle, l_len, l_wid, graphic, timer)
{
	let objLaser = CreateStraightLaserA1(x, y, angle, l_len, l_wid, timer, graphic, 0);
	ObjStLaser_SetSource(objLaser, false);
	ObjRender_SetAlpha(objLaser, 64);
	ObjShot_SetIntersectionEnable(objLaser, false);
	ObjShot_SetItemChange(objLaser, false);
	
	descent(t in 0 .. timer)
	{
		let tmp = (t+1)/timer;
		ObjLaser_SetRenderWidth(objLaser, l_wid*tmp);
		ObjLaser_SetLength(objLaser, l_len*(1+tmp));
		yield;
	}
	Obj_Delete(objLaser);
}

task BigStarShot_effect2(parent, graphic, timer, angle)
{
	let obj = CreateShotA1(ObjMove_GetX(parent), ObjMove_GetY(parent), 0, ObjMove_GetAngle(parent)+angle, graphic, 0);
	SetShotDisabled(obj);
	ObjRender_SetBlendType(obj, BLEND_ADD_ARGB);
	Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI()+1);

	ascent(t in 0 .. timer)
	{
		if (Obj_IsDeleted(parent)) { break; }
		let tmp = (t+1)/timer;
		let tmp_s = (1-tmp)^2*12;
		ObjRender_SetScaleXYZ(obj, tmp_s, tmp_s, 1);
		ObjRender_SetAlpha(obj, tmp*96);
		ObjRender_SetPosition(obj, ObjMove_GetX(parent), ObjMove_GetY(parent), 0);
		yield;
	}
	Obj_Delete(obj);
}
