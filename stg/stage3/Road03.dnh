#東方弾幕風[Stage]
#ScriptVersion[3]
#Title["Stage3道中"]
#Text["Stage3道中"]
#System["./../../system/System.dnh"]

#include "./../../lib/lib_Common.dnh"
#include "./../../lib/lib_Stage.dnh"
#include "./../../lib/lib_Zako.dnh"
#include "./Road03_Zako.dnh"


@Initialize
{
	STAGE_ID = 3;		//ステージID記録
	NEXT_STAGE_ID = 4;	//次のステージIDを記録
	SetLastWordBorder(1333);	//ラスワ条件
	StageInit();
	TStage();
}

@Event()
{
	StageEvent();
}

@Loading
{
}

@MainLoop
{
	yield;
}

task TStage
{
	// 保険
	yield;
	
	let dir = GetCurrentScriptDirectory();
	let pathBG	= dir ~ "BackgroundWorld03.dnh";	//背景
	let pathMBoss	= dir ~ "boss/03a_plural.dnh";	//中ボス
	let pathBoss	= dir ~ "boss/03b_plural.dnh";	//ボス
	
	//　中ボスロード
	// practice tool: chapter skip
	let dest = GetStartChapter(3);
	if(dest <= 5)
	{
		StartScriptInThread(pathMBoss);
	}
	else
	{
		StartScriptInThread(pathBoss);
	}
	
	//  背景配置
	SetStageBackGround(pathBG);
	
	wait(75);
	if(dest <= 7)
	{
		PlayMusicWithName(6, 120, 45);
	}
	else
	{
		PlayMusicWithName(7, 30, 30);
	}

	// タイトル
	if(dest <= 1){ DisplayStage03( 0, 90 ); }	// practice tool: skip title anim on chapter jump

	ChapterStart();
// ------------------------ 前半
	if(dest <= 1)
	{
		CHAPTER_1();
	}
	if(dest <= 2)
	{
		CHAPTER_2();
	}
	if(dest <= 3)
	{
		CHAPTER_3();
	}

// ------------------------ 中ボス
	if(dest <= 5)
	{
		CHAPTER_MBOSS(pathBoss);
	}

// ------------------------ 早回し
	if(dest <= 6)
	{
		CHAPTER_4();
	}

// ------------------------ 後半
	if(dest <= 7)
	{
		CHAPTER_5();
	}

// ------------------------ ボスだぞー！
	// practice tool: wait for boss script ready when jumping directly to boss
	if(dest >= 8){ wait(150); }
	CallBoss();

	// 待機とロード
	WaitForBossKilled();
	wait(30);

	StageEND();
}


function CHAPTER_1()
{
	WaitRoad(212-26+26*2);
	S01([CenX-60,60], [CenX+50,100], 6, 26);
	WaitRoad(6*26);
	S01([CenX+180,100], [CenX-50,160], 8, 26);
	WaitRoad(8*26);
	S01([CenX-180,160], [CenX+50,220], 8, 26);
	WaitRoad(8*26);
	S01([CenX+180,220], [CenX+60,250], 4, 26);
	WaitRoad(180+26);
	TSetCon(CenX+64, CenY-128, 0, 90+30);
	WaitRoad(270);
	TSetCon(CenX-96, CenY-64, 2, 90-15);
	WaitRoad(240);
	ChapterFinish();
	WaitRoad(30);
}

function CHAPTER_2()
{
	I01([CenX-100,MaxY+32,-90-15],[CenX+50,MaxY+32,-90+5], 10, 15);
	WaitRoad(210);
	I01([CenX+100,MaxY+32,-90+15],[CenX-50,MaxY+32,-90-5], 10, 15);
	WaitRoad(210);
	I01([CenX-100,MaxY+32,-90-15],[CenX+50,MaxY+32,-90+5], 10, 15);
	WaitRoad(210);
	I01([CenX+100,MaxY+32,-90+15],[CenX-50,MaxY+32,-90-5], 10, 15);
	WaitRoad(60);
	TSetCon(CenX+32, CenY-128, 3, 90+60);
	WaitRoad(210-60);
	I01([CenX-100,MaxY+32,-90-15],[CenX+50,MaxY+32,-90+5], 10, 15);
	WaitRoad(60);
	TSetCon(CenX, CenY-192, 4, 30);
	WaitRoad(210-60);
	I01([CenX+100,MaxY+32,-90+15],[CenX-50,MaxY+32,-90-5], 10, 15);
	WaitRoad(60);
	TSetCon(CenX+96, CenY-128, 5, 90+15);
	WaitRoad(300);
	ChapterFinish();
	WaitRoad(30);
}

function CHAPTER_3()
{
	I02([-32,120,30],[-32,30,30], 10, 12);
	WaitRoad(195);
	I02([MaxX+32,120,180-30],[MaxX+32,30,180-30], 10, 12);
	WaitRoad(195);
	I02([-32,120,30],[-32,30,30], 10, 12);
	TSetCon(CenX+32, CenY-192, 7, 180-30);
	WaitRoad(195);
	I02([MaxX+32,120,180-30],[MaxX+32,30,180-30], 10, 12);
	TSetCon(CenX, CenY-64, 10, 45);
	WaitRoad(195);
	I02([-32,120,30],[-32,30,30], 10, 12);
	TSetCon(CenX+64, CenY-140, 11, 90+15);
	WaitRoad(195);
	I02([MaxX+32,120,180-30],[MaxX+32,30,180-30], 10, 12);
	TSetCon(CenX-64, CenY-160, 12, 90-25);
	WaitRoad(240);
	TSetCon(CenX, CenY-96, 8, 90);
	WaitRoad(300);
	ChapterFinish();
	WaitRoad(60);
}

task CHAPTER_MBOSS(pathBoss)
{
	// ボスがでたぞー
	// practice tool: wait for midboss script ready when jumping directly to midboss
	if(GetStartChapter(3) >= 4){ wait(150); }
	CallBoss();
	flgStopSetZako = true;
	// 中ボスが消えてからボスをロード
	StartScriptInThreadWaitBoss(pathBoss);
	
	// ボス撃破待ち
	CheckBossKilled();
	WaitForMiddleBossKilled();
	
	flgStopSetZako = false;
}


function CHAPTER_4()
{
	let dest = GetStartChapter(3);
	if(dest < 6)
	{
	WaitRoad(60*12);
	
	I01b([CenX-32,MaxY+32,-90-30],[CenX+120,MaxY+32,-90], 10, 15);
	WaitRoad(180);
	I01b([CenX+32,MaxY+32,-90+30],[CenX-120,MaxY+32,-90], 10, 15);
	WaitRoad(180);
	I01b([CenX-32,MaxY+32,-90-30],[CenX+120,MaxY+32,-90], 10, 15);
	WaitRoad(180);
	I01b([CenX+32,MaxY+32,-90+30],[CenX-120,MaxY+32,-90], 10, 15);
	WaitRoad(240);
	I02([-32,30,30],[-32,240,-30], 12, 12);
	WaitRoad(180);
	I02([MaxX+32,30,180-30],[MaxX+32,240,180+15], 12, 12);
	WaitRoad(180);
	I02([-32,30,30],[-32,240,-30], 12, 12);
	WaitRoad(180);
	I02([MaxX+32,30,180-30],[MaxX+32,240,180+15], 12, 12);
	WaitRoad(180);
	WaitForMiddleBossKilled();	// 中ボス撃破待ち
	}
	WaitRoad(60);
	
	I01b([CenX-32,MaxY+32,-90-30],[CenX+120,MaxY+32,-90], 10, 15);
	TSetCon(CenX+48, CenY-128, 14, 90+30);
	WaitRoad(180);
	I01b([CenX+32,MaxY+32,-90+30],[CenX-120,MaxY+32,-90], 10, 15);
	TSetCon(CenX-64, CenY-64, 15, 90-30);
	WaitRoad(180);
	TSetCon(CenX, CenY-128, 13, -75);
	WaitRoad(360);
	ChapterFinish();
	WaitRoad(30);
}

function CHAPTER_5()
{
	S02(15, 1260);
	WaitRoad(420);
	TSetCon(CenX-128, CenY-128, 1, 120);
	WaitRoad(420);
	TSetCon(CenX, CenY-96, 6, -30);
	WaitRoad(420);
	TSetCon(CenX-96, CenY-16, 9, 15);
	WaitRoad(360);
	ChapterFinish();
	WaitRoad(60);
}


// 敵配置用 [pos]=[x,y,angle]
task I01(pos1, pos2, count, wt)
{
	ascent(i in 0 .. count)
	{
		let tmp = i/(count-1);
		let ex = pos1[0]*(1-tmp) + pos2[0]*tmp;
		let ey = pos1[1]*(1-tmp) + pos2[1]*tmp;
		let ea = pos1[2]*(1-tmp) + pos2[2]*tmp;
		SetEnemyI01(ex, ey, 5, ea, 0, 0);
		wait(wt);
	}
}
task I01b(pos1, pos2, count, wt)
{
	ascent(i in 0 .. count)
	{
		let tmp = i/(count-1);
		let ex = pos1[0]*(1-tmp) + pos2[0]*tmp;
		let ey = pos1[1]*(1-tmp) + pos2[1]*tmp;
		let ea = pos1[2]*(1-tmp) + pos2[2]*tmp;
		SetEnemyI01(ex, ey, 5, ea, 1, 0);
		wait(wt);
	}
}
task I02(pos1, pos2, count, wt)
{
	ascent(i in 0 .. count)
	{
		let tmp = i/(count-1);
		let ex = pos1[0]*(1-tmp) + pos2[0]*tmp;
		let ey = pos1[1]*(1-tmp) + pos2[1]*tmp;
		let ea = pos1[2]*(1-tmp) + pos2[2]*tmp;
		SetEnemyI02(ex, ey, 5, ea, i, 0);
		wait(wt);
	}
}
task S01(pos1, pos2, count, wt)
{
	let ba = atan2(CenY-pos1[1],CenX-pos1[0]);
	ascent(i in 0 .. count)
	{
		let tmp = i/(count-1);
		let tmp_a = ba + tmp*1080;
		let tmp_r = min(1, sin(tmp*180)*2)*16;
		let ex = pos1[0]*(1-tmp) + pos2[0]*tmp + sin(tmp_a)*tmp_r;
		let ey = pos1[1]*(1-tmp) + pos2[1]*tmp + cos(tmp_a)*tmp_r;
		SetEnemyS02(ex, ey, 2, 0, i, 90);
		wait(wt);
	}
}
task S02(wt, timer)
{
	let i = 0;
	let tm = timer;
	while(tm > 0)
	{
		let tmp_base = sin(i/37*941+15);
		let ex = (tmp_base*467)%MaxX;
		let ey = MinY-32;
		SetEnemyS03(ex, ey, 2, 0, i, 0);
		tm -= wt;
		i++;
		wait(wt);
	}
}
