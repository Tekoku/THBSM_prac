// --------------------  アイテムスクリプト
#include "./lib/lib_Common.dnh"
#include "./lib/lib_Util.dnh"
#include "./../lib/lib_Item.dnh"
#include "./../lib/lib_Sound.dnh"

let objPlayer;

//  ユーザーアイテム
let datItemData = GetCurrentScriptDirectory() ~ "./lib/Dat_ItemData.dnh";

// 小アイテム取得時のカウント（10個取得毎に最大得点+10）
let MiniItemCount	= 0;

// 星アイテムの最大得点加算値
let StarMaxScore	= 10;

// ボム、残機の最大値
let plLifeMax = 8;
let plSpellMax = 8;

//  弾消しエフェクトのカラー
let EFFECT_COLOR = [
	[200, 200, 200],	// 白	(IDが16n)
	[255,   0,   0],	// 赤
	[  0, 255,   0],	// 緑
	[  0,   0, 255],	// 青
	[220, 220,   0],	// 黄
	[240,   0, 240],	// 紫
	[  0, 240, 240],	// 水
	[250, 140,   0]		// 橙
];

@Initialize{

	//  スクリプトID記録
	SetSystemScriptID("ScriptItem");
	
	//　弾削除時得点アイテム自動作成無効化
	SetDefaultBonusItemEnable( false );
	
	//　ユーザ定義アイテムデータ読み込み
	LoadItemData( datItemData );
	
	//星アイテムの最大得点セット
	SetStarMaxScore();
}

@MainLoop{
	yield;
}

@Event
{
	alternative( GetEventType() )
	//　アイテムゲット時のイベント
	case( EV_GET_ITEM )
	{
		let ItemType	= GetEventArgument(0);	//　アイテム種別取得
		let ObjItem	= GetEventArgument(1);	//　アイテムオブジェクト取得
		GetItemEvent( ObjItem, ItemType );
	}
	//　ユーザーイベント用アイテム取得
	case( ev_GetItem )
	{
		let ItemType	= GetEventArgument(0);	//　アイテム種別取得
		GetItemEvent( -1, ItemType );
	}
	//　アイテム生成イベント
	case( ev_CallItem )
	{
		let tmp	= GetEventArgument(0);	//　[x, y, item_type]
		alternative( tmp[2] )
		case( MY_ITEM_SPELL_S, MY_ITEM_LIFE_S, MY_ITEM_SPELL, MY_ITEM_LIFE )
		{
			CreateAutoCaptureItem( tmp[2], [tmp[0], tmp[1]], 1, 0 );
			CallSound(sndItemSpecial);
		}
	}
	case( ev_CallItemEx )
	{
		let tmp	= GetEventArgument(0);	//　[x, y, speed, angle, item_type]
		alternative( tmp[4] )
		case( MY_ITEM_POINT )
			{ CreateNormalItem(tmp[4], tmp[0], tmp[1], tmp[2], tmp[3], false); }
		case( MY_ITEM_WISH )
			{ CreateFortuneItem(tmp[4], tmp[0], tmp[1], tmp[2], tmp[3], false, 1, 1 ); }
		case( MY_ITEM_WISH_EX )
		{
			CreateFortuneItem(tmp[4], tmp[0], tmp[1], tmp[2], tmp[3], true, 1.5, 1 );
			// 取得予定アイテム数に加算
			SetAreaCommonData(CAREA_STAGE, "FieldWishItemEX",
				GetAreaCommonData(CAREA_STAGE, "FieldWishItemEX", 0)+1);
		}
		case( MY_ITEM_POINT_S )
		{
			let objItem = My_CreateItem(MY_ITEM_POINT_S, tmp[0], tmp[1], 0);
			ObjRender_SetAngleZ(objItem, rand(0, 360));
			My_BulletItemMotion(objItem, tmp[2], tmp[3]);
		}
	}
	//  弾削除時アイテム生成イベント
	case(EV_DELETE_SHOT_TO_ITEM)
	{
		let objShot = GetEventArgument(0);
		let objPos = GetEventArgument(1);	//弾オブジェクト座標取得([0]=x, [1]=y)
		//多重呼び出し対策
		if (!Obj_IsDeleted(objShot)) { ShotToItem(objPos[0], objPos[1], objShot); }
	}
	//　弾消しエフェクト（任意）のイベント
	case( ev_BulletEffect )
	{
		let tmp	= GetEventArgument(0);	//　弾オブジェクトID
		//弾消しエフェクト
		ShotEraseEffect(ObjMove_GetX(tmp), ObjMove_GetY(tmp), ObjShot_GetImageID(tmp));
		Obj_Delete(tmp);
	}
}


//----------------------------------------------------
//　アイテムゲット時のイベント
//----------------------------------------------------
function GetItemEvent(objItem, itemType)
{
	alternative(itemType)
	case( MY_ITEM_LIFE_S )
	{
		//　残機のかけら取得時
		let frgmt = GetAreaCommonData(CAREA_SYSTEM, "FragmentPlayer", 0 );
		let nel = GetAreaCommonData(CAREA_SYSTEM, "FragmentPlayer_Next", 99 );
		// 最大値の場合、スコアに換算
		if (GetPlayerLife() >= plLifeMax && frgmt+1 >= nel)
		{
			AddScore_byLife(1);
		} else {
			frgmt += 1;
			SetAreaCommonData(CAREA_SYSTEM, "FragmentPlayer",  frgmt);
		}
	}
	case( MY_ITEM_SPELL_S )
	{
		//　ボムのかけら取得時
		let frgmt = GetAreaCommonData(CAREA_SYSTEM, "FragmentSpell", 0 );
		let nel = GetAreaCommonData(CAREA_SYSTEM, "FragmentSpell_Next", 99 );
		// 最大値の場合、スコアに換算
		if (GetPlayerSpell() >= plSpellMax && frgmt+1 >= nel)
		{
			AddScore_byLife(1);
		} else {
			frgmt += 1;
			SetAreaCommonData(CAREA_SYSTEM, "FragmentSpell",  frgmt);
		}
	}
	case( MY_ITEM_LIFE )
	{
		//　残機取得時
		// 最大値の場合、スコアに換算
		if (GetPlayerLife() >= plLifeMax)
		{
			AddScore_byLife(3);
		} else {
			SetPlayerLife(GetPlayerLife()+1);
		}
	}
	case( MY_ITEM_SPELL )
	{
		//　ボム取得時
		// 最大値の場合、スコアに換算
		if (GetPlayerSpell() >= plSpellMax)
		{
			AddScore_byLife(3);
		} else {
			SetPlayerSpell(GetPlayerSpell()+1);
		}
	}
	case( MY_ITEM_POINT )
	{
		// 得点加算
		let tmp_score = GetMaxScoreEx();
		if (!Obj_GetValueD(objItem, "AUTO", false)) { tmp_score *= (1 - max(0, GetPlayerY-GetPlayerAutoItemCollectLine())/GetStgFrameHeight); }
		tmp_score = round(tmp_score/10)*10;
		AddScore(tmp_score);
		// 効果音
		CallSound(sndScore);
	}
	case( MY_ITEM_WISH )
	{
		AddWishItemCount(1);
		AddChapterItem(1);
		AddMaxScore(StarMaxScore);
		// 効果音
		CallSound(sndScore);
	}
	case( MY_ITEM_WISH_EX )
	{
		AddWishItemCount(1);
		AddChapterItem(1);
		AddMaxScore(StarMaxScore);
		// 効果音
		CallSound(sndScore);
		// 取得予定アイテム数から減算
		SetAreaCommonData(CAREA_STAGE, "FieldWishItemEX",
			GetAreaCommonData(CAREA_STAGE, "FieldWishItemEX", 0)-1);
	}
	case( MY_ITEM_POINT_S )
	{
		let rate = Obj_GetValueD(objItem, "RATE", 1);
		//  弾消しアイテム取得時
		let tmp_score = trunc(GetMaxScoreEx()*rate/1000)*10;
		AddScore(tmp_score);
		// 最大得点アップ
		MiniItemCount += 1*rate;
		if (MiniItemCount >= 10)
		{
			MiniItemCount -= 10;
			AddMaxScore(10);
		}
		// 効果音
		CallSound(sndScore2);
	}
}

// 欠片→スコア換算
function AddScore_byLife(mul)
{
	AddMaxScore(trunc(77*mul/10)*10);
	
	let tmp_score = GetMaxScoreEx();
	tmp_score = trunc(tmp_score*7.77*mul/10)*10;
	AddScore(tmp_score);
	
	SetSystemAscii02(0.75, [220,220,255], 120, "SCORE +"~IntToString(tmp_score));
//	SetSystemAscii(GetScreenWidth-8, 88, 0.6, [220,220,255], 120, "SCORE +"~IntToString(tmp_score));
	
	CallSound(sndExtOther);
}

//----------------------------------------------------
//　アイテム作成
//----------------------------------------------------
task CreateAutoCaptureItem( ID, pos, scale, score ){
	let obj	= My_CreateItem( ID, pos[0], pos[1], 0 );
	ObjMove_AddPatternA2(obj, 0, -4, 90, 0.1, 0, 0);
	Obj_SetRenderPriorityI(obj, 70);	// 前面に表示
	
	let t = 0;
	while( !Obj_IsDeleted(obj) )
	{
		if( t < 45 )
		{
			let tmp = (t+1)/45;
			let tmp_s = min(1, tmp*2)*scale;
			ObjRender_SetAngleXYZ(obj, 0, 0, tmp*720 );
			ObjRender_SetScaleXYZ(obj, tmp_s, tmp_s, 1 );
		}
		if (t > 60 && GetPlayerState() == STATE_NORMAL)
		{
			My_ItemMotionToPlayer(obj, 15);
			if (Obj_IsDeleted(obj)) { break; }
			// 途中で被弾した場合
			ObjMove_SetAngle(obj, 90);
			ObjMove_SetSpeed(obj, 0.5);
			ObjMove_SetMaxSpeed(obj, 0.5);
		}
		t++;
		yield;
	}
}

//----------------------------------------------------
//  ユーザーアイテム（通常アイテム）
//----------------------------------------------------
task CreateNormalItem( itemID, x, y, speed, angle, auto_collect )
{
	let obj	= My_CreateItem( itemID, x, y, 0 );

	let vx = cos(angle) * speed;
	let vy = sin(angle) * speed;
	// モーション
	ObjMove_AddPatternA2(obj, 0, -4, 90, 0.1, 0, 0);
	ObjMove_AddPatternA2(obj, 40, NO_CHANGE, NO_CHANGE, 0.025, 0, 2);

	let t = 0;
	while( !Obj_IsDeleted(obj) )
	{
		if (t < 45)
		{
			let tmp = (45-t)/45;
			ObjMove_SetX(obj, ObjMove_GetX(obj)+vx*tmp);
			ObjMove_SetY(obj, ObjMove_GetY(obj)+vy*tmp);
		}
		else if (GetPlayerState() == STATE_NORMAL)
		{
			if( flgItemAutoCollect() || auto_collect || Obj_GetValueD(obj, "AUTO", false) )
			{
				Obj_SetValue(obj, "AUTO", true);	// オートコレクトフラグON（最大得点化）
				My_ItemMotionToPlayer(obj, 10);
				if (Obj_IsDeleted(obj)) { break; }
				// 途中で被弾した場合
				Obj_SetValue(obj, "AUTO", false);
				ObjMove_SetAngle(obj, 90);
				ObjMove_SetSpeed(obj, 0);
				ObjMove_SetAcceleration(obj, 0.025);
				ObjMove_SetMaxSpeed(obj, 2);
			}
			else if( GetObjectDistance(obj, GetPlayerObjectID()) <= GetPlayerItemCollectRange() )
			{
				My_ItemMotionToPlayer(obj, 10);
				if (Obj_IsDeleted(obj)) { break; }
				// 途中で被弾した場合
				ObjMove_SetAngle(obj, 90);
				ObjMove_SetSpeed(obj, 0);
				ObjMove_SetAcceleration(obj, 0.025);
				ObjMove_SetMaxSpeed(obj, 2);
			}
		}
		if (t < 30)
		{
			let tmp = (t+1)/30;
			ObjRender_SetAngleZ(obj, tmp*1080);
			ObjRender_SetAlpha(obj, tmp*255 );
		}
		t++;
		yield;
	}
}

//----------------------------------------------------
//  ユーザーアイテム（願いアイテム）
//----------------------------------------------------
task CreateFortuneItem( itemID, x, y, speed, angle, auto_collect, scale, count )
{
	let obj	= My_CreateItem( itemID, x, y, 0 );
	ObjRender_SetScaleXYZ( obj, scale, scale, 1 );
	Obj_SetValue( obj, "ADD_COUNT", count );
	Obj_SetRenderPriorityI( obj, 61 );

	let vx = cos(angle) * speed;
	let vy = sin(angle) * speed;
	// モーション
	ObjMove_AddPatternA2(obj, 0, -4, 90, 0.1, 0, 0);
	ObjMove_AddPatternA2(obj, 40, NO_CHANGE, NO_CHANGE, 0.025, 0, 2);

	let t = 0;
	while( !Obj_IsDeleted(obj) )
	{
		if (t <= 45)
		{
			let tmp = (45-t)/45;
			ObjMove_SetX(obj, ObjMove_GetX(obj)+vx*tmp);
			ObjMove_SetY(obj, ObjMove_GetY(obj)+vy*tmp);
			if (t < 15)
			{
				let tmp = (t+1)/15;
				ObjRender_SetAngleZ(obj, tmp*1080);
				ObjRender_SetAlpha(obj, tmp*255 );
			} else if (t > 30) {
				let tmp = (t-30)/15;
				ObjRender_SetAlpha(obj, 255-tmp*127 );
			}
			if (t == 45)
			{
				Obj_SetRenderPriorityI( obj, GetItemRenderPriorityI() );
			}
		}
		else if (GetPlayerState() == STATE_NORMAL)
		{
			if( flgItemAutoCollect() || auto_collect || Obj_GetValueD(obj, "AUTO", false) )
			{
				Obj_SetValue(obj, "AUTO", true);	// オートコレクトフラグON（最大得点化）
				My_ItemMotionToPlayer(obj, 10);
				if (Obj_IsDeleted(obj)) { break; }
				// 途中で被弾した場合
				Obj_SetValue(obj, "AUTO", false);
				ObjMove_SetAngle(obj, 90);
				ObjMove_SetSpeed(obj, 0);
				ObjMove_SetAcceleration(obj, 0.025);
				ObjMove_SetMaxSpeed(obj, 2);
			}
			else if( GetObjectDistance(obj, GetPlayerObjectID()) <= GetPlayerItemCollectRange() )
			{
				My_ItemMotionToPlayer(obj, 10);
				if (Obj_IsDeleted(obj)) { break; }
				// 途中で被弾した場合
				ObjMove_SetAngle(obj, 90);
				ObjMove_SetSpeed(obj, 0);
				ObjMove_SetAcceleration(obj, 0.025);
				ObjMove_SetMaxSpeed(obj, 2);
			}
		}
		t++;
		yield;
	}
}

function RaiseItem(iX, iY, iType)
{
	alternative(iType)
	case(MY_ITEM_POINT_S)
	{
		let objItem = My_CreateItem(iType, iX, iY, 0);
		ObjRender_SetAngleZ(objItem, rand(0, 360));
		My_BulletItemMotion(objItem, 3, -90);
	}
}

//アイテムひな形
function My_CreateItem(iType, iX, iY, iScore)
{
	let objItem = CreateItemU1(iType, iX, iY, iScore);
	ObjItem_SetRenderScoreEnable(objItem, false);
	ObjItem_SetAutoCollectEnable(objItem, false);
	return(objItem);
}

//自動回収
task My_BulletItemMotion(objItem, speed, angle)
{
	ObjMove_SetAngle(objItem, angle);
	ObjMove_SetSpeed(objItem, speed);
	ObjMove_SetAcceleration(objItem, -speed/45);
	ObjMove_SetMaxSpeed(objItem, 0.25);
	loop(60) { yield; }
	ObjMove_SetSpeed(objItem, 0);
	while(!Obj_IsDeleted(objItem))
	{
		let r = ((GetPlayerX-ObjMove_GetX(objItem))^2 + (GetPlayerY-ObjMove_GetY(objItem))^2)^0.5;
		ObjMove_SetPosition(objItem, ObjMove_GetX(objItem)+(GetPlayerX-ObjMove_GetX(objItem))/r*16,
			ObjMove_GetY(objItem)+(GetPlayerY-ObjMove_GetY(objItem))/r*16);
		yield;
	}
}
function My_ItemMotionToPlayer(objItem, speed)
{
	ObjMove_SetSpeed(objItem, 0);
	while(!Obj_IsDeleted(objItem))
	{
		if (GetPlayerState() != STATE_NORMAL) { break; }
		let r = ((GetPlayerX-ObjMove_GetX(objItem))^2 + (GetPlayerY-ObjMove_GetY(objItem))^2)^0.5;
		ObjMove_SetPosition(objItem, ObjMove_GetX(objItem)+(GetPlayerX-ObjMove_GetX(objItem))/r*speed,
			ObjMove_GetY(objItem)+(GetPlayerY-ObjMove_GetY(objItem))/r*speed);
		yield;
	}
}

//----------------------------------------------------
//エフェクト
//----------------------------------------------------
//弾消し処理
function ShotToItem(x, y, objShot)
{
	//弾消しアイテム
	RaiseItem(x, y, MY_ITEM_POINT_S);
	//弾消しエフェクト
	ShotEraseEffect(x, y, ObjShot_GetImageID(objShot));
	/*
	alternative(Obj_GetType(objShot))
	case(OBJ_LOOSE_LASER)
	{
		let ivx = cos(ObjMove_GetAngle(objShot))*24;
		let ivy = sin(ObjMove_GetAngle(objShot))*24;
		let ir = ObjLaser_GetLength(objShot);
		while(ir > 0)
		{
			if (x >= 0 && x <= GetStgFrameWidth && y >= 0 && y <= GetStgFrameHeight)
			{
				//弾消しアイテム
				RaiseItem(x, y, MY_ITEM_POINT_S);
				//弾消しエフェクト→重いので切る
				ShotEraseEffect(x, y, ObjShot_GetImageID(objShot));
			}
			x -= ivx; y -= ivy;
			ir -= 24;
		}
	}
	case(OBJ_STRAIGHT_LASER)
	{
		let ivx = cos(ObjStLaser_GetAngle(objShot))*24;
		let ivy = sin(ObjStLaser_GetAngle(objShot))*24;
		let ir = ObjLaser_GetLength(objShot);
		while(ir > 0)
		{
			if (x >= 0 && x <= GetStgFrameWidth && y >= 0 && y <= GetStgFrameHeight)
			{
				//弾消しアイテム
				RaiseItem(x, y, MY_ITEM_POINT_S);
				//弾消しエフェクト→重いので切る
				ShotEraseEffect(x, y, ObjShot_GetImageID(objShot));
			}
			x += ivx; y += ivy;
			ir -= 24;
		}
	}
	others
	{
		//弾消しアイテム
		RaiseItem(x, y, MY_ITEM_POINT_S);
		//弾消しエフェクト
		ShotEraseEffect(x, y, ObjShot_GetImageID(objShot));
	}
	*/
}

//----------------------------------------------------
//  弾消しエフェクト
//----------------------------------------------------
task ShotEraseEffect(itemX, itemY, graphic)
{
	if (IsDrawEffect() < 3) { return; }

	// カラー
	let effect_color = EFFECT_COLOR[ graphic%8 ];
	// エフェクトサイズは被弾半径に比例
	let eff_size = 16 + GetShotDataInfoA1(graphic, TARGET_ENEMY, INFO_COLLISION) * 2;
	
	if (eff_size > 32) {
		loop(3)
		{
			_ShotEraseEffect(itemX+randEffect(-16,16), itemY+randEffect(-16,16), effect_color, eff_size/2);
			wait(6);
		}
	} else {
		_ShotEraseEffect(itemX, itemY, effect_color, eff_size);
	}
}

task _ShotEraseEffect(itemX, itemY, effect_color, eff_size)
{
	if (IsDrawEffect() < 3) { return; }
	
	//初期設定
	let obj = ObjPrim_Create(OBJ_SPRITE_2D);
	Obj_SetRenderPriorityI(obj, GetShotRenderPriorityI() + 1);
	ObjPrim_SetTexture(obj, imgSystemShotBreak);
	ObjRender_SetBlendType(obj, BLEND_ADD_RGB);
	ObjSprite2D_SetDestRect(obj, -eff_size, -eff_size, eff_size, eff_size);
	ObjRender_SetPosition(obj, itemX, itemY, 0);
	ObjRender_SetAngleZ(obj, randEffect(0,360));
	ObjRender_SetColor(obj, effect_color[0], effect_color[1], effect_color[2]);
	ascent(i in 0 .. 8)
	{
		ObjSprite2D_SetSourceRect(obj, 0+32*i, 0, 32+32*i, 32);
		loop(3) { yield; }
	}
	Obj_Delete(obj);
}

//----------------------------------------------------
//  チャプターアイテム用
//----------------------------------------------------
function AddChapterItem(count)
{
	SetAreaCommonData(CAREA_STAGE, "ChapterWishItem", GetAreaCommonData(CAREA_STAGE, "ChapterWishItem", 0)+count);
}

//----------------------------------------------------
//  星アイテムの最大得点
//----------------------------------------------------
sub SetStarMaxScore
{
	alternative(Difficult)
	case(D_EASY) { StarMaxScore = 8; }
	case(D_NORM) { StarMaxScore = 10; }
	case(D_HARD) { StarMaxScore = 15; }
	case(D_LUNA) { StarMaxScore = 20; }
	case(D_EXTRA) { StarMaxScore = 30; }
	others { StarMaxScore = 10; }
}
